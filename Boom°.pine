//@version=6

// ----------------------------------------------------------------------------
indicator('Boom°', shorttitle = 'Boom°', overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 5000)
import Gregorius_XV/GXVAssetCorrelationUtils/1 as AC
import Gregorius_XV/GXVUtils/12 as QTU

// ============================================================================
// Types - Data Only (no drawing objects stored)
// ============================================================================

type Candle
    float o
    float c
    float h
    float l
    int o_time
    int c_time    // close time - set when next candle opens
    int o_idx
    int c_idx
    int h_idx
    int l_idx
    string dow
    // Visual positions (calculated during draw)
    int candle_left
    int candle_right
    int wick_x
    // HTF panel SMT / PSP flags (recomputed on the last bar)
    bool smt_bull = false
    bool smt_bear = false
    bool psp = false       // body closes opposite in colour to the pair 1 candle

// One pair candle aligned to an HTF panel candle (same open time) — HTF Profiler HtfPairCandle
type HtfPairCandle
    float o
    float h
    float l
    float c
    int   ot

type Trace
    int start_idx
    float start_price


type Sweep
    float price
    int ltf_index
    int htf_candle_idx
    int swept_candle_idx
    int ltf_end_idx
    bool is_high  // true = high sweep, false = low sweep

// Completed IC-CISD (confirmed only)
type ICCisd
    float level
    int start_idx
    int end_idx
    float extreme_price
    int extreme_idx
    bool taken               // wick beyond swing high/low — line and dot go grey
    bool is_bull = false     // direction of the owning setup
    int taken_bar = na       // bar the dot was taken (removed IC_GREY_BARS later)
    bool visible = false     // true once the owning setup's main CISD has triggered
    bool removed = false     // owning setup's CISD was rebuilt — drop this IC
    int start_time = na      // time coordinates: persistent ICs can be thousands of bars old,
    int end_time = na        // beyond the bar_index drawing limit, so they are drawn by time
    int extreme_time = na

type Setup
    bool is_bullish          // true = bullish setup (low sweep), false = bearish (high sweep)
    bool is_confirmed        // true when sweep is confirmed (close in range)
    bool is_post_c2          // true after C2 closes, waiting for CISD
    // Sweep data
    float sweep_price        // swept high/low price (C1 high/low)
    int sweep_ltf_idx        // LTF bar index of sweep
    int sweep_bar_idx        // bar index where sweep happened (for CISD traceback)
    int swept_candle_idx     // HTF candle that was swept (o_idx)
    int htf_candle_idx       // HTF candle that did the sweeping
    int ltf_end_idx          // LTF end point for sweep line
    int htf_count            // counts HTF candles since sweep (max 2)
    // C2 data
    int c2_x                 // bar index for C2 label (at swing point)
    float c2_y               // price for C2 label (swing high/low)
    float c2_extreme         // C2's high (bearish) or low (bullish) for price limit
    // CISD data
    float cisd_level         // CISD price level (open of opposing candles)
    int cisd_start_idx       // bar index where CISD level starts
    int cisd_end_idx         // body-break bar; line drawn to this + 1
    float tracked_extreme    // tracks high/low price for CISD (lowest low or highest high)
    int extreme_bar_idx      // bar index where the extreme occurred (for CISD traceback)
    bool has_cisd            // true when CISD level is set
    bool cisd_triggered      // true when CISD may show (body broke; in C2 also needs sweep back in)
    // IC-CISD (rebuild): opposite-candle open = level; body break confirms; one pending
    array<ICCisd> ic_list
    bool ic_active           // detection on after main CISD (through C4)
    bool ic_pending          // waiting for body break on current structure
    float ic_level           // open of opposite candle
    int ic_start_idx         // bar of that opposite candle
    float ic_extreme         // running high (bear) / low (bull) for dot — update every bar until confirm
    int ic_extreme_idx
    bool ic_seen_same_side   // true only after a real same-side candle (not doji) while pending
    float ic_last_extreme    // last confirmed IC swing extreme — next arm only if exceeds this (higher high / lower low)
    // Projection data
    float proj_anchor_1      // Point "1" - swing high (bearish) or swing low (bullish)
    float proj_anchor_0      // Point "0" - CISD candle's low (bearish) or high (bullish)
    int proj_start_idx       // Bar index where projection starts (swing point)
    int proj_end_idx         // Bar index where projection ends (CISD trigger bar)
    // C4 window
    int liq_end_time         // C4's end time (gates C4 invalidation)
    // Invalidation
    bool is_invalid          // True if C3 exceeded C2 extreme after CISD triggered
    // Entry Zone C3 data
    float c2_mid             // C2 wick midpoint (high+low)/2
    float c3_open            // C3 open price
    bool ez_c3_set           // true when C3 entry zone bounds are calculated
    float ez_c3_top          // C3 zone top price
    float ez_c3_bot          // C3 zone bottom price
    int ez_c3_left_time      // C3 zone left (C3 open time)
    int ez_c3_right_time     // C3 zone right (C3 close / C4 open); na while C3 is live
    // Entry Zone C4 data
    float c3_mid             // C3 wick midpoint (high+low)/2
    float c3_extreme         // C3 high (bearish) or low (bullish) for C4 invalidation
    float c4_open            // C4 open price
    bool ez_c4_set           // true when C4 entry zone bounds are calculated
    bool ez_c4_invalid       // true when C4 invalidated (beyond C3 extreme)
    int ez_c4_invalid_time   // LTF time where C4 was invalidated (EQ stops here)
    float ez_c4_top          // C4 zone top price
    float ez_c4_bot          // C4 zone bottom price
    int ez_c4_left_time      // C4 zone left (C4 open time)
    int ez_c4_right_time     // C4 zone right (C4 close)

type CandleSettings
    string htf
    int max_display
    bool vt_show
    color vt_color
    string vt_style
    int vt_size
    bool hl_show
    color hl_color
    string hl_style
    int hl_width

type Settings
    color bull_body
    color bull_border
    color bull_wick
    color bear_body
    color bear_border
    color bear_wick
    int offset
    int width
    bool daily_name
    bool trace_show
    color trace_o_color
    string trace_o_style
    int trace_o_size
    bool label_show
    color label_color
    string label_size
    string label_position
    string dow_position
    bool htf_label_show
    color htf_label_color
    string htf_label_size
    bool htf_timer_show
    color htf_timer_color
    string htf_timer_size
    color dow_color
    string dow_size
    bool sweep_show
    color sweep_color
    string sweep_style
    int sweep_size
    int sweep_history
    bool sweep_visible_only
    bool sweep_live
    color c2_color
    string c2_size
    bool show_c2_lbl
    bool show_c3_lbl
    bool show_c4_lbl
    // CISD settings
    bool cisd_show
    color cisd_bull_color
    color cisd_bear_color
    int cisd_width
    string cisd_style
    bool ic_cisd_show        // IC-CISD toggle (same colors/width/style as CISD)
    string ic_dot_size       // IC-CISD swing dot size
    // Early/Live CISD preview settings
    bool early_cisd_show
    color early_cisd_color
    string early_cisd_style
    // Entry Zone settings
    bool entry_zone_show
    color entry_zone_bull_color
    color entry_zone_bear_color
    // General settings
    string bias
    bool hide_candles
    bool hide_setups
    bool model_on_panel      // Fractal model drawn on a panel this bar (set on the last bar)
    // Projection settings
    bool proj_show
    string proj_label_size
    string proj_type
    color proj_color


type CandleSet
    array<Candle> candles
    array<Sweep> sweeps
    array<Setup> setups       // completed setups for history
    CandleSettings settings
    Trace trace
    Setup live_bearish        // tracks when high is wicked (potential bearish setup)
    Setup live_bullish        // tracks when low is wicked (potential bullish setup)
    bool has_live_bearish     // flag for bearish tracking active
    bool has_live_bullish     // flag for bullish tracking active

// Drawing Bin - centralized storage for all drawing objects
type DrawingBin
    array<line> lines
    array<box> boxes
    array<label> labels

// ============================================================================

var Settings settings = Settings.new()
var CandleSettings Settingshtf = CandleSettings.new()
var array<Candle> candles_1 = array.new<Candle>(0)
var array<Sweep> sweeps_1 = array.new<Sweep>()
var array<Setup> setups_1 = array.new<Setup>()

var CandleSet htf = CandleSet.new()
htf.settings := Settingshtf
htf.candles := candles_1
htf.sweeps := sweeps_1
htf.setups := setups_1
if na(htf.trace)
    htf.trace := Trace.new()

// ── HTF panel preview candles (Profiler Classic ladder) — preview only, never feed C2/CISD/setups ──
var array<Candle> pnl_a1 = array.new<Candle>()
var array<Candle> pnl_a2 = array.new<Candle>()
var array<Candle> pnl_a3 = array.new<Candle>()
// Pair candles per panel (0 = Fractal model panel, 1..3 = HTF1..HTF3) × (pair 1, pair 2)
var array<HtfPairCandle> pp0_1 = array.new<HtfPairCandle>()
var array<HtfPairCandle> pp0_2 = array.new<HtfPairCandle>()
var array<HtfPairCandle> pp1_1 = array.new<HtfPairCandle>()
var array<HtfPairCandle> pp1_2 = array.new<HtfPairCandle>()
var array<HtfPairCandle> pp2_1 = array.new<HtfPairCandle>()
var array<HtfPairCandle> pp2_2 = array.new<HtfPairCandle>()
var array<HtfPairCandle> pp3_1 = array.new<HtfPairCandle>()
var array<HtfPairCandle> pp3_2 = array.new<HtfPairCandle>()

// Initialize drawing bin
var DrawingBin bin = DrawingBin.new(
    lines = array.new<line>(),
    boxes = array.new<box>(),
    labels = array.new<label>()
)
color color_transparent = #ffffff00

// Projection deviation levels array
var array<float> proj_deviations = array.new_float()

// ============================================================================
// Settings Inputs
// ============================================================================

string group_general            = "General Settings  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
string group_htf               = "HTF Candles  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
string group_sweep              = "Model Settings  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
string group_label              = "Label Settings  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

// General Settings
alerts_enabled_input            = input.bool(true, 'Alerts?', group=group_general, tooltip='To turn on the alerts, follow these steps:\n\n1) Make sure that the Alerts? toggle is ON.\n2) Right-click on the indicator on your chart.\n3) Click Add Alert on this indicator.\n4) Choose the Alert Name and confirm by clicking Create.\n\nNOTE: if you change any Settings, delete and re-create the alerts!')
settings.sweep_history          := input.int(4, 'History        ', minval=0, group=group_general, inline='history')
settings.sweep_visible_only     := input.bool(true, '', tooltip='Number of historical setups to show:\n\n☑ ON: Setups on visible HTF candles always shown. This count adds older setups that scrolled away.\n\n☐ OFF: Only show this many setups total.', inline='history', group=group_general)
seq_mode_input                  = input.string('Boom', 'Sequence', options=['Boom', 'Classic'], group=group_general, tooltip='Boom: fixed model. 1m chart → 1H, other charts below 4H → 4H.\n• C2 valid = C2 + LTF CISD (1H → 5m, 4H → 15m)\n• C3 SETUP lanes: C1 sweep → entry CISD (1H: 15m → 3m / 1m, 4H: 1H → 5m, 30m → 3m)\n• POI: 15m/1H/4H/D\n• Alerts: C2 close + C3 sweep / entry\n\nClassic: model = Fractal pairing.\n• C2 valid = C2 + CISD on the Fractal LTF\n• No C3 SETUP lanes\n• POI by pairing (15m–1H model 15m/1H/4H, 4H 1H/4H/D, D/W/M own TF)\n• Alerts: C2 close only\n\nAbove a 1H chart: no C3 lanes; C2 QUALITY = CISD (+ SMT).')
bool seq_classic                = seq_mode_input == 'Classic'
fractal_mode_input              = input.string('Automatic','Fractal', options=['Automatic', 'Custom', '1m-15m', '3m-30m', '5m-1H', '15m-4H', '1H-1D', '4H-1W', '1D-1M'], group=group_general, active=seq_classic, tooltip='Classic only. LTF-HTF pairing of the model.\nAutomatic: chart TF → next HTF.\nCustom: the two timeframes below.')
custom_ltf_input                = input.timeframe('5', 'Custom Fractal  ', inline='custom_tf', group=group_general, active=seq_classic and fractal_mode_input == 'Custom')
custom_htf_input                = input.timeframe('60','-', inline='custom_tf', group=group_general, active=seq_classic and fractal_mode_input == 'Custom')
settings.bias                   := input.string('Neutral', 'Bias', options=['Neutral', 'Bullish', 'Bearish'], group=group_general, tooltip='Filter setups by direction:\n\nNeutral: Show both bullish and bearish setups.\nBullish: Only show bullish setups (low sweeps).\nBearish: Only show bearish setups (high sweeps).')

// Alerts (Sequence engine)
string group_alerts             = "Alerts  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
alert_c2_input                   = input.bool(true, 'C2 Closed + LTF CISD', group=group_alerts, active=alerts_enabled_input, tooltip='Valid C2 close (C2 + its LTF CISD), also when its CISD confirms in C3. Classic + Boom.')
alert_c1_input                   = input.bool(true, 'C3: C1 Sweep', group=group_alerts, active=alerts_enabled_input and not seq_classic, tooltip='Boom only. C1 sweep inside C3: 1H model 15m, 4H model 1H / 30m.')
alert_entry_input                = input.bool(true, 'C3: Entry CISD', group=group_alerts, active=alerts_enabled_input and not seq_classic, tooltip='Boom only. Entry CISD after the C1 sweep: 1H model 3m / 1m, 4H model 5m / 3m.')

getHigherTF() =>
    switch timeframe.period
        "1" => "15"
        "3" => "30"
        "5" => "60"
        "15" => "240"
        "30" => "240"
        "60" => "1D"
        "120" => "1D"
        "240" => "1W"
        "1D" => "1M"
        "1W" => "3M"
        "1M" => "12M"
        => ""

getFractalHTF() =>
    switch fractal_mode_input
        "Automatic" => getHigherTF()
        "Custom" => custom_htf_input
        "1m-15m" => "15"
        "3m-30m" => "30"
        "5m-1H" => "60"
        "15m-4H" => "240"
        "1H-1D" => "1D"
        "4H-1W" => "1W"
        "1D-1M" => "1M"
        => getHigherTF()

// Fractal LTF (Classic: the C2 CISD timeframe). Automatic → the chart timeframe.
getFractalLTF() =>
    switch fractal_mode_input
        "Custom" => timeframe.in_seconds(custom_ltf_input) < 60 ? "1" : custom_ltf_input
        "1m-15m" => "1"
        "3m-30m" => "3"
        "5m-1H" => "5"
        "15m-4H" => "15"
        "1H-1D" => "60"
        "4H-1W" => "240"
        "1D-1M" => "1D"
        => timeframe.period

// HTF Candles settings — model: Classic = Fractal HTF, Boom = 1H on a 1m chart, else 4H
string model_tf = seq_classic ? getFractalHTF() : timeframe.in_seconds() == 60 ? '60' : '240'
htf.settings.htf := model_tf
hide_candles_input             = input.bool(false, 'Hide Projection?', group = group_htf, inline='offset', tooltip='Hides all three HTF panels.')
settings.hide_candles          := hide_candles_input
hide_setups_input              = input.bool(false, 'Hide Setups?', group = group_htf, inline='offset', tooltip='Hide all setups (sweeps, CISD, projections, entry zones). Only show HTF candles, vertical lines, and H/L lines.')
settings.hide_setups           := hide_setups_input
candle_size_input              = input.string('Small', 'Size            ', options=['Small', 'Normal', 'Big'],group = group_htf,inline='HTF Candles',active = not hide_candles_input)
settings.width                 := candle_size_input == 'Small' ? 2 : candle_size_input == 'Normal' ? 4 : 6
pnl_auto_input                 = input.bool(true, 'Auto HTF', inline = 'pnl_auto_htf', group = group_htf, active = not hide_candles_input, tooltip = 'Auto HTF: panel timeframes follow the HTF Profiler Classic ladder:\n1m → 5m/15m/1H · 3m → 30m/1H/4H · 5m → 15m/1H/4H · 15m/30m → 1H/4H/D · 1H → 4H/D/W · 4H → D/W/M\nOff: use the timeframes typed on HTF1/HTF2/HTF3.')
pnl1_show_input                = input.bool(true, 'HTF1', inline = 'pnl1', group = group_htf, active = not hide_candles_input)
pnl1_tf_input                  = input.timeframe('60', '', inline = 'pnl1', group = group_htf, active = not pnl_auto_input and not hide_candles_input)
pnl1_count_input               = input.int(6, '', minval = 1, maxval = 60, inline = 'pnl1', group = group_htf, active = not hide_candles_input)
pnl2_show_input                = input.bool(true, 'HTF2', inline = 'pnl2', group = group_htf, active = not hide_candles_input)
pnl2_tf_input                  = input.timeframe('240', '', inline = 'pnl2', group = group_htf, active = not pnl_auto_input and not hide_candles_input)
pnl2_count_input               = input.int(6, '', minval = 1, maxval = 60, inline = 'pnl2', group = group_htf, active = not hide_candles_input)
pnl3_show_input                = input.bool(true, 'HTF3', inline = 'pnl3', group = group_htf, active = not hide_candles_input)
pnl3_tf_input                  = input.timeframe('1D', '', inline = 'pnl3', group = group_htf, active = not pnl_auto_input and not hide_candles_input)
pnl3_count_input               = input.int(6, '', minval = 1, maxval = 60, inline = 'pnl3', group = group_htf, active = not hide_candles_input, tooltip = 'The candle count of each panel applies whether Auto HTF is on or off. A panel shows only when its timeframe is higher than the chart. Candle times, HTF label and remaining time follow the Label Settings.\nThe panel whose timeframe equals the Fractal HTF hosts the model (sweep lines, HTF EQ, panel C-labels) and shows at least 4 candles.')
settings.offset                := input.int(10, 'Offset           ', minval = 1, group = group_htf,inline='Offset',active = not hide_candles_input)
pnl_gap_input                  = input.int(6, 'Gap', minval = 1, maxval = 50, group = group_htf, inline='Offset', active = not hide_candles_input, tooltip = 'Bars between the HTF panels.')
settings.bull_body             := input.color(#b2bfbe, 'Body            ', inline = 'body', group = group_htf,active = not hide_candles_input)
settings.bear_body             := input.color(#434651, '', inline = 'body', group = group_htf,active = not hide_candles_input)
settings.bull_border           := input.color(#0f0f0f, 'Border           ', inline = 'border', group = group_htf,active = not hide_candles_input)
settings.bear_border           := input.color(#0f0f0f, '', inline = 'border', group = group_htf,active = not hide_candles_input)
settings.bull_wick             := input.color(#0f0f0f, 'Wick             ', inline = 'wick', group = group_htf,active = not hide_candles_input)
settings.bear_wick             := input.color(#0f0f0f, '', inline = 'wick', group = group_htf,active = not hide_candles_input)
trace_show_input               = input.bool(false, 'HTF Open    ', inline = 'trace', group = group_htf,active = not hide_candles_input)
settings.trace_show            := trace_show_input
settings.trace_o_color         := input.color(color.new(#0f0f0f, 50), '', inline = 'trace', group = group_htf, active = trace_show_input and not hide_candles_input)
settings.trace_o_style         := input.string('Solid', '', options = ['Solid', 'Dashed', 'Dotted'], inline = 'trace', group = group_htf, active = trace_show_input and not hide_candles_input)
settings.trace_o_size          := input.int(1, 'Width', options = [1, 2, 3, 4], inline = 'trace', group = group_htf, active = trace_show_input and not hide_candles_input)
vt_show_input                  = input.bool(true, 'Vertical Lines ', inline = 'vt', group = group_htf)
htf.settings.vt_show           := vt_show_input
htf.settings.vt_color          := input.color(color.new(#0f0f0f, 90), '', inline = 'vt', group = group_htf, active = vt_show_input)
htf.settings.vt_style          := input.string('Solid', '', options = ['Solid', 'Dashed', 'Dotted'], inline = 'vt', group = group_htf, active = vt_show_input)
htf.settings.vt_size           := input.int(1, 'Width', options = [1, 2, 3, 4], inline = 'vt', group = group_htf, active = vt_show_input)
hl_show_input                  = input.bool(true, 'L/H Lines     ', inline='lh', group = group_htf)
htf.settings.hl_show           := hl_show_input
htf.settings.hl_color          := input.color(color.new(#0f0f0f, 70), '', inline='lh', group = group_htf, active = hl_show_input)
htf.settings.hl_style          := input.string('Dotted', '', options=['Solid','Dashed','Dotted'], inline='lh', group = group_htf, active = hl_show_input)
htf.settings.hl_width          := input.int(1, 'Width', options=[1,2,3,4], inline='lh', group = group_htf, active = hl_show_input)
// Previous EQ
prev_eq_show                   = input.bool(false, 'Previous EQ   ', inline='prev_eq', group = group_htf)
prev_eq_color                  = input.color(#0f0f0f, '', inline='prev_eq', group = group_htf, active = prev_eq_show)
prev_eq_style                  = input.string('Dotted', '', options=['Solid','Dashed','Dotted'], inline='prev_eq', group = group_htf, active = prev_eq_show)
prev_eq_width                  = input.int(1, 'Width', options=[1,2,3,4], inline='prev_eq', group = group_htf, active = prev_eq_show)
drawings_type                  = input.string('Both', 'Drawings Type', options=['Both', 'On Chart', 'HTF candle'], group = group_htf, tooltip='On Chart: EQ lines on price chart (setup package).\nHTF candle: EQ on HTF projection (later).\nBoth: chart + projection.', active = prev_eq_show)

// ============================================================================
// HTF1 Label Settings
// ============================================================================

htf_label_show_input            = input.bool(true, 'HTF Label     ', group=group_label, inline = 'HTFlabel')
settings.htf_label_show         := htf_label_show_input
settings.htf_label_color        := input.color(#0f0f0f, '', group=group_label, inline = 'HTFlabel', active = htf_label_show_input)
settings.htf_label_size         := input.string(size.large, '', [size.tiny, size.small, size.normal, size.large, size.huge], group=group_label, inline = 'HTFlabel', active = htf_label_show_input)
settings.label_position         := input.string("Top", 'Pos', options=['Both', 'Top', 'Bottom'], group=group_label, inline = 'HTFlabel', active = htf_label_show_input)

htf_timer_show_input            = input.bool(true, 'Remaining Time', inline = 'timer', group=group_label,active = htf_label_show_input)
settings.htf_timer_show         := htf_timer_show_input
settings.htf_timer_color        := input.color(#0f0f0f, '', inline = 'timer', group=group_label, active = htf_timer_show_input and htf_label_show_input)
settings.htf_timer_size         := input.string(size.normal, '', [size.tiny, size.small, size.normal, size.large, size.huge], group=group_label, inline = 'timer', active = htf_timer_show_input and htf_label_show_input)

daily_name_input                = input.bool(true, 'Interval Value', group=group_label, inline = 'dow')
settings.daily_name             := daily_name_input
settings.dow_color              := input.color(#0f0f0f, '', group=group_label, inline = 'dow', active = daily_name_input)
settings.dow_size               := input.string(size.small, '', [size.tiny, size.small, size.normal, size.large, size.huge], group=group_label, inline = 'dow', active = daily_name_input)
settings.dow_position           := input.string('Bottom', 'Pos', options=['Both', 'Top', 'Bottom'], group=group_label, inline = 'dow', active = daily_name_input)

// ============================================================================
// HTF panel features — FVG / SMT / PSP (HTF Profiler)
// ============================================================================
string group_htf_feat           = "HTF Features  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
htf_fvg_show                    = input.bool(true, 'Enable FVG?', inline = 'htffvg', group = group_htf_feat, tooltip = 'Fair value gaps between three consecutive candles of each HTF panel (HTF Profiler logic).')
htf_bull_fvg_color              = input.color(#0c3299, '', inline = 'htffvg', group = group_htf_feat, active = htf_fvg_show)
htf_bear_fvg_color              = input.color(#b22833, '', inline = 'htffvg', group = group_htf_feat, active = htf_fvg_show)
htf_smt_show                    = input.bool(true, 'Enable SMT?', inline = 'htf_smt', group = group_htf_feat, tooltip = 'SMT between consecutive HTF panel candles vs the SMT pairs: one symbol makes a higher high / lower low and the other does not. Hidden once a newer panel candle trades through the SMT extreme.')
htf_smt_bull_color              = input.color(#0f0f0f, '', inline = 'htf_smt', group = group_htf_feat, active = htf_smt_show)
htf_smt_bear_color              = input.color(#0f0f0f, '', inline = 'htf_smt', group = group_htf_feat, active = htf_smt_show)
htf_psp_show                    = input.bool(true, 'Enable PSP?', group = group_htf_feat, tooltip = 'PSP: the C2 body closes opposite in colour to the pair 1 candle (MNQ → MES). A doji on either side is no PSP. Label: C2+PSP (panels; chart = model HTF).')

// ============================================================================
// Model Settings
// ============================================================================

sweep_show_input                = input.bool(true, 'Show Sweeps   ', group=group_sweep, inline='sweep')
settings.sweep_show             := sweep_show_input
settings.sweep_live             := input.bool(true, 'Show live setup', inline='sweep_live', group=group_sweep, active = sweep_show_input)
settings.sweep_color            := input.color(#0f0f0f, 'Color         ', inline='sweep_color', group=group_sweep, active = sweep_show_input)
settings.sweep_style            := input.string('Solid', '', options=['Solid', 'Dashed', 'Dotted'], inline='sweep_color', group=group_sweep, active = sweep_show_input)
settings.sweep_size             := input.int(1, '', options=[1, 2, 3, 4], inline='sweep_color', group=group_sweep, active = sweep_show_input)
settings.c2_color               := input.color(#0f0f0f, 'Label      ', inline='c2', group=group_sweep)
settings.c2_size                := input.string(size.small, '', options=[size.tiny, size.small, size.normal, size.large], inline='c2', group=group_sweep)
settings.show_c2_lbl            := input.bool(true, 'C2', inline='c2', group=group_sweep)
settings.show_c3_lbl            := input.bool(true, 'C3', inline='c2', group=group_sweep)
settings.show_c4_lbl            := input.bool(true, 'C4', inline='c2', group=group_sweep)
c_lbl_loc_input                 = input.string('Both', 'C-Labels On', options=['Chart', 'Panel', 'Both'], inline='c_lbl_loc', group=group_sweep, tooltip='Chart: C2 / C3 / C4 labels on price (as before).\nPanel: C1 / C2 / C3 / C4 on the HTF panel that hosts the Fractal model (latest formation only, Profiler style).\nBoth: chart + panel.\nThe C2 / C3 / C4 toggles apply to both places (C1 follows C2).')
c_lbl_latest_input              = input.bool(true, 'Chart: Latest Formation Only', inline='c_lbl_latest', group=group_sweep, active = c_lbl_loc_input != 'Panel', tooltip='On: the chart shows the C2 / C3 / C4 labels of the latest formation only (the same one labelled on the model panel), so older setups no longer stack extra C2 / C3 / C4 labels or C3 / C4 entry-zone boxes.\nOff: every setup kept by History shows its labels and entry-zone boxes (previous behaviour).\nThe HTF1 / HTF3 panel labels never draw on chart candles.')
pnl_other_clbl_input            = input.bool(true, 'C1–C4 on Other Panels', inline='c_lbl_other', group=group_sweep, active = c_lbl_loc_input != 'Chart', tooltip='On / off for the C1–C4 labels on the HTF panels that do not host the Fractal model. The model panel follows C-Labels On.')
pnl_clbl_conf                   = input.string('Live', 'Panel C-Labels', options=['Live', 'Confirmed'], inline='c_lbl_mode', group=group_sweep, active = c_lbl_loc_input != 'Chart', tooltip='HTF panels. Live: C2 on the sweep.\nConfirmed: model panel = C2 confirmed by the table (●); if C3–C5 takes its extreme → live sweep.') == 'Confirmed'
pnl_dot_color                   = input.color(#388e3c, 'C2 Confirmed ●', inline='c2dot', group=group_sweep, active = c_lbl_loc_input != 'Chart')
pnl_dot_size                    = input.string('Medium', '', options=['Small', 'Medium', 'Large'], inline='c2dot', group=group_sweep, active = c_lbl_loc_input != 'Chart', tooltip='Colour and size of the dot after a C2 the table confirmed (model panel).')
bool c_lbl_chart                = c_lbl_loc_input != 'Panel'
bool c_lbl_panel                = c_lbl_loc_input != 'Chart'
cisd_show_input                 = input.bool(true, 'Show CISD     ', inline='cisd', group=group_sweep)
settings.cisd_show              := cisd_show_input
ic_cisd_show_input              = input.bool(true, 'IC-CISD', inline='cisd', group=group_sweep, tooltip='Same-side IC-CISD after main CISD confirm through C4 (stops on setup or C4 invalid). Uses CISD colors/width/style. Extreme marked with a dot.')
settings.ic_cisd_show           := ic_cisd_show_input
settings.ic_dot_size            := input.string(size.small, 'Dot', options=[size.tiny, size.small, size.normal, size.large], inline='cisd', group=group_sweep, active = ic_cisd_show_input)
ic_line_show_input              = input.bool(true, 'Line', inline='cisd', group=group_sweep, active = ic_cisd_show_input, tooltip='IC-CISD level line (from the opposite candle to the break). Off = dots only, as in FM Base IC-CISD.')
settings.cisd_bull_color        := input.color(#0c3299, 'Bull          ', inline='cisd_color', group=group_sweep, active = cisd_show_input or ic_cisd_show_input)
settings.cisd_bear_color        := input.color(#b22833, 'Bear', inline='cisd_color', group=group_sweep, active = cisd_show_input or ic_cisd_show_input)
settings.cisd_width             := input.int(2, 'Width', options=[1, 2, 3, 4], inline='cisd_style', group=group_sweep, active = cisd_show_input or ic_cisd_show_input)
settings.cisd_style             := input.string('Solid', 'Style', options=['Solid', 'Dashed', 'Dotted'], inline='cisd_style', group=group_sweep, active = cisd_show_input or ic_cisd_show_input)
entry_zone_show_input           = input.bool(true, 'Entry Zone   ', inline='entry_zone', group=group_sweep)
settings.entry_zone_show        := entry_zone_show_input
settings.entry_zone_bull_color  := input.color(color.new(#0c3299, 94), 'Bullish', inline='entry_zone', group=group_sweep, active = entry_zone_show_input)
settings.entry_zone_bear_color  := input.color(color.new(#b22833, 94), 'Bearish', inline='entry_zone', group=group_sweep, active = entry_zone_show_input)
early_cisd_show_input            = input.bool(true, 'Early CISD   ', inline='early_cisd', group=group_sweep, tooltip='Preview the CISD level as soon as it is known — before the sweep confirms back in / body breaks through it. Shown dotted; promoted to the solid CISD line the instant it triggers. Only applies to the live (developing) setup.')
settings.early_cisd_show         := early_cisd_show_input
settings.early_cisd_color        := input.color(#b22833, '', inline='early_cisd', group=group_sweep, active = early_cisd_show_input)
settings.early_cisd_style        := input.string('Dashed', '', options=['Solid', 'Dashed', 'Dotted'], inline='early_cisd', group=group_sweep, active = early_cisd_show_input)

// ============================================================================
// Standard Deviation Projections
// ============================================================================
string group_projection         = "Standard Deviation Projections  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
proj_show_input                 = input.bool(false, 'Enable Projections?', group=group_projection)
settings.proj_show              := proj_show_input
settings.proj_label_size        := input.string('Small', 'Label Size    ', options=['Tiny', 'Small', 'Normal', 'Large', 'Huge'], inline='proj_lbl', group=group_projection, active = proj_show_input, tooltip='Projections are drawn as labels only (no lines).')
settings.proj_type              := input.string('Wick', 'Type          ', options=['Body', 'Wick'], inline='proj_type', group=group_projection, active = proj_show_input)
proj_deviations_input           = input.string("0,1,-1,-2,-2.5", '', inline='proj_type', group=group_projection, tooltip='Comma-separated list of deviation levels to draw', active = proj_show_input)
settings.proj_color             := input.color(color.new(#0f0f0f, 80), 'Label Color   ', inline='proj_style', group=group_projection, active = proj_show_input)

// Parse deviation levels (comma-separated)
if proj_deviations.size() == 0
    string[] parts = str.split(proj_deviations_input, ",")
    for i = 0 to parts.size() - 1
        float val = str.tonumber(str.trim(parts.get(i)))
        if not na(val)
            proj_deviations.push(val)

// ============================================================================
// Liquidity Suite — PD/PW/PM + TDO (visual layer)
// ============================================================================
// The full Liquidity Suite integrated as a visual layer, not a filter layer.
// Detection runs inside the Calculated Bars window; PD/PW/PM levels stay after a sweep.
// ============================================================================

// --- Liquidity Suite Groups ---
string LQ_GRP_TDO  = "Liq Suite: Day Open  ━━━━━━━━━━━━━━━━━━━━━━━━"
string LQ_GRP_PDW  = "Liq Suite: PDH/PDL - PWH/PWL - PMH/PML  ━━━━━━━━━"

string lq_session_tz = "America/New_York"   // fixed session timezone

// --- True Day Open ---
lq_use_true_open  = input.bool(true, "Day Open", group=LQ_GRP_TDO, inline="lq_tdo_top")
lq_day_open_mode  = input.string("Midnight", "", options=["Midnight", "6 PM"], group=LQ_GRP_TDO, inline="lq_tdo_top", tooltip="Midnight = True Day Open (00:00, label TDO).\n6 PM = futures/forex session open (18:00, label D OPEN).\nUses the Liq Suite timezone.")
lq_tdo_color      = input.color(#0f0f0f, "", group=LQ_GRP_TDO, inline="lq_s_tdo")
lq_tdo_style      = input.string("Solid", "", group=LQ_GRP_TDO, inline="lq_s_tdo", options=["Solid", "Dashed", "Dotted"])
lq_tdo_width      = input.int(1, "", group=LQ_GRP_TDO, inline="lq_s_tdo", minval=1, maxval=5)
lq_tdo_show_label = input.bool(true, "Show Label", group=LQ_GRP_TDO)
lq_hide_above_tf = input.timeframe("60", "Hide Above TF", group=LQ_GRP_TDO, tooltip="Day Open is hidden on charts above this timeframe.")

// --- PDH/PDL - PWH/PWL - PMH/PML ---
lq_show_pd = input.bool(true, "Show PDH/PDL", inline="lq_pd", group=LQ_GRP_PDW)
lq_pd_color = input.color(#0f0f0f, "Color", inline="lq_pdc", group=LQ_GRP_PDW)
lq_pd_style = input.string("Solid", "Style", inline="lq_pdc", group=LQ_GRP_PDW, options=["Solid", "Dashed", "Dotted"])
lq_pd_width = input.int(1, "Width", inline="lq_pdc", group=LQ_GRP_PDW, minval=1, maxval=5)
lq_pd_eq_show  = input.bool(true, "PD EQ", inline="lq_pde", group=LQ_GRP_PDW, active=lq_show_pd)
lq_pd_eq_color = input.color(#0f0f0f, "", inline="lq_pde", group=LQ_GRP_PDW, active=lq_show_pd and lq_pd_eq_show)
lq_pd_eq_style = input.string("Dotted", "", inline="lq_pde", group=LQ_GRP_PDW, options=["Solid", "Dashed", "Dotted"], active=lq_show_pd and lq_pd_eq_show, tooltip="EQ = midpoint of the previous period's high and low (HTF Profiler logic): it starts at the latest previous-period candle whose body crosses the EQ and is hidden if no body crossed it. Width follows the level width.\n\nPDH/PDL, PWH/PWL and PMH/PML now stay on the chart after they are swept.")

lq_show_pw = input.bool(true, "Show PWH/PWL", inline="lq_pw", group=LQ_GRP_PDW)
lq_pw_color = input.color(#7b1fa2, "Color", inline="lq_pwc", group=LQ_GRP_PDW)
lq_pw_style = input.string("Solid", "Style", inline="lq_pwc", group=LQ_GRP_PDW, options=["Solid", "Dashed", "Dotted"])
lq_pw_width = input.int(1, "Width", inline="lq_pwc", group=LQ_GRP_PDW, minval=1, maxval=5)
lq_pw_eq_show  = input.bool(false, "PW EQ", inline="lq_pwe", group=LQ_GRP_PDW, active=lq_show_pw)
lq_pw_eq_color = input.color(#7b1fa2, "", inline="lq_pwe", group=LQ_GRP_PDW, active=lq_show_pw and lq_pw_eq_show)
lq_pw_eq_style = input.string("Dotted", "", inline="lq_pwe", group=LQ_GRP_PDW, options=["Solid", "Dashed", "Dotted"], active=lq_show_pw and lq_pw_eq_show)

lq_show_pm = input.bool(true, "Show PMH/PML", inline="lq_pm", group=LQ_GRP_PDW)
lq_pm_color = input.color(#7b1fa2, "Color", inline="lq_pmc", group=LQ_GRP_PDW)
lq_pm_style = input.string("Solid", "Style", inline="lq_pmc", group=LQ_GRP_PDW, options=["Solid", "Dashed", "Dotted"])
lq_pm_width = input.int(1, "Width", inline="lq_pmc", group=LQ_GRP_PDW, minval=1, maxval=5)
lq_pm_eq_show  = input.bool(false, "PM EQ", inline="lq_pme", group=LQ_GRP_PDW, active=lq_show_pm)
lq_pm_eq_color = input.color(#7b1fa2, "", inline="lq_pme", group=LQ_GRP_PDW, active=lq_show_pm and lq_pm_eq_show)
lq_pm_eq_style = input.string("Dotted", "", inline="lq_pme", group=LQ_GRP_PDW, options=["Solid", "Dashed", "Dotted"], active=lq_show_pm and lq_pm_eq_show)

// ============================================================================
// SMT on chart — GXV SMT engine (HTF Profiler)
// ============================================================================
string group_smt                = "SMT  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
string group_smt_gates          = "SMT: Gates"
string group_smt_ranks          = "SMT: Families"
string group_smt_htf            = "SMT: HTF Families"
string group_smt_style          = "SMT: Styling"
string group_smt_pairs          = "SMT: Asset Pair Resolver"

const string TIP_DYNAMIC_SMT_LABELS = "When enabled, hides SMT labels on the exact chart timeframe used as that SMT family's maximum calculation gate. 3M and 12M labels are excluded."
const string TIP_CLEANUP = "Controls conflict handling. All removes lower-priority conflicts; Bypass modes keep conflicts but fade the bypassed SMT; None disables cleanup."
const string TIP_NEARBY_ONLY = "Shows only SMTs whose endpoint is within the latest chart bars."
const string TIP_AESTHETIC_BYPASS = "In Bypass cleanup modes, keeps conflicting SMTs visible with lower contrast instead of fully removing them."
const string TIP_BYPASS_LABELS = "Shows labels on faded bypassed SMTs. Turn off for cleaner charts."
const string TIP_FAMILIES = "Each family compares the current and previous range of that timeframe for the chart symbol and each pair: an SMT forms when exactly one of them takes the previous high (bearish) or low (bullish). It shows live while the range develops and is confirmed when the range rolls over. A line whose path crosses a candle body is filtered (except 12M).\nChart gates: 15m/30m ≤ 5m chart · 1H/90m ≤ 15m · 4H/6H/7H ≤ 1H · 12H/1D ≤ 4H · 1W/1M ≤ 6H · 3M ≤ 1D · 12M ≤ 1M."

smt_txt_all                     = input.color(#0f0f0f, "SMT Text", inline="smt_txt", group=group_smt)
smt_label_size                  = input.string(size.small, "SMT Labels Size", options=[size.tiny, size.small, size.normal, size.large, size.huge], group=group_smt)
smt_labels_show                 = input.bool(true, "SMT Labels?", group=group_smt)
smt_dynamic_labels              = input.bool(false, "Dynamic SMT Labels?", group=group_smt, tooltip=TIP_DYNAMIC_SMT_LABELS)

smt_render_nearby_only          = input.bool(false, "Render Gate?  ", group=group_smt_gates, tooltip=TIP_NEARBY_ONLY, inline='renderbars')
smt_nearby_bars                 = input.int(400, " ", minval=1, maxval=5000, group=group_smt_gates, active=smt_render_nearby_only, inline='renderbars')
smt_history_limit               = input.int(20, "Display Cap", minval=1, maxval=100, group=group_smt_gates, tooltip="Maximum retained SMTs per timeframe, pair, and direction bucket.")
smt_monthly_min_tf              = input.string("1 Hour", "Monthly SMTs TF ≥.", options=["None", "1 Hour", "4 Hour", "1 Day"], group=group_smt_gates)
smt_render_current_day_only     = input.bool(false, "Render Only Current Day Range    ", group=group_smt_gates)

smt_auto                        = input.bool(false, "Auto SMT?", group = group_smt_ranks, active = pnl_auto_input, tooltip = "Requires Auto HTF. Intraday families follow the Classic ladder (15m / 1H / 4H).\n\n" + TIP_FAMILIES)
smt_auto_effective              = pnl_auto_input and smt_auto
smt_15m_show                    = input.bool(true, "15m", inline="smt_r1", group=group_smt_ranks, active=not smt_auto_effective)
smt_15m_clr                     = input.color(#b22833, "", inline="smt_r1", group=group_smt_ranks, active=not smt_auto_effective)
smt_30m_show                    = input.bool(true, "30m", inline="smt_r1", group=group_smt_ranks, active=not smt_auto_effective)
smt_30m_clr                     = input.color(#b22833, "", inline="smt_r1", group=group_smt_ranks, active=not smt_auto_effective)
smt_1h_show                     = input.bool(true, "1H ", inline="smt_r1", group=group_smt_ranks, active=not smt_auto_effective)
smt_1h_clr                      = input.color(#b22833, "", inline="smt_r1", group=group_smt_ranks, active=not smt_auto_effective)
smt_90m_show                    = input.bool(true, "90m", inline="smt_r2", group=group_smt_ranks, active=not smt_auto_effective)
smt_90m_clr                     = input.color(#b22833, "", inline="smt_r2", group=group_smt_ranks, active=not smt_auto_effective)
smt_4h_show                     = input.bool(true, "4H ", inline="smt_r2", group=group_smt_ranks, active=not smt_auto_effective)
smt_4h_clr                      = input.color(#0f0f0f, "", inline="smt_r2", group=group_smt_ranks, active=not smt_auto_effective)
smt_6h_show                     = input.bool(true, "6H ", inline="smt_r2", group=group_smt_ranks, active=not smt_auto_effective)
smt_6h_clr                      = input.color(#0f0f0f, "", inline="smt_r2", group=group_smt_ranks, active=not smt_auto_effective)
smt_7h_show                     = input.bool(true, "7H ", inline="smt_r3", group=group_smt_ranks, active=not smt_auto_effective)
smt_7h_clr                      = input.color(#0f0f0f, "", inline="smt_r3", group=group_smt_ranks, active=not smt_auto_effective)
smt_12h_show                    = input.bool(true, "12H", inline="smt_r3", group=group_smt_ranks, active=not smt_auto_effective)
smt_12h_clr                     = input.color(#0f0f0f, "", inline="smt_r3", group=group_smt_ranks, active=not smt_auto_effective)
smt_1d_show                     = input.bool(false, "1D ", inline="smt_r3", group=group_smt_ranks)
smt_1d_clr                      = input.color(#0f0f0f, "", inline="smt_r3", group=group_smt_ranks)
smt_1w_show                     = input.bool(false, "1W ", inline="smt_r4", group=group_smt_htf)
smt_1w_clr                      = input.color(#0f0f0f, "", inline="smt_r4", group=group_smt_htf)
smt_1m_show                     = input.bool(false, "1M ", inline="smt_r4", group=group_smt_htf)
smt_1m_clr                      = input.color(#0f0f0f, "", inline="smt_r4", group=group_smt_htf)
smt_3m_show                     = input.bool(false, "3M ", inline="smt_r5", group=group_smt_htf)
smt_3m_clr                      = input.color(#0f0f0f, "", inline="smt_r5", group=group_smt_htf)
smt_12m_show                    = input.bool(false, "12M", inline="smt_r5", group=group_smt_htf)
smt_12m_clr                     = input.color(#0f0f0f, "", inline="smt_r5", group=group_smt_htf)

smt_line_style_input            = input.string("___", "SMT Line Style", options=["___", "----", "...."], group=group_smt_style)
smt_line_style                  = QTU.lineStyle(smt_line_style_input)
smt_cleanup_mode                = input.string("All", "SMT Cleanup", options=["All", "Bypass Pivot A", "Bypass Pivot B", "Bypass Inside Range", "None"], group=group_smt_style, tooltip=TIP_CLEANUP)
smt_aesthetic_bypass            = input.bool(true, "Aesthetic Bypass?", inline="smt_bypass", group=group_smt_style, active=smt_cleanup_mode == "Bypass Pivot A" or smt_cleanup_mode == "Bypass Pivot B" or smt_cleanup_mode == "Bypass Inside Range", tooltip=TIP_AESTHETIC_BYPASS)
smt_bypass_labels_show          = input.bool(false, "Bypass Labels?", inline="smt_bypass", group=group_smt_style, active=smt_aesthetic_bypass and (smt_cleanup_mode == "Bypass Pivot A" or smt_cleanup_mode == "Bypass Pivot B" or smt_cleanup_mode == "Bypass Inside Range"), tooltip=TIP_BYPASS_LABELS)
smt_cleanup_pivot_a             = smt_cleanup_mode != "Bypass Pivot A" and smt_cleanup_mode != "None"
smt_cleanup_pivot_b             = smt_cleanup_mode != "Bypass Pivot B" and smt_cleanup_mode != "None"
smt_cleanup_inside              = smt_cleanup_mode != "Bypass Inside Range" and smt_cleanup_mode != "None"

smt_correlation_mode            = input.string("Classic", "Correlation Mode", options=["Classic", "Manual"], group=group_smt_pairs, tooltip="Classic: the GXV AssetCorrelationUtils resolver picks the pairs for the chart symbol. Exception: MNQ futures pair with MES and NQ with ES, also on /MNQ, /NQ feeds (+ MYM / YM in Triad); NAS100 (Capital.com, Pepperstone, FXCM, FOREXCOM) pairs with MES.\nManual: use Pair 1 / Pair 2 below.\nThe two pairs feed the chart SMTs and the panel SMT / PSP (2 data requests).")
smt_correlation_type            = input.string("Dyad", "Correlation Type", options=["Dyad", "Triad"], group=group_smt_pairs, active=smt_correlation_mode != "Manual", tooltip="Dyad = chart + 1 pair. Triad = chart + 2 pairs.")
mes_pair_mnq_input              = input.bool(true, 'MES ↔ MNQ1! (CME)', inline='mes_pair1', group=group_smt_pairs, active=smt_correlation_mode != "Manual")
mes_pair_nas_input              = input.bool(false, 'MES ↔ NAS100', inline='mes_pair2', group=group_smt_pairs, active=smt_correlation_mode != "Manual")
mes_pair_nas_broker_input       = input.string('FOREXCOM', '', options=['FOREXCOM', 'PEPPERSTONE', 'CAPITALCOM', 'FXCM'], inline='mes_pair2', group=group_smt_pairs, active=smt_correlation_mode != "Manual" and mes_pair_nas_input, tooltip='Only on an MES (CME) chart, in Classic mode. Pick the pair MES compares against:\n• MNQ1! (CME) — the official micro Nasdaq future\n• NAS100 — the CFD of the selected broker\nBoth ticked: MNQ1! is pair 1 and NAS100 is pair 2 (one extra data request).\nNone ticked: the library default (NQ1!).')
manualCorrelation               = smt_correlation_mode == "Manual"
manualPair1On                   = input.bool(true, 'Pair 1', inline='PAIR1', group=group_smt_pairs, active=manualCorrelation)
manualPair1                     = input.symbol('CME_MINI:MES1!', '', inline='PAIR1', group=group_smt_pairs, active=manualCorrelation and manualPair1On)
manualPair1Inverse              = input.bool(false, 'Inverse', inline='PAIR1', group=group_smt_pairs, active=manualCorrelation and manualPair1On)
manualPair2On                   = input.bool(true, 'Pair 2', inline='PAIR2', group=group_smt_pairs, active=manualCorrelation)
manualPair2                     = input.symbol('CBOT_MINI:MYM1!', '', inline='PAIR2', group=group_smt_pairs, active=manualCorrelation and manualPair2On)
manualPair2Inverse              = input.bool(false, 'Inverse', inline='PAIR2', group=group_smt_pairs, active=manualCorrelation and manualPair2On)

// ============================================================================
// Dashboard
// ============================================================================
string group_dash               = "Dashboard  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
dash_show_input                  = input.bool(true, 'Show Dashboard', group = group_dash)
dash_vert_input                  = input.string('Top', '', options = ['Top', 'Middle', 'Bottom'], inline = 'dash_loc', group = group_dash)
dash_horz_input                  = input.string('Right', '', options = ['Left', 'Center', 'Right'], inline = 'dash_loc', group = group_dash)
dash_text_color_input            = input.color(#0f0f0f, 'Text', group = group_dash, inline = 'dash_color')
dash_bg_color_input              = input.color(#c2baae, 'Background', group = group_dash, inline = 'dash_color')
// Sequence table (4h / 1h PO3 sequence) — inputs
// ============================================================================
string group_seq                 = "Sequence Table  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
seq_show_input                   = input.bool(true, 'Show Sequence', group = group_seq, tooltip = 'Boom: 1m chart → 1H sequence (A: 15m → 3m, B: 15m → 1m)\nOther charts → 4H sequence (A: 1H → 5m, B: 30m → 3m)\nClassic: Fractal HTF, C2 CISD on the Fractal LTF, no lanes.\nBias = latest valid C2 close (C2 + its LTF CISD).')
seq_c3_only_input                = input.bool(true, 'Conditions: C3 Only', group = group_seq, active = seq_show_input and not seq_classic, tooltip = 'On: lanes count only in C3. Off: in every candle after the C2.')
seq_vert_input                   = input.string('Bottom', '', options = ['Top', 'Middle', 'Bottom'], inline = 'seq_loc', group = group_seq, active = seq_show_input)
seq_horz_input                   = input.string('Right', '', options = ['Left', 'Center', 'Right'], inline = 'seq_loc', group = group_seq, active = seq_show_input)
seq_size_input                   = input.string(size.normal, 'Text', options = [size.tiny, size.small, size.normal], inline = 'seq_loc', group = group_seq, active = seq_show_input)
seq_head_bg_input                = input.color(#0f0f0f, 'Header', inline = 'seq_c1', group = group_seq, active = seq_show_input)
seq_head_tx_input                = input.color(#ffffff, '', inline = 'seq_c1', group = group_seq, active = seq_show_input)
seq_row_bg_input                 = input.color(#f2f2f2, 'Rows', inline = 'seq_c1', group = group_seq, active = seq_show_input)
seq_lane_bg_input                = input.color(#dedede, 'Lane', inline = 'seq_c1', group = group_seq, active = seq_show_input)
seq_text_input                   = input.color(#0f0f0f, 'Text', inline = 'seq_c2', group = group_seq, active = seq_show_input)
seq_done_input                   = input.color(#388e3c, 'Done', inline = 'seq_c2', group = group_seq, active = seq_show_input)
seq_watch_input                  = input.color(#f57f17, 'Watching', inline = 'seq_c2', group = group_seq, active = seq_show_input and not seq_classic)
seq_wait_input                   = input.color(#636363, 'Not yet', inline = 'seq_c2', group = group_seq, active = seq_show_input)
seq_bull_input                   = input.color(#0c3299, 'Bull / Bear', inline = 'seq_c3', group = group_seq, active = seq_show_input)
seq_bear_input                   = input.color(#b22833, '', inline = 'seq_c3', group = group_seq, active = seq_show_input)
seq_cand_c3_input                = input.color(#388e3c, 'Candle: C3', inline = 'seq_c4', group = group_seq, active = seq_show_input)
seq_cand_other_input             = input.color(#636363, 'Other', inline = 'seq_c4', group = group_seq, active = seq_show_input, tooltip = 'LIVE CANDLE: C3 / C4 / C5 after a valid C2 close, then WAITING C2. C3–C5 that takes the C2 extreme against the bias → WAITING C2.')
seq_chk_input                    = input.bool(true, 'Score Checklist', group = group_seq, active = seq_show_input, tooltip = 'Show the C2 QUALITY checklist.\nCISD in C2 +75 · inside 75% of C1 +5 · POI +10 · SMT +5 · POI + SMT +5\nLOW 75–80 · HIGH 85–90 · BOOM 95–100 · no CISD = INVALID')
seq_grace_input                  = input.bool(false, 'C2 CISD in C3', group = group_seq, active = seq_show_input and not seq_classic, tooltip = 'Accept the C2 CISD in the first 75% of C3 (1H: 45m, 4H: 3h).')
seq_boom_input                   = input.color(#1b5e20, 'Grade: Boom', inline = 'seq_g', group = group_seq, active = seq_show_input)
seq_high_input                   = input.color(#388e3c, 'High', inline = 'seq_g', group = group_seq, active = seq_show_input)
seq_low_input                    = input.color(#f57f17, 'Low', inline = 'seq_g', group = group_seq, active = seq_show_input)
seq_inv_input                    = input.color(#b22833, 'Invalid', inline = 'seq_g', group = group_seq, active = seq_show_input)

// ============================================================================

// ============================================================================
// Performance — Calculated Bars (HTF Profiler runtime window)
// ============================================================================
string group_perf               = 'Performance'
bool calculate_on_close         = input.bool(true, 'Calculate on Close?', tooltip='When enabled, live setup detection only runs when LTF candles close (better performance).', group = group_perf)
int calc_bars_input             = input.int(1000, 'Calculated Bars', minval = 100, maxval = 5000, group = group_perf, tooltip = 'HTF Profiler approach: the model, IC-CISD and HTF panels only run on the most recent bars.\nEach feature extends the window just enough to fill its HTF candles (capped at 5000 bars). Lower = faster, higher = more history.\nThe on-chart SMT families run on the full history, as in the Profiler (each family is gated by chart timeframe).')

const int PERF_HTF_MAX_BARS     = 5000
int chart_sec                   = timeframe.in_seconds()

// GXVUtils seconds know 'D' / 'W' / 'M' — normalise the 1D / 1W / 1M spellings
normTf(string tf) =>
    tf == '1D' ? 'D' : tf == '1W' ? 'W' : tf == '1M' ? 'M' : tf

tfSec(string tf) =>
    str.length(tf) > 0 ? timeframe.in_seconds(tf) : na

// ── Runtime gates (GXVUtils) ──
htfRuntimeBars(string tf, int count) =>
    QTU.htfRuntimeBars(normTf(tf), count, chart_sec, PERF_HTF_MAX_BARS)

// Feature window capped by Calculated Bars
runtimeOn(int barsBack) =>
    QTU.runtimeOn(barsBack, calc_bars_input, bar_index, last_bar_index)

// HTF window: at least Calculated Bars, extended to fill 'count' HTF candles
htfRuntimeOn(string tf, int count) =>
    QTU.htfRuntimeOn(normTf(tf), count, chart_sec, PERF_HTF_MAX_BARS, calc_bars_input, bar_index, last_bar_index)

// ============================================================================
// HTF Panels — Profiler Classic ladder (GXVUtils)
// ============================================================================

// Chart bucket: <3m=0, <15m=1, <1H=2, <4H=3, <1D=4, <1W=5, <1M=6, <3M=7, else 8
int pnl_bucket = QTU.htfAutoBucket(chart_sec, 180, 900, 3600, 14400, 86400, 604800, timeframe.in_seconds('M'), timeframe.in_seconds('3M'))

// Classic ladder. Fractal PO3 tweak: a 3m chart uses 30m / 1H / 4H.
pnlAutoTf(int pane) =>
    chart_sec == 180 ? (pane == 1 ? '30' : pane == 2 ? '60' : '240') : QTU.htfAutoTf(pnl_bucket, pane, 'Classic Sequence')

pnlValid(string tf, bool show, int count) =>
    int sec = tfSec(tf)
    show and count > 0 and not na(sec) and chart_sec < sec

// ── Panel configuration ──
string pnl_a1_tf    = pnl_auto_input ? pnlAutoTf(1) : pnl1_tf_input
string pnl_a2_tf    = pnl_auto_input ? pnlAutoTf(2) : pnl2_tf_input
string pnl_a3_tf    = pnl_auto_input ? pnlAutoTf(3) : pnl3_tf_input
int    pnl1_count   = pnl1_count_input   // candle count applies to Auto and manual HTF
int    pnl2_count   = pnl2_count_input   // candle count applies to Auto and manual HTF
int    pnl3_count   = pnl3_count_input   // candle count applies to Auto and manual HTF
bool   pnl_a1_ok    = pnlValid(pnl_a1_tf, pnl1_show_input, pnl1_count)
bool   pnl_a2_ok    = pnlValid(pnl_a2_tf, pnl2_show_input, pnl2_count)
bool   pnl_a3_ok    = pnlValid(pnl_a3_tf, pnl3_show_input, pnl3_count)

// Which panel hosts the Fractal model (first panel whose timeframe equals the Fractal HTF)
int    model_sec    = timeframe.in_seconds(model_tf)
int    pnl_a_match  = pnl_a1_ok and tfSec(pnl_a1_tf) == model_sec ? 1 : pnl_a2_ok and tfSec(pnl_a2_tf) == model_sec ? 2 : pnl_a3_ok and tfSec(pnl_a3_tf) == model_sec ? 3 : 0
pnlCountOf(int pane) =>
    pane == 1 ? pnl1_count : pane == 2 ? pnl2_count : pane == 3 ? pnl3_count : 0
// Model keeps C1..C4 (min 4 candles); a matching panel can show more
htf.settings.max_display := math.max(4, pnlCountOf(pnl_a_match))

// ============================================================================
// Helper Functions
// ============================================================================

LineStyle(string style) =>
    switch style
        'Dashed' => line.style_dashed
        'Dotted' => line.style_dotted
        => line.style_solid

LabelSize(string lbl_size) =>
    switch lbl_size
        'Tiny' => size.tiny
        'Normal' => size.normal
        'Large' => size.large
        'Huge' => size.huge
        => size.small

DayofWeek(int index) =>
    switch
        index == 1 => 'M'
        index == 2 => 'T'
        index == 3 => 'W'
        index == 4 => 'T'
        index == 5 => 'F'
        index == 6 => 'S'
        index == 7 => 'S'
        na(index) => ''

ValidTimeframe(string HTF) =>
    if timeframe.in_seconds(HTF) >= timeframe.in_seconds('D') and timeframe.in_seconds(HTF) > timeframe.in_seconds()
        true
    else
        n1 = timeframe.in_seconds()
        n2 = timeframe.in_seconds(HTF)
        n1 < n2 and math.round(n2 / n1) == n2 / n1

// History offset inside the 5000-bar buffer (else the value is skipped)
LbOk(int off) =>
    not na(off) and off >= 0 and off <= 4999
LbC(int off) =>
    na(off) ? 0 : math.max(0, math.min(off, 4999))
// Projection anchors of a setup from its CISD (bull: high / body top at the CISD candle, body bottom at
// the extreme candle; bear mirrored); na beyond the 5000-bar buffer
SetProj(Setup setup, bool bull) =>
    int cl = bar_index - setup.cisd_start_idx
    int el = bar_index - setup.extreme_bar_idx
    int c = LbC(cl)
    int e = LbC(el)
    bool wk = settings.proj_type == "Wick"
    setup.proj_start_idx := setup.cisd_start_idx
    setup.proj_end_idx := setup.extreme_bar_idx + 1
    setup.proj_anchor_1 := wk ? setup.tracked_extreme : not LbOk(el) ? na : bull ? math.min(open[e], close[e]) : math.max(open[e], close[e])
    setup.proj_anchor_0 := not LbOk(cl) ? na : wk ? (bull ? high[c] : low[c]) : bull ? math.max(open[c], close[c]) : math.min(open[c], close[c])
    0

RemainingTime(string HTF) =>
    if barstate.isrealtime
        timeRemaining = (time_close(HTF) - timenow) / 1000
        days = math.floor(timeRemaining / 86400)
        hours = math.floor((timeRemaining - days * 86400) / 3600)
        minutes = math.floor((timeRemaining - days * 86400 - hours * 3600) / 60)
        seconds = math.floor(timeRemaining - days * 86400 - hours * 3600 - minutes * 60)
        r = str.tostring(seconds, '00')
        if minutes > 0 or hours > 0 or days > 0
            r := str.tostring(minutes, '00') + ':' + r
        if hours > 0 or days > 0
            r := str.tostring(hours, '00') + ':' + r
        if days > 0
            r := str.tostring(days) + 'D ' + r
        r
    else
        'n/a'

HTFName(string HTF) =>
    formatted = HTF
    seconds = timeframe.in_seconds(HTF)
    if seconds < 60
        formatted := str.tostring(seconds) + 's'
    else if seconds / 60 < 60
        formatted := str.tostring(seconds / 60) + 'm'
    else if seconds / 60 / 60 < 24
        formatted := str.tostring(seconds / 60 / 60) + 'H'
    formatted

// Panel label (GXVUtils htfLabel): 15 → 15m, 60 → 1H, D → 1D, W → 1W, M → 1M, 12M → 1Y
PanelLabel(string tf) =>
    QTU.htfLabel(tf)

LTFName() =>
    seconds = timeframe.in_seconds()
    result = timeframe.period
    if seconds < 3600
        result := str.tostring(seconds / 60) + 'm'
    else if seconds < 86400
        result := str.tostring(seconds / 3600) + 'H'
    result

CandleSetHigh(array<Candle> candles, float h) =>
    float _h = h
    for c in candles
        if c.h > _h
            _h := c.h
    _h

CandleSetLow(array<Candle> candles, float l) =>
    float _l = l
    for c in candles
        if c.l < _l
            _l := c.l
    _l

GetCisdBodyRange(int cisd_start_idx, int extreme_bar_idx) =>
    float body_hi = na
    float body_lo = na
    if not na(cisd_start_idx) and not na(extreme_bar_idx)
        int off_a = bar_index - extreme_bar_idx
        int off_b = bar_index - cisd_start_idx
        int lo_off = math.max(0, math.min(off_a, off_b))
        int hi_off = math.min(math.max(off_a, off_b), 500)
        if lo_off <= hi_off
            for i = lo_off to hi_off
                float bt = math.max(open[i], close[i])
                float bb = math.min(open[i], close[i])
                body_hi := na(body_hi) ? bt : math.max(body_hi, bt)
                body_lo := na(body_lo) ? bb : math.min(body_lo, bb)
    float body_mid = not na(body_hi) and not na(body_lo) ? (body_hi + body_lo) / 2.0 : na
    [body_lo, body_hi, body_mid]

TrySetEntryZoneC3(Setup setup) =>
    if settings.entry_zone_show and not setup.ez_c3_set and not setup.is_invalid and setup.is_post_c2 and setup.cisd_triggered and not na(setup.c2_mid) and not na(setup.c3_open) and not na(setup.cisd_start_idx) and not na(setup.extreme_bar_idx)
        [body_lo, body_hi, body_mid] = GetCisdBodyRange(setup.cisd_start_idx, setup.extreme_bar_idx)
        if not na(body_lo) and not na(body_hi) and not na(body_mid)
            float c2m = setup.c2_mid
            bool inside = c2m >= body_lo and c2m <= body_hi
            float y2 = inside ? body_mid : setup.c3_open
            setup.ez_c3_top := math.max(c2m, y2)
            setup.ez_c3_bot := math.min(c2m, y2)
            setup.ez_c3_set := true
    setup

TrySetEntryZoneC4(Setup setup, float c3_h, float c3_l, float c4_open_price, int left_time, int right_time) =>
    if not setup.is_invalid and not na(c3_h) and not na(c3_l) and not na(c4_open_price)
        float c3m = (c3_h + c3_l) / 2.0
        setup.c3_mid := c3m
        setup.c3_extreme := setup.is_bullish ? c3_l : c3_h
        setup.c4_open := c4_open_price
        setup.ez_c4_left_time := left_time
        setup.ez_c4_right_time := right_time
        if settings.entry_zone_show and not setup.ez_c4_set
            setup.ez_c4_top := math.max(c3m, c4_open_price)
            setup.ez_c4_bot := math.min(c3m, c4_open_price)
            setup.ez_c4_set := true
            setup.ez_c4_invalid := false
    setup

EntryZoneRight(int locked_right) =>
    int developing = time_close
    na(locked_right) ? developing : (time >= locked_right ? locked_right : math.min(developing, locked_right))

ShowChartEQ() =>
    prev_eq_show and (drawings_type == 'On Chart' or drawings_type == 'Both')

ShowHtfEQ() =>
    prev_eq_show and (drawings_type == 'HTF candle' or drawings_type == 'Both')

FindCandleIndex(array<Candle> candles, int o_idx) =>
    int found = -1
    if not na(o_idx) and candles.size() > 0
        for i = 0 to candles.size() - 1
            if candles.get(i).o_idx == o_idx
                found := i
                break
    found

FindCISDLevel(int extreme_bar_idx, int bias) =>
    int offset = bar_index - extreme_bar_idx
    float cisd_price = na
    int cisd_idx = na
    bool found_first = false
    int last = math.min(offset + 500, bar_index, 4999)
    if LbOk(offset) and offset <= last
        for i = offset to last
            float c_open = open[i]
            float c_close = close[i]
            int candle_attitude = c_close > c_open ? 1 : c_close < c_open ? -1 : 0
            if candle_attitude == 0
                continue
            if not found_first
                if candle_attitude == bias
                    found_first := true
                    cisd_price := c_open
                    cisd_idx := bar_index - i
            else
                if candle_attitude != bias
                    break
                cisd_price := c_open
                cisd_idx := bar_index - i
    [cisd_price, cisd_idx]

// ============================================================================
// IC-CISD
// ============================================================================

const int IC_GREY_BARS    = 10    // bars a taken (grey) dot stays before it is cleared
const int IC_REGISTRY_CAP = 100   // max IC-CISDs kept on the chart

// Persistent IC-CISD registry: independent of any setup's lifespan (FM Base behaviour)
var array<ICCisd> ic_registry = array.new<ICCisd>()

ICHardStop(Setup setup) =>
    setup.is_invalid or setup.ez_c4_invalid or (not na(setup.ez_c4_right_time) and time >= setup.ez_c4_right_time)

ClearICPending(Setup setup) =>
    setup.ic_pending := false
    setup.ic_level := na
    setup.ic_start_idx := na
    setup.ic_extreme := na
    setup.ic_extreme_idx := na
    setup.ic_seen_same_side := false
    setup

StopICDetection(Setup setup) =>
    setup.ic_active := false
    ClearICPending(setup)
    setup

ResetICCisd(Setup setup) =>
    StopICDetection(setup)
    setup.ic_last_extreme := na
    if not na(setup.ic_list)
        for ic in setup.ic_list
            ic.removed := true
        setup.ic_list.clear()
    else
        setup.ic_list := array.new<ICCisd>()
    setup

ICFindSwing(Setup setup, int end_idx) =>
    float best_px = na
    int best_idx = na
    int start = setup.ic_start_idx
    if not na(start) and not na(end_idx) and end_idx > start
        for m = start to end_idx - 1
            if m < 1
                continue
            int off_m = bar_index - m
            int off_l = bar_index - (m - 1)
            int off_r = bar_index - (m + 1)
            if off_m < 0 or off_l < 0 or off_r < 0 or off_l > 4999
                continue
            if setup.is_bullish
                if low[off_m] <= low[off_l] and low[off_m] <= low[off_r]
                    if na(best_px) or low[off_m] < best_px
                        best_px := low[off_m]
                        best_idx := m
            else
                if high[off_m] >= high[off_l] and high[off_m] >= high[off_r]
                    if na(best_px) or high[off_m] > best_px
                        best_px := high[off_m]
                        best_idx := m
    [best_px, best_idx]

// Re-anchor the IC level on the opposing run that leads into the current extreme (FM Base)
ICRetrace(Setup setup) =>
    [lvl, lvl_idx] = FindCISDLevel(setup.ic_extreme_idx, setup.is_bullish ? -1 : 1)
    if not na(lvl)
        setup.ic_level := lvl
        setup.ic_start_idx := lvl_idx
    setup

// Greys a dot when price wicks beyond its extreme, then clears it IC_GREY_BARS later.
// Runs over the global registry every bar, so dots keep updating after detection stops.
ICMarkTakenAll() =>
    if ic_registry.size() > 0
        for i = ic_registry.size() - 1 to 0
            ICCisd ic = ic_registry.get(i)
            bool drop = ic.removed or (not ic.visible and not na(ic.end_idx) and bar_index - ic.end_idx > 500)
            if not drop
                if not ic.taken and not na(ic.extreme_price)
                    bool hit = ic.is_bull ? low < ic.extreme_price : high > ic.extreme_price
                    if hit
                        ic.taken := true
                        ic.taken_bar := bar_index
                drop := ic.taken and not na(ic.taken_bar) and bar_index - ic.taken_bar >= IC_GREY_BARS
            if drop
                ic_registry.remove(i)
    0

ICRegister(Setup setup, float sw_px, int sw_idx) =>
    ICCisd ic = ICCisd.new()
    ic.level := setup.ic_level
    ic.start_idx := setup.ic_start_idx
    ic.end_idx := bar_index
    ic.extreme_price := sw_px
    ic.extreme_idx := sw_idx
    ic.is_bull := setup.is_bullish
    ic.visible := setup.cisd_triggered
    ic.start_time := time[LbC(bar_index - setup.ic_start_idx)]
    ic.end_time := time
    ic.extreme_time := time[LbC(bar_index - sw_idx)]
    if na(setup.ic_list)
        setup.ic_list := array.new<ICCisd>()
    array.push(setup.ic_list, ic)
    ic_registry.push(ic)
    while ic_registry.size() > IC_REGISTRY_CAP
        ic_registry.shift()
    setup.ic_last_extreme := sw_px
    setup

ICUpdate(Setup setup) =>
    // ICs found before the main CISD triggered become visible once it does
    if setup.cisd_triggered and not na(setup.ic_list) and setup.ic_list.size() > 0
        for ic in setup.ic_list
            ic.visible := true
    if not settings.ic_cisd_show
        setup
    else if not barstate.isconfirmed
        setup
    else if ICHardStop(setup)
        StopICDetection(setup)
        setup
    else if na(setup.cisd_end_idx)
        if not setup.is_invalid and (setup.ic_active or setup.ic_pending)
            ResetICCisd(setup)
        else
            StopICDetection(setup)
        setup
    else if bar_index <= setup.cisd_end_idx
        if setup.ic_active or setup.ic_pending
            ClearICPending(setup)
            setup.ic_active := false
        setup
    else
        if not setup.ic_active
            setup.ic_active := true
            if na(setup.ic_list)
                setup.ic_list := array.new<ICCisd>()
            ClearICPending(setup)
        bool opp_bar = setup.is_bullish ? (close < open) : (close > open)
        if setup.ic_pending
            // New extreme: the dot moves and the level re-anchors on the opposing run into it
            bool new_ext = setup.is_bullish ? (low < setup.ic_extreme) : (high > setup.ic_extreme)
            if new_ext
                setup.ic_extreme := setup.is_bullish ? low : high
                setup.ic_extreme_idx := bar_index
                ICRetrace(setup)
            // Body break through the current level, strictly after the extreme bar
            if bar_index > setup.ic_extreme_idx and not na(setup.ic_level)
                bool broke = setup.is_bullish ? (close > setup.ic_level) : (close < setup.ic_level)
                if broke
                    [sw_px, sw_idx] = ICFindSwing(setup, bar_index)
                    if not na(sw_px) and not na(sw_idx)
                        ICRegister(setup, sw_px, sw_idx)
                        ClearICPending(setup)
                    else if not new_ext
                        // Broke with no swing and no new extreme: drop it so the next opposite candle can arm a fresh IC
                        ClearICPending(setup)
        else
            if opp_bar
                setup.ic_pending := true
                setup.ic_level := open
                setup.ic_start_idx := bar_index
                setup.ic_extreme := setup.is_bullish ? low : high
                setup.ic_extreme_idx := bar_index
                setup.ic_seen_same_side := false
        setup

// ============================================================================
// Liquidity Suite — Helper Functions
// ============================================================================

lq_f_style(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

var color lq_colors_transparent = color.new(color.white, 100)

// ============================================================================
// Liquidity Suite — True Day Open
// ============================================================================

string lq_day_open_sess = lq_day_open_mode == "6 PM" ? "1800-1801" : "0000-0001"
string lq_day_open_txt  = lq_day_open_mode == "6 PM" ? "D OPEN" : "TDO"
var line lq_tdo_line = na
var label lq_tdo_label = na
if lq_use_true_open and timeframe.in_seconds() < timeframe.in_seconds(lq_hide_above_tf)
    bool is_day_open  = not na(time("", lq_day_open_sess, lq_session_tz))
    bool was_day_open = not na(time("", lq_day_open_sess, lq_session_tz)[1])
    if is_day_open and not was_day_open
        if not na(lq_tdo_line)
            line.delete(lq_tdo_line)
        lq_tdo_line := line.new(time, open, time, open, xloc=xloc.bar_time, color=lq_tdo_color, style=lq_f_style(lq_tdo_style), width=lq_tdo_width)
        if not na(lq_tdo_label)
            label.delete(lq_tdo_label)
        lq_tdo_label := label.new(time, open, lq_day_open_txt, xloc=xloc.bar_time, color=lq_colors_transparent, textcolor=lq_tdo_color, style=label.style_label_down, size=size.small, text_font_family=font.family_monospace)
    if not na(lq_tdo_line)
        lq_tdo_line.set_x2(time)
    if not na(lq_tdo_label)
        lq_tdo_label.set_x(time)
        lq_tdo_label.set_textcolor(lq_tdo_show_label ? lq_tdo_color : lq_colors_transparent)
else if not na(lq_tdo_line)
    line.delete(lq_tdo_line)
    lq_tdo_line := na
    if not na(lq_tdo_label)
        label.delete(lq_tdo_label)
        lq_tdo_label := na

// ============================================================================
// Liquidity Suite — PDH/PDL/PWH/PWL/PMH/PML
// ============================================================================

// One lightweight previous-period H/L tracker per period, shared by the High,
// the Low and the EQ level.
// EQ (HTF Profiler logic): at rollover, find the latest bar of the period that just closed
// whose body crosses (H + L) / 2; the EQ line starts there. No body crossing → no EQ line.
f_prev_hl(string _htf, bool _eq) =>
    var float _h0 = high
    var float _l0 = low
    var int   _h0bar = time
    var int   _l0bar = time
    var float _h1 = high
    var float _l1 = low
    var int   _h1bar = time
    var int   _l1bar = time
    var int   _s0 = bar_index
    var int   _eq1bar = na
    bool _chg = timeframe.change(_htf)
    if _chg
        _h1 := _h0
        _l1 := _l0
        _h1bar := _h0bar
        _l1bar := _l0bar
        _eq1bar := na
        if _eq
            float _eqp = (_h1 + _l1) / 2.0
            int _scan = math.min(bar_index - _s0, 4999)
            if _scan >= 1
                for _o = 1 to _scan
                    if math.min(open[_o], close[_o]) <= _eqp and math.max(open[_o], close[_o]) >= _eqp
                        _eq1bar := time[_o]
                        break
        _s0 := bar_index
        _h0 := high
        _l0 := low
        _h0bar := time
        _l0bar := time
    if high >= _h0
        _h0 := high
        _h0bar := time
    if low <= _l0
        _l0 := low
        _l0bar := time
    [_h1, _l1, _h1bar, _l1bar, _chg, _eq1bar]

// Level stays after it is swept; redrawn only when a new period starts.
// x2 is moved on the last bar only (time-based, so no bar_index limit).
f_prev_level(float h1, float l1, int h1bar, int l1bar, bool per_change, bool isHigh, string lbltxt, color clr, string styleStr, int wid, bool enabled) =>
    if enabled
        var line  ln = na
        var label lb = na
        if per_change and not na(h1) and not na(l1)
            float lv = isHigh ? h1 : l1
            int   nb = isHigh ? h1bar : l1bar
            line.delete(ln)
            label.delete(lb)
            ln := line.new(nb, lv, time, lv, xloc=xloc.bar_time, color=clr, style=lq_f_style(styleStr), width=wid)
            lb := label.new(time, lv, lbltxt, xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.black, 100), textcolor=clr, size=size.small)
        else if barstate.islast and not na(ln)
            line.set_x2(ln, time)
            label.set_x(lb, time)
        0  // keep the if-branches' return types out of the function result

f_prev_eq(float h1, float l1, int eqbar, bool per_change, string lbltxt, color clr, string styleStr, int wid, bool enabled) =>
    if enabled
        var line  ln = na
        var label lb = na
        if per_change
            line.delete(ln)
            label.delete(lb)
            ln := na
            lb := na
            if not na(h1) and not na(l1) and not na(eqbar)
                float eq = (h1 + l1) / 2.0
                ln := line.new(eqbar, eq, time, eq, xloc=xloc.bar_time, color=clr, style=lq_f_style(styleStr), width=wid)
                lb := label.new(time, eq, lbltxt, xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.black, 100), textcolor=clr, size=size.small)
        else if barstate.islast and not na(ln)
            line.set_x2(ln, time)
            label.set_x(lb, time)
        0  // keep the if-branches' return types out of the function result

[lq_pd_h1, lq_pd_l1, lq_pd_h1bar, lq_pd_l1bar, lq_pd_chg, lq_pd_eqbar] = f_prev_hl("D", lq_show_pd and lq_pd_eq_show)
[lq_pw_h1, lq_pw_l1, lq_pw_h1bar, lq_pw_l1bar, lq_pw_chg, lq_pw_eqbar] = f_prev_hl("W", lq_show_pw and lq_pw_eq_show)
[lq_pm_h1, lq_pm_l1, lq_pm_h1bar, lq_pm_l1bar, lq_pm_chg, lq_pm_eqbar] = f_prev_hl("M", lq_show_pm and lq_pm_eq_show)

f_prev_level(lq_pd_h1, lq_pd_l1, lq_pd_h1bar, lq_pd_l1bar, lq_pd_chg, true,  "PDH", lq_pd_color, lq_pd_style, lq_pd_width, lq_show_pd)
f_prev_level(lq_pd_h1, lq_pd_l1, lq_pd_h1bar, lq_pd_l1bar, lq_pd_chg, false, "PDL", lq_pd_color, lq_pd_style, lq_pd_width, lq_show_pd)
f_prev_eq(lq_pd_h1, lq_pd_l1, lq_pd_eqbar, lq_pd_chg, "PD-EQ", lq_pd_eq_color, lq_pd_eq_style, lq_pd_width, lq_show_pd and lq_pd_eq_show)
f_prev_level(lq_pw_h1, lq_pw_l1, lq_pw_h1bar, lq_pw_l1bar, lq_pw_chg, true,  "PWH", lq_pw_color, lq_pw_style, lq_pw_width, lq_show_pw)
f_prev_level(lq_pw_h1, lq_pw_l1, lq_pw_h1bar, lq_pw_l1bar, lq_pw_chg, false, "PWL", lq_pw_color, lq_pw_style, lq_pw_width, lq_show_pw)
f_prev_eq(lq_pw_h1, lq_pw_l1, lq_pw_eqbar, lq_pw_chg, "PW-EQ", lq_pw_eq_color, lq_pw_eq_style, lq_pw_width, lq_show_pw and lq_pw_eq_show)
f_prev_level(lq_pm_h1, lq_pm_l1, lq_pm_h1bar, lq_pm_l1bar, lq_pm_chg, true,  "PMH", lq_pm_color, lq_pm_style, lq_pm_width, lq_show_pm)
f_prev_level(lq_pm_h1, lq_pm_l1, lq_pm_h1bar, lq_pm_l1bar, lq_pm_chg, false, "PML", lq_pm_color, lq_pm_style, lq_pm_width, lq_show_pm)
f_prev_eq(lq_pm_h1, lq_pm_l1, lq_pm_eqbar, lq_pm_chg, "PM-EQ", lq_pm_eq_color, lq_pm_eq_style, lq_pm_width, lq_show_pm and lq_pm_eq_show)

// ============================================================================
// Dashboard helpers
// ============================================================================

dash_table_position(string vert, string horz) =>
    switch vert + '-' + horz
        'Top-Left'      => position.top_left
        'Top-Center'    => position.top_center
        'Top-Right'     => position.top_right
        'Middle-Left'   => position.middle_left
        'Middle-Center' => position.middle_center
        'Middle-Right'  => position.middle_right
        'Bottom-Left'   => position.bottom_left
        'Bottom-Center' => position.bottom_center
        'Bottom-Right'  => position.bottom_right
        => position.top_right

// ============================================================================
// Drawing Bin Methods
// ============================================================================

method clear(DrawingBin bin) =>
    for ln in bin.lines
        ln.delete()
    for bx in bin.boxes
        bx.delete()
    for lbl in bin.labels
        lbl.delete()
    bin.lines.clear()
    bin.boxes.clear()
    bin.labels.clear()

// ============================================================================
// Data Collection Methods (NO DRAWING)
// ============================================================================

method Monitor(CandleSet candleSet, bool isNewHTFCandleArg) =>
    isNewHTFCandle = isNewHTFCandleArg
    if isNewHTFCandle
        if candleSet.has_live_bearish
            Setup setup = candleSet.live_bearish
            if setup.sweep_bar_idx != bar_index and not setup.is_post_c2
                bool c2_confirmed = close[1] < setup.sweep_price
                if not c2_confirmed
                    candleSet.has_live_bearish := false
        if candleSet.has_live_bullish
            Setup setup = candleSet.live_bullish
            if setup.sweep_bar_idx != bar_index and not setup.is_post_c2
                bool c2_confirmed = close[1] > setup.sweep_price
                if not c2_confirmed
                    candleSet.has_live_bullish := false
    int prev_idx = isNewHTFCandle ? 0 : 1
    if candleSet.candles.size() > prev_idx
        Candle prev_htf = candleSet.candles.get(prev_idx)
        bool high_breached = high > prev_htf.h
        bool low_breached = low < prev_htf.l
        bool high_sweep_confirmed = high_breached and close < prev_htf.h
        bool low_sweep_confirmed = low_breached and close > prev_htf.l
        // ===== C4 INVALIDATION =====
        for [i, setup] in candleSet.setups
            if setup.cisd_triggered and not na(setup.liq_end_time) and time < setup.liq_end_time
                if setup.is_bullish
                    if not setup.ez_c4_invalid and not na(setup.c3_extreme) and not na(setup.ez_c4_left_time) and not na(setup.ez_c4_right_time) and time < setup.ez_c4_right_time and low < setup.c3_extreme
                        setup.ez_c4_invalid := true
                        setup.ez_c4_invalid_time := time_close
                else
                    if not setup.ez_c4_invalid and not na(setup.c3_extreme) and not na(setup.ez_c4_left_time) and not na(setup.ez_c4_right_time) and time < setup.ez_c4_right_time and high > setup.c3_extreme
                        setup.ez_c4_invalid := true
                        setup.ez_c4_invalid_time := time_close
                ICUpdate(setup)
        // ===== BEARISH TRACKING =====
        if not candleSet.has_live_bearish
            if high_breached
                Setup setup = Setup.new()
                setup.is_bullish := false
                setup.is_confirmed := false
                setup.sweep_price := prev_htf.h
                setup.sweep_ltf_idx := prev_htf.h_idx
                setup.sweep_bar_idx := bar_index
                setup.swept_candle_idx := prev_htf.o_idx
                setup.htf_candle_idx := isNewHTFCandle ? bar_index : candleSet.candles.first().o_idx
                setup.ltf_end_idx := bar_index + 50
                setup.c2_x := bar_index
                setup.c2_y := high
                setup.htf_count := 1
                if isNewHTFCandle
                    setup.tracked_extreme := high
                    setup.extreme_bar_idx := bar_index
                else
                    if high > candleSet.candles.first().h
                        setup.tracked_extreme := high
                        setup.extreme_bar_idx := bar_index
                    else
                        setup.tracked_extreme := candleSet.candles.first().h
                        setup.extreme_bar_idx := candleSet.candles.first().h_idx
                [cisd_price, cisd_idx] = FindCISDLevel(setup.extreme_bar_idx, 1)
                if not na(cisd_price)
                    setup.cisd_level := cisd_price
                    setup.cisd_start_idx := cisd_idx
                    setup.has_cisd := true
                if high_sweep_confirmed
                    setup.is_confirmed := true
                candleSet.live_bearish := setup
                candleSet.has_live_bearish := true
        else
            setup = candleSet.live_bearish
            if not setup.is_post_c2
                setup.is_confirmed := close < setup.sweep_price
                if high > setup.tracked_extreme
                    setup.tracked_extreme := high
                    setup.extreme_bar_idx := bar_index
                    setup.c2_x := bar_index
                    setup.c2_y := high
                    [new_cisd_price, new_cisd_idx] = FindCISDLevel(bar_index, 1)
                    if not na(new_cisd_price)
                        setup.cisd_level := new_cisd_price
                        setup.cisd_start_idx := new_cisd_idx
                        setup.has_cisd := true
                        setup.cisd_triggered := false
                        setup.cisd_end_idx := na
                        ResetICCisd(setup)
                if setup.has_cisd and na(setup.cisd_end_idx) and close < setup.cisd_level
                    setup.cisd_end_idx := bar_index
                if setup.is_confirmed and setup.has_cisd and not setup.cisd_triggered and not na(setup.cisd_end_idx)
                    setup.cisd_triggered := true
                    SetProj(setup, false)
                ICUpdate(setup)
            else
                bool setup_replaced = false
                if high > setup.c2_extreme
                    if setup.cisd_triggered
                        setup.is_invalid := true
                        StopICDetection(setup)
                        candleSet.setups.unshift(setup)
                    Candle old_c2 = candleSet.candles.get(1)
                    Setup new_setup = Setup.new()
                    new_setup.is_bullish := false
                    new_setup.is_confirmed := false
                    new_setup.is_post_c2 := false
                    new_setup.sweep_price := setup.c2_extreme
                    new_setup.sweep_ltf_idx := old_c2.h_idx
                    new_setup.sweep_bar_idx := bar_index
                    new_setup.swept_candle_idx := setup.htf_candle_idx
                    new_setup.htf_candle_idx := candleSet.candles.first().o_idx
                    new_setup.ltf_end_idx := bar_index + 50
                    new_setup.c2_x := bar_index
                    new_setup.c2_y := high
                    new_setup.htf_count := 1
                    new_setup.tracked_extreme := high
                    new_setup.extreme_bar_idx := bar_index
                    [cisd_price, cisd_idx] = FindCISDLevel(bar_index, 1)
                    if not na(cisd_price)
                        new_setup.cisd_level := cisd_price
                        new_setup.cisd_start_idx := cisd_idx
                        new_setup.has_cisd := true
                    if close < new_setup.sweep_price
                        new_setup.is_confirmed := true
                    candleSet.live_bearish := new_setup
                    setup_replaced := true
                if not setup_replaced
                    if setup.has_cisd and not setup.cisd_triggered and close < setup.cisd_level
                        setup.cisd_triggered := true
                        setup.cisd_end_idx := bar_index
                        SetProj(setup, false)
                        setup.liq_end_time := (time_close(candleSet.settings.htf) + timeframe.in_seconds(candleSet.settings.htf) * 1000)
                        TrySetEntryZoneC3(setup)
                if not setup_replaced
                    ICUpdate(setup)
        // ===== BULLISH TRACKING =====
        if not candleSet.has_live_bullish
            if low_breached
                Setup setup = Setup.new()
                setup.is_bullish := true
                setup.is_confirmed := false
                setup.sweep_price := prev_htf.l
                setup.sweep_ltf_idx := prev_htf.l_idx
                setup.sweep_bar_idx := bar_index
                setup.swept_candle_idx := prev_htf.o_idx
                setup.htf_candle_idx := isNewHTFCandle ? bar_index : candleSet.candles.first().o_idx
                setup.ltf_end_idx := bar_index + 50
                setup.c2_x := bar_index
                setup.c2_y := low
                setup.htf_count := 1
                if isNewHTFCandle
                    setup.tracked_extreme := low
                    setup.extreme_bar_idx := bar_index
                else
                    if low < candleSet.candles.first().l
                        setup.tracked_extreme := low
                        setup.extreme_bar_idx := bar_index
                    else
                        setup.tracked_extreme := candleSet.candles.first().l
                        setup.extreme_bar_idx := candleSet.candles.first().l_idx
                [cisd_price, cisd_idx] = FindCISDLevel(setup.extreme_bar_idx, -1)
                if not na(cisd_price)
                    setup.cisd_level := cisd_price
                    setup.cisd_start_idx := cisd_idx
                    setup.has_cisd := true
                if low_sweep_confirmed
                    setup.is_confirmed := true
                candleSet.live_bullish := setup
                candleSet.has_live_bullish := true
        else
            setup = candleSet.live_bullish
            if not setup.is_post_c2
                setup.is_confirmed := close > setup.sweep_price
                if low < setup.tracked_extreme
                    setup.tracked_extreme := low
                    setup.extreme_bar_idx := bar_index
                    setup.c2_x := bar_index
                    setup.c2_y := low
                    [new_cisd_price, new_cisd_idx] = FindCISDLevel(bar_index, -1)
                    if not na(new_cisd_price)
                        setup.cisd_level := new_cisd_price
                        setup.cisd_start_idx := new_cisd_idx
                        setup.has_cisd := true
                        setup.cisd_triggered := false
                        setup.cisd_end_idx := na
                        ResetICCisd(setup)
                if setup.has_cisd and na(setup.cisd_end_idx) and close > setup.cisd_level
                    setup.cisd_end_idx := bar_index
                if setup.is_confirmed and setup.has_cisd and not setup.cisd_triggered and not na(setup.cisd_end_idx)
                    setup.cisd_triggered := true
                    SetProj(setup, true)
                ICUpdate(setup)
            else
                bool setup_replaced = false
                if low < setup.c2_extreme
                    if setup.cisd_triggered
                        setup.is_invalid := true
                        StopICDetection(setup)
                        candleSet.setups.unshift(setup)
                    Candle old_c2 = candleSet.candles.get(1)
                    Setup new_setup = Setup.new()
                    new_setup.is_bullish := true
                    new_setup.is_confirmed := false
                    new_setup.is_post_c2 := false
                    new_setup.sweep_price := setup.c2_extreme
                    new_setup.sweep_ltf_idx := old_c2.l_idx
                    new_setup.sweep_bar_idx := bar_index
                    new_setup.swept_candle_idx := setup.htf_candle_idx
                    new_setup.htf_candle_idx := candleSet.candles.first().o_idx
                    new_setup.ltf_end_idx := bar_index + 50
                    new_setup.c2_x := bar_index
                    new_setup.c2_y := low
                    new_setup.htf_count := 1
                    new_setup.tracked_extreme := low
                    new_setup.extreme_bar_idx := bar_index
                    [cisd_price, cisd_idx] = FindCISDLevel(bar_index, -1)
                    if not na(cisd_price)
                        new_setup.cisd_level := cisd_price
                        new_setup.cisd_start_idx := cisd_idx
                        new_setup.has_cisd := true
                    if close > new_setup.sweep_price
                        new_setup.is_confirmed := true
                    candleSet.live_bullish := new_setup
                    setup_replaced := true
                if not setup_replaced
                    if setup.has_cisd and not setup.cisd_triggered and close > setup.cisd_level
                        setup.cisd_triggered := true
                        setup.cisd_end_idx := bar_index
                        SetProj(setup, true)
                        setup.liq_end_time := (time_close(candleSet.settings.htf) + timeframe.in_seconds(candleSet.settings.htf) * 1000)
                        TrySetEntryZoneC3(setup)
                if not setup_replaced
                    ICUpdate(setup)
    if isNewHTFCandle
        if candleSet.has_live_bearish
            Setup setup = candleSet.live_bearish
            if setup.sweep_bar_idx != bar_index
                setup.htf_count := setup.htf_count + 1
                if not setup.is_post_c2
                    bool c2_confirmed = close[1] < setup.sweep_price
                    if c2_confirmed
                        setup.is_post_c2 := true
                        setup.is_confirmed := true
                        setup.ltf_end_idx := bar_index
                        setup.c2_extreme := candleSet.candles.first().h
                        setup.c2_mid := (candleSet.candles.first().h + candleSet.candles.first().l) / 2.0
                        setup.c3_open := open
                        setup.ez_c3_left_time := time
                        TrySetEntryZoneC3(setup)
                    else
                        candleSet.has_live_bearish := false
                else
                    if setup.htf_count >= 2
                        if setup.cisd_triggered
                            if na(setup.proj_anchor_0) and setup.has_cisd
                                SetProj(setup, false)
                            setup.liq_end_time := (time_close(candleSet.settings.htf) + timeframe.in_seconds(candleSet.settings.htf) * 1000)
                            setup.ez_c3_right_time := time
                            int ez_c4_right = time_close(candleSet.settings.htf)
                            TrySetEntryZoneC4(setup, candleSet.candles.first().h, candleSet.candles.first().l, open, time, ez_c4_right)
                            candleSet.setups.unshift(setup)
                        candleSet.has_live_bearish := false
        if candleSet.has_live_bullish
            Setup setup = candleSet.live_bullish
            if setup.sweep_bar_idx != bar_index
                setup.htf_count := setup.htf_count + 1
                if not setup.is_post_c2
                    bool c2_confirmed = close[1] > setup.sweep_price
                    if c2_confirmed
                        setup.is_post_c2 := true
                        setup.is_confirmed := true
                        setup.ltf_end_idx := bar_index
                        setup.c2_extreme := candleSet.candles.first().l
                        setup.c2_mid := (candleSet.candles.first().h + candleSet.candles.first().l) / 2.0
                        setup.c3_open := open
                        setup.ez_c3_left_time := time
                        TrySetEntryZoneC3(setup)
                    else
                        candleSet.has_live_bullish := false
                else
                    if setup.htf_count >= 2
                        if setup.cisd_triggered
                            if na(setup.proj_anchor_0) and setup.has_cisd
                                SetProj(setup, true)
                            setup.liq_end_time := (time_close(candleSet.settings.htf) + timeframe.in_seconds(candleSet.settings.htf) * 1000)
                            setup.ez_c3_right_time := time
                            int ez_c4_right_bull = time_close(candleSet.settings.htf)
                            TrySetEntryZoneC4(setup, candleSet.candles.first().h, candleSet.candles.first().l, open, time, ez_c4_right_bull)
                            candleSet.setups.unshift(setup)
                        candleSet.has_live_bullish := false
        Candle candle = Candle.new()
        candle.o := open
        candle.c := close
        candle.h := high
        candle.l := low
        candle.o_time := time
        candle.o_idx := bar_index
        candle.c_idx := bar_index
        candle.h_idx := bar_index
        candle.l_idx := bar_index
        candle.dow := switch
            candleSet.settings.htf == '1D' =>
                DayofWeek(dayofweek(time_tradingday, "America/New_York"))
            candleSet.settings.htf == '1W' =>
                str.format_time(candle.o_time, 'MMM d', 'America/New_York')
            candleSet.settings.htf == '1M' =>
                str.format_time(candle.o_time, 'MMM', 'America/New_York')
            candleSet.settings.htf == '3M' =>
                int m = month(candle.o_time, 'America/New_York')
                m <= 3 ? 'Q1' : m <= 6 ? 'Q2' : m <= 9 ? 'Q3' : 'Q4'
            candleSet.settings.htf == '12M' =>
                ''
            =>
                str.format_time(candle.o_time, 'HH:mm', 'America/New_York')
        candleSet.candles.unshift(candle)
        if candleSet.candles.size() > 1
            Candle prev = candleSet.candles.get(1)
            prev.c_time := candle.o_time
        if candleSet.candles.size() > 2
            Candle prev_candle = candleSet.candles.get(1)
            Candle prev_prev_candle = candleSet.candles.get(2)
            bool high_breached = prev_candle.h > prev_prev_candle.h
            bool low_breached = prev_candle.l < prev_prev_candle.l
            bool high_sweep_condition = high_breached and prev_candle.c < prev_prev_candle.h
            bool low_sweep_condition = low_breached and prev_candle.c > prev_prev_candle.l
            if settings.sweep_show
                if high_sweep_condition
                    Sweep sweep = Sweep.new()
                    sweep.price := prev_prev_candle.h
                    sweep.ltf_index := prev_prev_candle.h_idx
                    sweep.htf_candle_idx := prev_candle.o_idx
                    sweep.swept_candle_idx := prev_prev_candle.o_idx
                    sweep.ltf_end_idx := candle.o_idx
                    sweep.is_high := true
                    candleSet.sweeps.push(sweep)
                if low_sweep_condition
                    Sweep sweep = Sweep.new()
                    sweep.price := prev_prev_candle.l
                    sweep.ltf_index := prev_prev_candle.l_idx
                    sweep.htf_candle_idx := prev_candle.o_idx
                    sweep.swept_candle_idx := prev_prev_candle.o_idx
                    sweep.ltf_end_idx := candle.o_idx
                    sweep.is_high := false
                    candleSet.sweeps.push(sweep)
                int max_setups = (candleSet.settings.max_display + settings.sweep_history) * 2
                while candleSet.setups.size() > max_setups
                    candleSet.setups.pop()
        if candleSet.candles.size() > candleSet.settings.max_display
            Candle delCandle = array.pop(candleSet.candles)
            if candleSet.sweeps.size() > 0
                for i = candleSet.sweeps.size() - 1 to 0 by 1
                    Sweep sweep = candleSet.sweeps.get(i)
                    if sweep.swept_candle_idx == delCandle.o_idx
                        candleSet.sweeps.remove(i)
    candleSet

method Update(CandleSet candleSet) =>
    if candleSet.candles.size() > 0
        Candle candle = candleSet.candles.first()
        if high > candle.h
            candle.h := high
            candle.h_idx := bar_index
        if low < candle.l
            candle.l := low
            candle.l_idx := bar_index
        candle.c := close
        candle.c_idx := bar_index
        if candleSet.trace.start_idx == 0
            candleSet.trace.start_idx := candle.o_idx
            candleSet.trace.start_price := candle.o
    candleSet

// ============================================================================
// HTF panel features — FVG / SMT / PSP (HTF Profiler: draw_htf_fvgs,
// apply_htf_pair_smt, GXV Equinox PSP). Computed and drawn on the last bar only.
// ============================================================================

BiasOk(int dir) =>
    settings.bias == 'Neutral' or (dir == 1 and settings.bias == 'Bullish') or (dir == -1 and settings.bias == 'Bearish')

// Keeps one pair candle per panel candle (matched by open time). Inverse pairs arrive normalised.
SyncPairCandle(array<HtfPairCandle> pc, bool enabled, float o, float h, float l, float c, int main_ot, int cap) =>
    if not enabled
        if pc.size() > 0
            pc.clear()
    else if not na(main_ot) and not na(o) and not na(h) and not na(l) and not na(c)
        if pc.size() == 0 or pc.first().ot != main_ot
            pc.unshift(HtfPairCandle.new(o, h, l, c, main_ot))
        else
            HtfPairCandle a = pc.first()
            a.h := math.max(a.h, h)
            a.l := math.min(a.l, l)
            a.c := c
        while pc.size() > cap
            pc.pop()
    0

FindPairIdx(array<HtfPairCandle> pc, int ot) =>
    int r = -1
    if not na(ot) and pc.size() > 0
        for [i, p] in pc
            if p.ot == ot
                r := i
                break
    r

ApplyPairSmt(array<Candle> src, int i, array<HtfPairCandle> pc, bool ready, bool psp) =>
    if ready and src.size() > i
        Candle cur = src.get(i)
        int pi = FindPairIdx(pc, cur.o_time)
        if pi >= 0
            HtfPairCandle p = pc.get(pi)
            if psp
                int cur_dir = cur.c > cur.o ? 1 : cur.c < cur.o ? -1 : 0
                int pair_dir = p.c > p.o ? 1 : p.c < p.o ? -1 : 0
                cur.psp := cur_dir != 0 and pair_dir != 0 and cur_dir != pair_dir
            if src.size() > i + 1
                Candle prv = src.get(i + 1)
                int ppi = FindPairIdx(pc, prv.o_time)
                if ppi >= 0
                    HtfPairCandle pp = pc.get(ppi)
                    cur.smt_bull := cur.smt_bull or (cur.l < prv.l and p.l > pp.l) or (cur.l > prv.l and p.l < pp.l)
                    cur.smt_bear := cur.smt_bear or (cur.h > prv.h and p.h < pp.h) or (cur.h < prv.h and p.h > pp.h)
    0

PanelFeatures(array<Candle> arr, array<HtfPairCandle> p1, array<HtfPairCandle> p2, bool ok1, bool ok2) =>
    for c in arr
        c.smt_bull := false
        c.smt_bear := false
        c.psp := false
    if (htf_smt_show or htf_psp_show) and arr.size() >= 1
        for i = 0 to arr.size() - 1
            ApplyPairSmt(arr, i, p1, ok1, htf_psp_show)
            ApplyPairSmt(arr, i, p2, ok2, false)
    0

// '+PSP' for the C2 label of candle i
PspTag(array<Candle> arr, int i) =>
    htf_psp_show and i >= 0 and i < arr.size() and arr.get(i).psp ? '+PSP' : ''

// A newer panel candle trading through the SMT candle's extreme invalidates it
PanelSmtInvalid(array<Candle> arr, int i, bool bull) =>
    bool inv = false
    if i > 0 and i < arr.size()
        Candle c = arr.get(i)
        float lvl = bull ? c.l : c.h
        for k = 0 to i - 1
            Candle nw = arr.get(k)
            inv := inv or (bull ? nw.l < lvl : nw.h > lvl)
    inv

PanelBodyColor(array<Candle> arr, int i) =>
    Candle c = arr.get(i)
    c.c > c.o ? settings.bull_body : settings.bear_body

// Positions for a preview panel (oldest left, newest right)
PanelPositions(array<Candle> arr, int x_start) =>
    int n = arr.size()
    int step = settings.width + 1
    if n > 0
        for i = n - 1 to 0
            Candle c = arr.get(i)
            c.candle_left := x_start + step * (n - 1 - i)
            c.candle_right := c.candle_left + settings.width
            c.wick_x := c.candle_left + int(settings.width / 2)
    0

// FVG between C1 and C3 of consecutive, adjacent panel candles (drawn before the candles)
DrawPanelFvgs(array<Candle> arr, string tf) =>
    int n = arr.size()
    if htf_fvg_show and n > 2
        int tf_s = QTU.htfSeconds(normTf(tf))
        int tf_ms = na(tf_s) ? na : tf_s * 1000
        for i = 0 to n - 3
            Candle c3 = arr.get(i)
            Candle c2 = arr.get(i + 1)
            Candle c1 = arr.get(i + 2)
            bool chrono = c1.o_idx < c2.o_idx and c2.o_idx < c3.o_idx
            bool adjacent = not na(c1.c_idx) and not na(c2.c_idx) and c2.o_idx - c1.c_idx <= 1 and c3.o_idx - c2.c_idx <= 1
            bool no_void = na(tf_ms) or (c2.o_time - c1.o_time <= tf_ms * 2 and c3.o_time - c2.o_time <= tf_ms * 2)
            bool valid = chrono and adjacent and no_void
            int fvg_right = i == 0 ? c3.candle_left : c3.candle_right
            if valid and c3.l > c1.h
                bin.boxes.push(box.new(c2.candle_right, c3.l, fvg_right, c1.h, color_transparent, 1, bgcolor = color.new(htf_bull_fvg_color, 90)))
            if valid and c3.h < c1.l
                bin.boxes.push(box.new(c2.candle_right, c1.l, fvg_right, c3.h, color_transparent, 1, bgcolor = color.new(htf_bear_fvg_color, 90)))
    0

// SMT lines between consecutive panel candles
DrawPanelSmtPsp(array<Candle> arr) =>
    int n = arr.size()
    if htf_smt_show and n >= 2
        for i = 0 to n - 2
            Candle c = arr.get(i)
            Candle pv = arr.get(i + 1)
            if line.all.size() < 490 and BiasOk(-1) and c.smt_bear and not PanelSmtInvalid(arr, i, false)
                bin.lines.push(line.new(pv.wick_x, pv.h, c.wick_x, c.h, xloc = xloc.bar_index, color = htf_smt_bear_color, style = line.style_solid, width = 1))
            if line.all.size() < 490 and BiasOk(1) and c.smt_bull and not PanelSmtInvalid(arr, i, true)
                bin.lines.push(line.new(pv.wick_x, pv.l, c.wick_x, c.l, xloc = xloc.bar_index, color = htf_smt_bull_color, style = line.style_solid, width = 1))
    0

// ============================================================================
// Drawing Methods (only called on barstate.islast)
// ============================================================================

method CalculatePositions(CandleSet candleSet, int offset) =>
    size = candleSet.candles.size()
    if size > 0
        for i = size - 1 to 0 by 1
            Candle candle = candleSet.candles.get(i)
            t_buffer = offset + (settings.width + 1) * (size - i - 1)
            candle.candle_left := bar_index + t_buffer
            candle.candle_right := bar_index + settings.width + t_buffer
            candle.wick_x := bar_index + settings.width / 2 + t_buffer
    candleSet

method DrawCandles(CandleSet candleSet) =>
    for [i, candle] in candleSet.candles
        bull = candle.c > candle.o
        bin.boxes.push(box.new(candle.candle_left, math.max(candle.o, candle.c), candle.candle_right, math.min(candle.o, candle.c), bull ? settings.bull_border : settings.bear_border, 1, bgcolor = PanelBodyColor(candleSet.candles, i)))
        bin.lines.push(line.new(candle.wick_x, candle.h, candle.wick_x, math.max(candle.o, candle.c), xloc = xloc.bar_index, color = bull ? settings.bull_wick : settings.bear_wick))
        bin.lines.push(line.new(candle.wick_x, math.min(candle.o, candle.c), candle.wick_x, candle.l, xloc = xloc.bar_index, color = bull ? settings.bull_wick : settings.bear_wick))
        if settings.daily_name and candle.dow != ''
            if settings.dow_position == 'Both' or settings.dow_position == 'Top'
                bin.labels.push(label.new(candle.wick_x, candle.h, candle.dow, color = color_transparent, textcolor = settings.dow_color, style = label.style_label_down, size = settings.dow_size))
            if settings.dow_position == 'Both' or settings.dow_position == 'Bottom'
                bin.labels.push(label.new(candle.wick_x, candle.l, candle.dow, color = color_transparent, textcolor = settings.dow_color, style = label.style_label_up, size = settings.dow_size))
    candleSet

method DrawVTHLLines(CandleSet candleSet) =>
    vt_line_style = LineStyle(candleSet.settings.vt_style)
    hl_line_style = LineStyle(candleSet.settings.hl_style)
    for [i, candle] in candleSet.candles
        if candleSet.settings.vt_show
            bin.lines.push(line.new(candle.o_time, candle.h, candle.o_time, candle.l, xloc = xloc.bar_time, extend = extend.both, color = candleSet.settings.vt_color, style = vt_line_style, width = candleSet.settings.vt_size))
        if candleSet.settings.hl_show and i != 0
            int hl_end_time = candle.c_time
            if hl_end_time > 0
                bin.lines.push(line.new(candle.o_time, candle.h, hl_end_time, candle.h, xloc = xloc.bar_time, color = candleSet.settings.hl_color, style = hl_line_style, width = candleSet.settings.hl_width))
                bin.lines.push(line.new(candle.o_time, candle.l, hl_end_time, candle.l, xloc = xloc.bar_time, color = candleSet.settings.hl_color, style = hl_line_style, width = candleSet.settings.hl_width))
    candleSet

method DrawLabels(CandleSet candleSet, int offset) =>
    size = candleSet.candles.size()
    if size > 0 and settings.htf_label_show
        top = CandleSetHigh(candleSet.candles, 0)
        bottom = CandleSetLow(candleSet.candles, top)
        left = bar_index + offset + (settings.width + 1) * (size - 1) / 2
        string lbl_text = '✦ ' + HTFName(candleSet.settings.htf)
        if settings.htf_timer_show
            lbl_text := lbl_text + '\n\n(' + RemainingTime(candleSet.settings.htf) + ')'
        if settings.label_position == 'Both' or settings.label_position == 'Top'
            bin.labels.push(label.new(left, top, lbl_text, color = color_transparent, textcolor = settings.htf_label_color, style = label.style_label_down, size = settings.htf_label_size))
        if settings.label_position == 'Both' or settings.label_position == 'Bottom'
            bin.labels.push(label.new(left, bottom, lbl_text, color = color_transparent, textcolor = settings.htf_label_color, style = label.style_label_up, size = settings.htf_label_size))
    candleSet

method DrawTrace(CandleSet candleSet, int offset) =>
    if settings.trace_show and candleSet.candles.size() > 0
        Candle candle = candleSet.candles.first()
        if bar_index - candle.o_idx < 5000
            bin.lines.push(line.new(candle.o_idx, candle.o, candle.candle_left, candle.o, color = settings.trace_o_color, style = LineStyle(settings.trace_o_style), width = settings.trace_o_size))
    candleSet

// ============================================================================
// HTF panel preview clusters (Profiler ladder)
// Built from chart bars — no request.security(). Preview only.
// ============================================================================

// Candle time text for a panel candle (same convention as the model candles)
PanelDow(string tf) =>
    int sec = timeframe.in_seconds(tf)
    string out = ''
    if sec < 86400
        out := str.format_time(time, 'HH:mm', 'America/New_York')
    else if sec == 86400
        out := DayofWeek(dayofweek(time_tradingday, 'America/New_York'))
    else if sec < timeframe.in_seconds('M')
        out := str.format_time(time, 'MMM d', 'America/New_York')
    else if sec < timeframe.in_seconds('3M')
        out := str.format_time(time, 'MMM', 'America/New_York')
    else if sec < timeframe.in_seconds('12M')
        int mo = month(time, 'America/New_York')
        out := mo <= 3 ? 'Q1' : mo <= 6 ? 'Q2' : mo <= 9 ? 'Q3' : 'Q4'
    else
        out := str.format_time(time, 'yyyy', 'America/New_York')
    out

CollectExtraCandle(array<Candle> arr, bool is_new, int max_count, string tf) =>
    if is_new or arr.size() == 0
        Candle c = Candle.new()
        c.o := open
        c.c := close
        c.h := high
        c.l := low
        c.o_time := time
        c.o_idx := bar_index
        c.c_idx := bar_index
        // Candle time label — same convention as the main HTF candles
        c.dow := PanelDow(tf)
        arr.unshift(c)
        while arr.size() > max_count
            arr.pop()
    else
        Candle c = arr.first()
        if high > c.h
            c.h := high
        if low < c.l
            c.l := low
        c.c := close
        c.c_idx := bar_index
    arr

// C1 → C2 sweeps on a preview panel (same lines as the model panel): C2 takes C1's high (low)
// and closes back below (above) it. Hidden once a newer candle trades beyond C2's extreme.
// The forming candle shows a live sweep only while 'Show live setup' is on.
DrawPanelSweeps(array<Candle> arr, int x_start) =>
    int n = arr.size()
    if settings.sweep_show and not settings.hide_setups and n >= 2
        int step = settings.width + 1
        string st = LineStyle(settings.sweep_style)
        for i = 0 to n - 2
            Candle c2 = arr.get(i)
            Candle c1 = arr.get(i + 1)
            bool bear = c2.h > c1.h and c2.c < c1.h
            bool bull = c2.l < c1.l and c2.c > c1.l
            bool allowed = i > 0 or settings.sweep_live
            if allowed and (bear or bull)
                bool bear_alive = bear
                bool bull_alive = bull
                if i > 0
                    for k = 0 to i - 1
                        Candle nw = arr.get(k)
                        bear_alive := bear_alive and not (nw.h > c2.h)
                        bull_alive := bull_alive and not (nw.l < c2.l)
                int c1_wick = x_start + step * (n - 1 - (i + 1)) + int(settings.width / 2)
                int c2_right = x_start + step * (n - 1 - i) + settings.width
                if bear_alive and (settings.bias == 'Neutral' or settings.bias == 'Bearish')
                    bin.lines.push(line.new(c1_wick, c1.h, c2_right, c1.h, xloc = xloc.bar_index, color = settings.sweep_color, style = st, width = settings.sweep_size))
                if bull_alive and (settings.bias == 'Neutral' or settings.bias == 'Bullish')
                    bin.lines.push(line.new(c1_wick, c1.l, c2_right, c1.l, xloc = xloc.bar_index, color = settings.sweep_color, style = st, width = settings.sweep_size))
    0

// Draws a cluster of extra candles starting at x_start (oldest left, newest right).
// Returns the bar index of the cluster's right edge.
DrawExtraCluster(array<Candle> arr, int x_start, string tf) =>
    int n = arr.size()
    int step = settings.width + 1
    float top = na
    float bot = na
    PanelPositions(arr, x_start)
    DrawPanelFvgs(arr, tf)
    for i = n - 1 to 0 by 1
        Candle candle = arr.get(i)
        bool bull = candle.c > candle.o
        bin.boxes.push(box.new(candle.candle_left, math.max(candle.o, candle.c), candle.candle_right, math.min(candle.o, candle.c), bull ? settings.bull_border : settings.bear_border, 1, bgcolor = PanelBodyColor(arr, i)))
        bin.lines.push(line.new(candle.wick_x, candle.h, candle.wick_x, math.max(candle.o, candle.c), xloc = xloc.bar_index, color = bull ? settings.bull_wick : settings.bear_wick))
        bin.lines.push(line.new(candle.wick_x, math.min(candle.o, candle.c), candle.wick_x, candle.l, xloc = xloc.bar_index, color = bull ? settings.bull_wick : settings.bear_wick))
        // Candle time / day label — follows 'Interval Value' in Label Settings (same as HTF1 candles)
        if settings.daily_name and candle.dow != ''
            if settings.dow_position == 'Both' or settings.dow_position == 'Top'
                bin.labels.push(label.new(candle.wick_x, candle.h, candle.dow, color = color_transparent, textcolor = settings.dow_color, style = label.style_label_down, size = settings.dow_size))
            if settings.dow_position == 'Both' or settings.dow_position == 'Bottom'
                bin.labels.push(label.new(candle.wick_x, candle.l, candle.dow, color = color_transparent, textcolor = settings.dow_color, style = label.style_label_up, size = settings.dow_size))
        top := na(top) ? candle.h : math.max(top, candle.h)
        bot := na(bot) ? candle.l : math.min(bot, candle.l)
    DrawPanelSweeps(arr, x_start)
    DrawPanelSmtPsp(arr)
    // Cluster label (TF name + remaining time) — follows 'HTF Label' / 'Remaining Time'
    if settings.htf_label_show and n > 0
        int mid_x = x_start + int(step * (n - 1) / 2) + int(settings.width / 2)
        string lbl_text = PanelLabel(tf)
        if settings.htf_timer_show
            lbl_text := lbl_text + '\n\n(' + RemainingTime(tf) + ')'
        if settings.label_position == 'Both' or settings.label_position == 'Top'
            bin.labels.push(label.new(mid_x, top, lbl_text, color = color_transparent, textcolor = settings.htf_label_color, style = label.style_label_down, size = settings.htf_label_size))
        if settings.label_position == 'Both' or settings.label_position == 'Bottom'
            bin.labels.push(label.new(mid_x, bot, lbl_text, color = color_transparent, textcolor = settings.htf_label_color, style = label.style_label_up, size = settings.htf_label_size))
    x_start + step * (n - 1) + settings.width

// ============================================================================
// DrawSetups — confirmed + live
// ============================================================================

// Latest formation of the Fractal model (same pick as the model-panel C-labels)
LatestFormation(CandleSet candleSet) =>
    Setup best = na
    int best_idx = -1
    for setup in candleSet.setups
        bool bias_ok = settings.bias == 'Neutral' or (settings.bias == 'Bullish' and setup.is_bullish) or (settings.bias == 'Bearish' and not setup.is_bullish)
        if setup.is_confirmed and not setup.is_invalid and bias_ok and setup.htf_candle_idx > best_idx
            best := setup
            best_idx := setup.htf_candle_idx
    for is_bull in array.from(false, true)
        bool has_live = is_bull ? candleSet.has_live_bullish : candleSet.has_live_bearish
        if has_live
            Setup lv = is_bull ? candleSet.live_bullish : candleSet.live_bearish
            bool bias_ok = settings.bias == 'Neutral' or (settings.bias == 'Bullish' and is_bull) or (settings.bias == 'Bearish' and not is_bull)
            if bias_ok and lv.is_post_c2 and lv.cisd_triggered and not lv.is_invalid and lv.htf_candle_idx > best_idx
                best := lv
                best_idx := lv.htf_candle_idx
    best

method DrawSetups(CandleSet candleSet) =>
    // Chart C-labels: latest formation only (input), so older setups don't stack extra C2 / C3 / C4
    Setup lbl_best = c_lbl_latest_input ? LatestFormation(candleSet) : na
    int lbl_idx = na(lbl_best) ? -1 : lbl_best.htf_candle_idx
    bool lbl_bull = na(lbl_best) ? false : lbl_best.is_bullish
    sweep_line_style = LineStyle(settings.sweep_style)
    cisd_line_style = LineStyle(settings.cisd_style)
    array<Setup> dr = array.new<Setup>()
    if candleSet.setups.size() > 0
        int non_visible_count = 0
        int total_count = 0
        for [i, setup] in candleSet.setups
            if not setup.is_confirmed
                continue
            bool bias_ok = settings.bias == 'Neutral' or (settings.bias == 'Bullish' and setup.is_bullish) or (settings.bias == 'Bearish' and not setup.is_bullish)
            if not bias_ok
                continue
            bool is_visible = false
            for [j, candle] in candleSet.candles
                if candle.o_idx == setup.htf_candle_idx
                    is_visible := true
                    break
            bool should_draw = false
            if settings.sweep_visible_only
                if is_visible
                    should_draw := true
                else if non_visible_count < settings.sweep_history
                    should_draw := true
                    non_visible_count := non_visible_count + 1
            else
                if total_count < settings.sweep_history
                    should_draw := true
                    total_count := total_count + 1
            if should_draw
                dr.push(setup)
    // live setups (drawn after the historical ones)
    int nh = dr.size()
    for is_bull in array.from(false, true)
        bool bias_ok = settings.bias == 'Neutral' or (settings.bias == 'Bullish' and is_bull) or (settings.bias == 'Bearish' and not is_bull)
        if not bias_ok
            continue
        bool has_live = is_bull ? candleSet.has_live_bullish : candleSet.has_live_bearish
        if not has_live
            continue
        setup = is_bull ? candleSet.live_bullish : candleSet.live_bearish
        if settings.sweep_live
            if not (setup.is_confirmed or setup.is_post_c2)
                continue
        else
            if not (setup.is_post_c2 and setup.cisd_triggered)
                continue
        dr.push(setup)
    // one drawing pass: historical setups first, then the live ones
    for [di, setup] in dr
        bool live = di >= nh
        if not setup.is_invalid and settings.proj_show and setup.cisd_triggered and not na(setup.proj_anchor_1) and not na(setup.proj_anchor_0)
            proj_label_sz = LabelSize(settings.proj_label_size)
            float proj_range = setup.proj_anchor_1 - setup.proj_anchor_0
            for dv = 0 to proj_deviations.size() - 1
                dev = proj_deviations.get(dv)
                float price = na
                if setup.is_bullish
                    price := setup.proj_anchor_0 - (math.abs(proj_range) * dev)
                else
                    price := setup.proj_anchor_0 + (proj_range * dev)
                bin.labels.push(label.new(setup.proj_start_idx, price, str.tostring(dev), color = color_transparent, textcolor = settings.proj_color, style = label.style_label_right, size = proj_label_sz))
        if settings.show_c2_lbl and c_lbl_chart and (not c_lbl_latest_input or (setup.htf_candle_idx == lbl_idx and setup.is_bullish == lbl_bull)) and (not live or (setup.is_post_c2 and setup.cisd_triggered))
            lbl_style = setup.is_bullish ? label.style_label_up : label.style_label_down
            string lbl_text = setup.is_invalid ? "xC2" : "C2" + PspTag(candleSet.candles, FindCandleIndex(candleSet.candles, setup.htf_candle_idx))
            color lbl_color = setup.is_invalid ? color.red : settings.c2_color
            bin.labels.push(label.new(setup.c2_x, setup.c2_y, lbl_text, color = color_transparent, textcolor = lbl_color, style = lbl_style, size = settings.c2_size))
        if not setup.is_invalid and settings.sweep_show
            bin.lines.push(line.new(setup.sweep_ltf_idx, setup.sweep_price, live and not setup.is_post_c2 ? bar_index : setup.ltf_end_idx, setup.sweep_price, color = settings.sweep_color, style = sweep_line_style, width = settings.sweep_size))
        if not setup.is_invalid and settings.model_on_panel
            int htf_x1 = na
            int htf_x2 = na
            for [k, candle] in candleSet.candles
                if candle.o_idx == setup.swept_candle_idx
                    htf_x1 := candle.wick_x
                if candle.o_idx == setup.htf_candle_idx
                    htf_x2 := candle.candle_right
            if not na(htf_x1) and not na(htf_x2)
                if settings.sweep_show
                    bin.lines.push(line.new(htf_x1, setup.sweep_price, htf_x2, setup.sweep_price, color = settings.sweep_color, style = sweep_line_style, width = settings.sweep_size))
        if live and not setup.is_invalid and settings.early_cisd_show and setup.has_cisd and not setup.cisd_triggered
            early_cisd_line_style = LineStyle(settings.early_cisd_style)
            int early_end = na(setup.cisd_end_idx) ? bar_index : setup.cisd_end_idx
            bin.lines.push(line.new(setup.cisd_start_idx, setup.cisd_level, early_end, setup.cisd_level, color = settings.early_cisd_color, style = early_cisd_line_style, width = settings.cisd_width))
            if settings.show_c2_lbl
                lbl_style_early = setup.is_bullish ? label.style_label_up : label.style_label_down
                bin.labels.push(label.new(early_end, setup.cisd_level, setup.is_bullish ? '+CISD' : '-CISD', color = color_transparent, textcolor = settings.early_cisd_color, style = lbl_style_early, size = settings.c2_size))
        if settings.cisd_show and setup.cisd_triggered and setup.has_cisd
            cisd_color = setup.is_bullish ? settings.cisd_bull_color : settings.cisd_bear_color
            bin.lines.push(line.new(setup.cisd_start_idx, setup.cisd_level, setup.cisd_end_idx + 1, setup.cisd_level, color = cisd_color, style = cisd_line_style, width = settings.cisd_width))
        if not setup.is_invalid and setup.is_confirmed and ShowChartEQ()
            eq_line_style = LineStyle(prev_eq_style)
            if not na(setup.c2_mid) and not na(setup.ez_c3_left_time)
                int eq3_right = EntryZoneRight(setup.ez_c3_right_time)
                if eq3_right > setup.ez_c3_left_time
                    bin.lines.push(line.new(setup.ez_c3_left_time, setup.c2_mid, eq3_right, setup.c2_mid, xloc = xloc.bar_time, color = prev_eq_color, style = eq_line_style, width = prev_eq_width))
            if not na(setup.c3_mid) and not na(setup.ez_c4_left_time)
                int eq4_right = setup.ez_c4_invalid and not na(setup.ez_c4_invalid_time) ? setup.ez_c4_invalid_time : EntryZoneRight(setup.ez_c4_right_time)
                color eq4_col = setup.ez_c4_invalid ? color.red : prev_eq_color
                if eq4_right > setup.ez_c4_left_time
                    bin.lines.push(line.new(setup.ez_c4_left_time, setup.c3_mid, eq4_right, setup.c3_mid, xloc = xloc.bar_time, color = eq4_col, style = eq_line_style, width = prev_eq_width))
        if not setup.is_invalid and setup.is_confirmed and ShowHtfEQ() and settings.model_on_panel
            int c2_i = FindCandleIndex(candleSet.candles, setup.htf_candle_idx)
            eq_htf_style = LineStyle(prev_eq_style)
            if not na(setup.c2_mid) and c2_i > 0
                Candle c2_proj = candleSet.candles.get(c2_i)
                Candle c3_proj = candleSet.candles.get(c2_i - 1)
                int htf_eq3_x1 = c2_proj.wick_x
                int htf_eq3_x2 = c3_proj.candle_right + 2
                if htf_eq3_x2 > htf_eq3_x1
                    bin.lines.push(line.new(htf_eq3_x1, setup.c2_mid, htf_eq3_x2, setup.c2_mid, color = prev_eq_color, style = eq_htf_style, width = prev_eq_width))
            if not na(setup.c3_mid) and c2_i > 1
                Candle c3_proj4 = candleSet.candles.get(c2_i - 1)
                Candle c4_proj = candleSet.candles.get(c2_i - 2)
                int htf_eq4_x1 = c3_proj4.wick_x
                int htf_eq4_x2 = c4_proj.candle_right + 2
                color htf_eq4_col = setup.ez_c4_invalid ? color.red : prev_eq_color
                if htf_eq4_x2 > htf_eq4_x1
                    bin.lines.push(line.new(htf_eq4_x1, setup.c3_mid, htf_eq4_x2, setup.c3_mid, color = htf_eq4_col, style = eq_htf_style, width = prev_eq_width))
        if not setup.is_invalid and settings.entry_zone_show and (not c_lbl_latest_input or (setup.htf_candle_idx == lbl_idx and setup.is_bullish == lbl_bull)) and setup.ez_c3_set and not na(setup.ez_c3_left_time)
            color ez_col = setup.is_bullish ? settings.entry_zone_bull_color : settings.entry_zone_bear_color
            int ez_right = EntryZoneRight(setup.ez_c3_right_time)
            bin.boxes.push(box.new(setup.ez_c3_left_time, setup.ez_c3_top, ez_right, setup.ez_c3_bot, xloc = xloc.bar_time, bgcolor = ez_col, border_color = color_transparent, border_width = 0))
            if settings.show_c3_lbl and c_lbl_chart and (not c_lbl_latest_input or (setup.htf_candle_idx == lbl_idx and setup.is_bullish == lbl_bull))
                float ez_lbl_y = setup.is_bullish ? setup.ez_c3_bot : setup.ez_c3_top
                int ez_lbl_x = setup.ez_c3_left_time + timeframe.in_seconds() * 1000
                lbl_style_ez = setup.is_bullish ? label.style_label_up : label.style_label_down
                bin.labels.push(label.new(ez_lbl_x, ez_lbl_y, "C3", xloc = xloc.bar_time, color = color_transparent, textcolor = settings.c2_color, style = lbl_style_ez, size = settings.c2_size))
        if not live and not setup.is_invalid and settings.entry_zone_show and (not c_lbl_latest_input or (setup.htf_candle_idx == lbl_idx and setup.is_bullish == lbl_bull)) and setup.ez_c4_set and not na(setup.ez_c4_left_time)
            color ez4_col = setup.is_bullish ? settings.entry_zone_bull_color : settings.entry_zone_bear_color
            int ez4_right = EntryZoneRight(setup.ez_c4_right_time)
            if not setup.ez_c4_invalid
                bin.boxes.push(box.new(setup.ez_c4_left_time, setup.ez_c4_top, ez4_right, setup.ez_c4_bot, xloc = xloc.bar_time, bgcolor = ez4_col, border_color = color_transparent, border_width = 0))
            if settings.show_c4_lbl and c_lbl_chart and (not c_lbl_latest_input or (setup.htf_candle_idx == lbl_idx and setup.is_bullish == lbl_bull))
                float ez4_lbl_y = setup.is_bullish ? setup.ez_c4_bot : setup.ez_c4_top
                int ez4_lbl_x = setup.ez_c4_left_time + timeframe.in_seconds() * 1000
                string ez4_txt = setup.ez_c4_invalid ? "xC4" : "C4"
                color ez4_lbl_col = setup.ez_c4_invalid ? color.red : settings.c2_color
                lbl_style_ez4 = setup.is_bullish ? label.style_label_up : label.style_label_down
                bin.labels.push(label.new(ez4_lbl_x, ez4_lbl_y, ez4_txt, xloc = xloc.bar_time, color = color_transparent, textcolor = ez4_lbl_col, style = lbl_style_ez4, size = settings.c2_size))
// IC-CISD — drawn from the persistent registry (dots survive setup history limits)
DrawICCisd() =>
    if settings.ic_cisd_show and ic_registry.size() > 0
        ic_line_style = LineStyle(settings.cisd_style)
        for ic in ic_registry
            bool ic_bias_ok = settings.bias == 'Neutral' or (settings.bias == 'Bullish' and ic.is_bull) or (settings.bias == 'Bearish' and not ic.is_bull)
            if ic.visible and not ic.removed and ic_bias_ok
                color ic_col = ic.taken ? color.gray : (ic.is_bull ? settings.cisd_bull_color : settings.cisd_bear_color)
                if ic_line_show_input and not na(ic.level) and not na(ic.start_time) and not na(ic.end_time)
                    bin.lines.push(line.new(ic.start_time, ic.level, ic.end_time, ic.level, xloc = xloc.bar_time, color = ic_col, style = ic_line_style, width = settings.cisd_width))
                if not na(ic.extreme_price) and not na(ic.extreme_time)
                    bin.labels.push(label.new(ic.extreme_time, ic.extreme_price, "●", xloc = xloc.bar_time, color = color_transparent, textcolor = ic_col, style = ic.is_bull ? label.style_label_up : label.style_label_down, size = settings.ic_dot_size))
    0

// Panel C-labels (Profiler style): latest formation only — C1 swept candle, C2, C3, C4
PanelCLabel(Candle c, string txt, bool bull, color col) =>
    bool dow_same_side = settings.daily_name and c.dow != '' and (settings.dow_position == 'Both' or (bull ? settings.dow_position == 'Bottom' : settings.dow_position == 'Top'))
    float pad = math.max(math.abs(c.h - c.l) * 0.012, syminfo.mintick * 3)
    bin.labels.push(label.new(c.wick_x, bull ? c.l - pad : c.h + pad, dow_same_side ? (bull ? '\n' + txt : txt + '\n') : txt, color = color_transparent, textcolor = col, style = bull ? label.style_label_up : label.style_label_down, size = settings.c2_size, text_font_family = font.family_monospace))

// C1–C4 labels around the C2 at index best of a panel (C1 = the candle before it); dot = the table's
// confirmed C2 → a green ● right after its text (no-break spaces keep the padding, monospace)
PanelCLabelsAt(array<Candle> arr, int best, bool bull, bool dot) =>
    if best >= 0
        for j = 1 to -2
            int idx = best + j
            if idx >= 0 and idx < arr.size() and (j >= 0 ? settings.show_c2_lbl : j == -1 ? settings.show_c3_lbl : settings.show_c4_lbl)
                string t = j == 1 ? 'C1' : j == 0 ? 'C2' + PspTag(arr, best) : 'C' + str.tostring(2 - j)
                for k = 0 to (j == 0 and dot ? 1 : 0)
                    PanelCLabel(arr.get(idx), k == 0 ? t : str.repeat(' ', str.length(t) + (pnl_dot_size == 'Large' ? 4 : 3)) + (pnl_dot_size == 'Small' ? '•' : pnl_dot_size == 'Large' ? '⬤' : '●'), bull, k == 0 ? settings.c2_color : pnl_dot_color)
    0

// C1–C4 labels on every HTF panel (model panel included): the latest C1 → C2 sweep that is still
// standing, forming C2 included (live sweep) — same rule as the panel sweep lines. Uses the C2 / C3 / C4
// toggles, label color / size and 'C-Labels On' (Panel / Both); on = 'C1–C4 on Other Panels' for the
// panels that do not host the model.
var array<int> NO_HIST = array.new<int>()
// hist: confirmed C2s (open time, + bull / - bear), hMs = their candle length → the ● dot on a labelled C2
DrawPanelCLabelsPreview(array<Candle> arr, bool on, array<int> hist, int hMs, bool fBull, int force) =>
    int n = arr.size()
    if c_lbl_panel and on and not settings.hide_setups and n >= 2
        int best = force
        bool best_bull = fBull
        if force < 0
            for i = 0 to n - 2
                Candle c2 = arr.get(i)
                Candle c1 = arr.get(i + 1)
                bool bear = c2.h > c1.h and c2.c < c1.h and (settings.bias == 'Neutral' or settings.bias == 'Bearish')
                bool bull = c2.l < c1.l and c2.c > c1.l and (settings.bias == 'Neutral' or settings.bias == 'Bullish')
                if i > 0
                    for k = 0 to i - 1
                        Candle nw = arr.get(k)
                        bear := bear and not (nw.h > c2.h)
                        bull := bull and not (nw.l < c2.l)
                if (i > 0 or settings.sweep_live) and (bear or bull)
                    best := i
                    best_bull := bull and bear ? c2.c > c2.o : bull
                    break
        bool dot = false
        if best >= 0
            int ot = arr.get(best).o_time
            for t in hist
                dot := dot or (math.abs(t) <= ot and ot < math.abs(t) + hMs and (t > 0) == best_bull)
        PanelCLabelsAt(arr, best, best_bull, dot)
    0

// Draws the Fractal model's candles as a panel starting at bar x. Returns the panel's right edge.
method DrawModelPanel(CandleSet candleSet, int x) =>
    int rel = x - bar_index
    candleSet.CalculatePositions(rel)
    DrawPanelFvgs(candleSet.candles, candleSet.settings.htf)
    candleSet.DrawCandles()
    DrawPanelSmtPsp(candleSet.candles)
    candleSet.DrawLabels(rel)
    candleSet.DrawTrace(rel)
    x + (settings.width + 1) * (math.max(candleSet.candles.size(), 1) - 1) + settings.width

// ============================================================================
// Main Execution
// ============================================================================


bool isNewHTFCandle = ta.change(time(htf.settings.htf)) > 0

bool should_run_monitor = isNewHTFCandle or not calculate_on_close or barstate.isconfirmed

bool valid_htf = ValidTimeframe(htf.settings.htf)

// ============================================================================
// Main Execution — HTF Data Collection + Drawing
// ============================================================================

int offset = settings.offset
// Runtime window (Profiler approach): model + IC-CISD only run on the recent bars
bool model_runtime = htfRuntimeOn(model_tf, htf.settings.max_display + settings.sweep_history)
// Check every persistent IC dot against this bar BEFORE new dots can form on it
if settings.ic_cisd_show and model_runtime
    ICMarkTakenAll()
if valid_htf and model_runtime
    if should_run_monitor
        htf.Monitor(isNewHTFCandle)
    htf.Update()

// ============================================================================
// SMT Engine — GXV SMT (HTF Profiler port)
// ----------------------------------------------------------------------------
// DATA -> RANGE -> SWEEP -> DIVERGENCE -> EVENT -> INVALIDATION -> PROJECTION
// 13 families (15m … 12M). Each family compares the current range with the previous
// range of the chart symbol and each pair; an SMT is live while the range develops and
// confirmed at rollover; a line whose path crosses a candle body is filtered (not 12M).
// Data: 2 chart-timeframe requests (one per pair): high, low, time, open, close.
// ============================================================================

tf_sec = chart_sec

// Bias filter (General → Bias) replaces the Profiler bias engine
f_bias_ssmt(int _dir) =>
    settings.bias == 'Neutral' or (_dir == 1 and settings.bias == 'Bullish') or (_dir == -1 and settings.bias == 'Bearish')

f_is_mid_prefix(string px) =>
    px == "CAPITALCOM" or px == "CMCMARKETS"

f_is_chicago_prefix(string px) =>
    px == "CME" or px == "CBOT" or px == "CBOT_MINI" or px == "CBOT_DL" or px == "CME_MINI" or px == "CME_DL" or px == "CME_MINI_DL" or px == "COMEX" or px == "NYMEX"

f_is_utc_prefix(string px) =>
    px == "BINANCE" or px == "BYBIT" or px == "KRAKEN" or px == "GATE.IO" or px == "BITSTAMP" or px == "COINBASE" or px == "GEMINI"

f_oracle_tz(string px) =>
    f_is_chicago_prefix(px) ? "America/Chicago" : f_is_mid_prefix(px) ? "Etc/GMT+5" : f_is_utc_prefix(px) ? "UTC" : "America/New_York"

px = syminfo.prefix
oracle_tz = f_oracle_tz(px)

// Range keys per family (same source candles as the HTF panels)
val_ses15 = time('15')
val_ses30 = time('30')
val_ses90 = time('90')
val_ses60 = time('60')
val_ses240 = time('240')
val_sesD = time('360')
val_ses420 = time('420')
val_ses720 = time('720')
val_sesW = time('D')
val_sesM = time('W')
val_sesMT = time('M')
val_sesQ = time('3M')
val_sesY = time('12M')

// GXV chart-timeframe gates — hardcoded stable reconstruction-safe gates.
const int SMT_TF_SEC_1 = 60
const int SMT_TF_SEC_3 = 3 * SMT_TF_SEC_1
const int SMT_TF_SEC_5 = 5 * SMT_TF_SEC_1
const int SMT_TF_SEC_15 = 15 * SMT_TF_SEC_1
const int SMT_TF_SEC_30 = 30 * SMT_TF_SEC_1
const int SMT_TF_SEC_60 = 60 * SMT_TF_SEC_1
const int SMT_TF_SEC_240 = 240 * SMT_TF_SEC_1
const int SMT_TF_SEC_360 = 360 * SMT_TF_SEC_1
const int SMT_TF_SEC_D = 24 * 60 * 60
const int SMT_TF_SEC_M = 30 * SMT_TF_SEC_D

SMT_GATE_15M = SMT_TF_SEC_5
SMT_GATE_30M = SMT_TF_SEC_5
SMT_GATE_90M = SMT_TF_SEC_15
SMT_GATE_1H = SMT_TF_SEC_15
SMT_GATE_4H = SMT_TF_SEC_60
SMT_GATE_6H = SMT_TF_SEC_60
SMT_GATE_7H = SMT_TF_SEC_60
SMT_GATE_12H = SMT_TF_SEC_240
SMT_GATE_1D = SMT_TF_SEC_240
SMT_GATE_1W = SMT_TF_SEC_360
SMT_GATE_1M = SMT_TF_SEC_360
SMT_GATE_3M = SMT_TF_SEC_D
SMT_GATE_12M = SMT_TF_SEC_M
tf_ok_15m = tf_sec <= SMT_GATE_15M
tf_ok_30m = tf_sec <= SMT_GATE_30M
tf_ok_90m = tf_sec <= SMT_GATE_90M
tf_ok_1h = tf_sec <= SMT_GATE_1H
tf_ok_4h = tf_sec <= SMT_GATE_4H
tf_ok_6h = tf_sec <= SMT_GATE_6H
tf_ok_7h = tf_sec <= SMT_GATE_7H
tf_ok_12h = tf_sec <= SMT_GATE_12H
tf_ok_1d = tf_sec <= SMT_GATE_1D
tf_ok_1w = tf_sec <= SMT_GATE_1W
tf_ok_1m = tf_sec <= SMT_GATE_1M
tf_ok_3m = tf_sec <= SMT_GATE_3M
tf_ok_12m = tf_sec <= SMT_GATE_12M

// Monthly SMT minimum chart-timeframe render policy.
// Display authority only: existing SMT compute gates and lifecycle state remain unchanged.
f_smt_monthly_tf_render_ok(int rank) =>
    bool isMonthlyRank = rank == 11 or rank == 12 or rank == 13
    int minTfSec = smt_monthly_min_tf == "1 Hour" ? SMT_TF_SEC_60 : smt_monthly_min_tf == "4 Hour" ? SMT_TF_SEC_240 : smt_monthly_min_tf == "1 Day" ? SMT_TF_SEC_D : 0
    not isMonthlyRank or minTfSec == 0 or tf_sec >= minTfSec

// GXV AssetCorrelationUtils bridge (2 pairs)
type SmtCorrelationDescriptor
    string symbol
    string displayName
    bool inverse
    bool configured
    bool dataReady
    float sourceHigh
    float sourceLow
    int sourceTime

//==============================================================================
const string SMT_INVALID_SECONDARY = "__GXV_SMT_INVALID_SECONDARY__"
const string SMT_INVALID_TERTIARY = "__GXV_SMT_INVALID_TERTIARY__"

f_has_symbol(string s) =>
    str.length(s) > 0

f_asset_token(string s) =>
    array<string> parts = str.split(s, ":")
    array.size(parts) > 1 ? array.get(parts, 1) : s

f_same_symbol(string a, string b) =>
    str.upper(a) == str.upper(b) or str.upper(f_asset_token(a)) == str.upper(f_asset_token(b))

string csym = ""
string tsym3 = ""
bool corr_base_ok = false
bool corr_has_tertiary = false
bool corr_pair1_ok = false
bool corr_pair2_ok = false
bool corr_pair1_configured = false
bool corr_pair2_configured = false
bool corr_inv1 = false
bool corr_inv2 = false
bool corr_type_pair2 = smt_correlation_type != "Dyad"
AC.AssetConfig corr_cfg = AC.resolveAssetsByCorrelation(syminfo.ticker, syminfo.tickerid, syminfo.type, syminfo.session, false, smt_correlation_mode, smt_correlation_type)
corr_base_ok := corr_cfg.detected and f_has_symbol(corr_cfg.secondary) and not f_same_symbol(corr_cfg.secondary, syminfo.tickerid)
corr_has_tertiary := corr_type_pair2 and corr_base_ok and f_has_symbol(corr_cfg.tertiary) and not f_same_symbol(corr_cfg.tertiary, syminfo.tickerid) and not f_same_symbol(corr_cfg.secondary, corr_cfg.tertiary)
csym := corr_base_ok ? corr_cfg.secondary : ""
tsym3 := corr_has_tertiary ? corr_cfg.tertiary : ""
corr_inv1 := corr_base_ok ? corr_cfg.invertSecondary : false
corr_inv2 := corr_has_tertiary ? corr_cfg.invertTertiary : false
// Pairing override (Classic mode): MNQ futures pair with MES and NQ with ES (CME on TradingView, '/MNQ' / '/NQ'
// on NinjaTrader feeds, same prefix); the NAS100 CFDs of Capital.com, Pepperstone, FXCM and FOREXCOM track the
// same Nasdaq-100 price, so they pair with MES (pair 2 = MYM / YM when Correlation Type is Triad).
bool   nq_slash   = str.startswith(syminfo.ticker, "/")
string nq_root    = nq_slash ? str.substring(syminfo.ticker, 1) : syminfo.root
bool   nq_fut     = nq_slash or str.startswith(syminfo.prefix, "CME")
string nq_px      = str.length(syminfo.prefix) > 0 ? syminfo.prefix + ":" : ""
bool nq_mes_cfd = syminfo.ticker == "NAS100" and (syminfo.prefix == "CAPITALCOM" or syminfo.prefix == "PEPPERSTONE" or syminfo.prefix == "FXCM" or syminfo.prefix == "FOREXCOM")
bool nq_mes_fut = nq_fut and nq_root == "MNQ"
bool nq_es_fut  = nq_fut and nq_root == "NQ"
if nq_mes_cfd or nq_mes_fut or nq_es_fut
    corr_base_ok := true
    csym := nq_slash ? nq_px + (nq_es_fut ? "/ES" : "/MES") : nq_es_fut ? "CME_MINI:ES1!" : "CME_MINI:MES1!"
    corr_inv1 := false
    corr_has_tertiary := corr_type_pair2
    tsym3 := not corr_has_tertiary ? "" : nq_slash ? nq_px + (nq_es_fut ? "/YM" : "/MYM") : nq_es_fut ? "CBOT_MINI:YM1!" : "CBOT_MINI:MYM1!"
    corr_inv2 := false
// MES chart: pair with MNQ1! (CME) and/or the NAS100 CFD of the chosen broker (SMT: Asset Pair Resolver)
bool mes_chart = syminfo.root == "MES" and str.startswith(syminfo.prefix, "CME")
if mes_chart and (mes_pair_mnq_input or mes_pair_nas_input)
    string mes_nas_sym = mes_pair_nas_broker_input + ":NAS100"
    corr_base_ok := true
    csym := mes_pair_mnq_input ? "CME_MINI:MNQ1!" : mes_nas_sym
    corr_inv1 := false
    corr_has_tertiary := mes_pair_mnq_input and mes_pair_nas_input
    tsym3 := corr_has_tertiary ? mes_nas_sym : ""
    corr_inv2 := false
// Manual legs use the same downstream feeds/ownership as AUTO; blank symbols never request the chart implicitly.
if manualCorrelation
    corr_base_ok := manualPair1On and f_has_symbol(manualPair1) and not f_same_symbol(manualPair1, syminfo.tickerid)
    corr_has_tertiary := manualPair2On and f_has_symbol(manualPair2) and not f_same_symbol(manualPair2, syminfo.tickerid) and (not corr_base_ok or not f_same_symbol(manualPair2, manualPair1))
    csym := corr_base_ok ? manualPair1 : ""
    tsym3 := corr_has_tertiary ? manualPair2 : ""
    corr_inv1 := corr_base_ok and manualPair1Inverse
    corr_inv2 := corr_has_tertiary and manualPair2Inverse
corr_pair1_configured := corr_base_ok and f_has_symbol(csym)
corr_pair2_configured := corr_has_tertiary and f_has_symbol(tsym3)
string corr_fetch_sym1 = corr_pair1_configured ? csym : SMT_INVALID_SECONDARY
string corr_fetch_sym2 = corr_pair2_configured ? tsym3 : SMT_INVALID_TERTIARY
[xh0, xl0, xt0, xo0, xc0] = request.security(corr_fetch_sym1, timeframe.period, [high, low, time, open, close], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[yh0, yl0, yt0, yo0, yc0] = request.security(corr_fetch_sym2, timeframe.period, [high, low, time, open, close], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
corr_pair1_ok := corr_pair1_configured and not na(xh0) and not na(xl0) and not na(xt0)
corr_pair2_ok := corr_pair2_configured and not na(yh0) and not na(yl0) and not na(yt0)
string smt_pair = corr_pair1_configured ? AC.getAssetTicker(csym) : ""
string smt_pair2 = corr_pair2_configured ? AC.getAssetTicker(tsym3) : ""
SmtCorrelationDescriptor smt_corr_pair1 = SmtCorrelationDescriptor.new(csym, smt_pair, corr_inv1, corr_pair1_configured, corr_pair1_ok, xh0, xl0, xt0)
SmtCorrelationDescriptor smt_corr_pair2 = SmtCorrelationDescriptor.new(tsym3, smt_pair2, corr_inv2, corr_pair2_configured, corr_pair2_ok, yh0, yl0, yt0)


const int SMT_STATE_CYCLES = 13
const int SMT_SRC_COUNT = 3
const int SMT_PAIR_COUNT = 2
const int SMT_SRC_MAIN = 0
const int SMT_SRC_PAIR1 = 1
const int SMT_SRC_PAIR2 = 2
const int SMT_DIR_BEAR = -1
const int SMT_DIR_BULL = 1
const int SMT_EVENT_LIVE = 1
const int SMT_EVENT_CONFIRMED = 2
const int SMT_EVENT_INVALIDATED = 3
const int SMT_LIVE_SLOTS = SMT_STATE_CYCLES * SMT_PAIR_COUNT * 2
const int SMT_DOMAIN_EVENT_CAP = 600
const int SMT_RENDER_EVENT_CAP = 480

type SmtRangeState
    float currentHigh
    float previousHigh
    float currentLow
    float previousLow
    int currentHighTime
    int previousHighTime
    int currentLowTime
    int previousLowTime
    int currentHighBar
    int previousHighBar
    int currentLowBar
    int previousLowBar
    int cycleKey
    int previousCycleKey
    bool hasCurrentRange
    bool hasPreviousRange
    int version = 0          // bumps whenever anything the SMT check reads changes (opt. 1)

type SmtSweepState
    bool ready
    bool highSwept
    bool lowSwept
    float highPivotA
    float highPivotB
    float lowPivotA
    float lowPivotB
    int highTimeA
    int highTimeB
    int lowTimeA
    int lowTimeB
    int highBarA
    int highBarB
    int lowBarA
    int lowBarB

type SmtEvent
    int id
    int rank
    int pairSlot
    int dir
    int cycleKey
    int previousCycleKey
    float pivotAPrice
    float pivotBPrice
    int pivotATime
    int pivotBTime
    int pivotABar
    int pivotBBar
    int structType
    int state
    bool bodyBlocked
    line lineId
    label labelId
    bool projectA
    bool projectB
    bool bypassed

type SmtLiveSlot
    bool active
    int eventId
    int cycleKey
    SmtEvent event           // direct link to the live SMT — no list search (opt. 4)

var array<SmtRangeState> smt_range_states = array.new<SmtRangeState>()
var array<SmtEvent> smt_events = array.new<SmtEvent>()
// Sequence score: time of the latest bullish [0] / bearish [1] SMT event detected
var array<int> seq_smt_mark = array.new<int>(2)
var array<SmtLiveSlot> smt_live_slots = array.new<SmtLiveSlot>()

f_smt_state_idx(int cycleIdx, int srcIdx) =>
    cycleIdx * SMT_SRC_COUNT + srcIdx

f_smt_live_slot(int rank, int pairSlot, int dir) =>
    (rank - 1) * SMT_PAIR_COUNT * 2 + (pairSlot - 1) * 2 + (dir == SMT_DIR_BULL ? 1 : 0)

f_smt_event_id(int rank, int pairSlot, int dir, int cycleKey) =>
    cycleKey * 100 + f_smt_live_slot(rank, pairSlot, dir)

f_smt_seed_engine() =>
    if array.size(smt_range_states) == 0
        for i = 0 to SMT_STATE_CYCLES * SMT_SRC_COUNT - 1
            array.push(smt_range_states, SmtRangeState.new(na, na, na, na, na, na, na, na, na, na, na, na, na, na, false, false))
    if array.size(smt_live_slots) == 0
        for i = 0 to SMT_LIVE_SLOTS - 1
            array.push(smt_live_slots, SmtLiveSlot.new(false, na, na, na))
    0

// Auto SMT follows the Profiler Classic ladder (15m / 1H / 4H). 7H / 12H families remain manual.
profilerSmtMask = QTU.smtEnabledMaskFull(false, 'Classic Sequence', smt_15m_show, smt_30m_show, smt_90m_show, smt_1h_show, smt_4h_show, smt_6h_show, smt_7h_show, smt_12h_show, smt_1d_show, smt_1w_show, smt_1m_show, smt_3m_show, smt_12m_show)
f_smt_rank_enabled(int rank) =>
    bit = rank == 1 ? 1 : rank == 2 ? 2 : rank == 3 ? 8 : rank == 4 ? 4 : rank == 5 ? 16 : rank == 6 ? 32 : rank == 7 ? 2048 : rank == 8 ? 4096 : rank == 9 ? 64 : rank == 10 ? 128 : rank == 11 ? 256 : rank == 12 ? 512 : 1024
    auto_intraday = rank == 1 or rank == 3 or rank == 5
    smt_auto_effective and rank <= 8 ? auto_intraday : QTU.smtMaskHas(profilerSmtMask, bit)

f_smt_pair_enabled(int pairSlot) =>
    pairSlot == 1 ? smt_corr_pair1.configured : pairSlot == 2 ? smt_corr_pair2.configured : false

f_smt_rank_shortname(int rank) =>
    rank == 1 ? "15m" : rank == 2 ? "30m" : rank == 3 ? "1H" : rank == 4 ? "90m" : rank == 5 ? "4H" : rank == 6 ? "6H" : rank == 7 ? "7H" : rank == 8 ? "12H" : rank == 9 ? "1D" : rank == 10 ? "1W" : rank == 11 ? "1M" : rank == 12 ? "3M" : rank == 13 ? "12M" : ""

f_smt_rank_color(int rank) =>
    rank == 1 ? smt_15m_clr : rank == 2 ? smt_30m_clr : rank == 3 ? smt_1h_clr : rank == 4 ? smt_90m_clr : rank == 5 ? smt_4h_clr : rank == 6 ? smt_6h_clr : rank == 7 ? smt_7h_clr : rank == 8 ? smt_12h_clr : rank == 9 ? smt_1d_clr : rank == 10 ? smt_1w_clr : rank == 11 ? smt_1m_clr : rank == 12 ? smt_3m_clr : rank == 13 ? smt_12m_clr : color.gray

f_smt_rank_gate_sec(int rank) =>
    rank == 1 ? SMT_GATE_15M : rank == 2 ? SMT_GATE_30M : rank == 3 ? SMT_GATE_1H : rank == 4 ? SMT_GATE_90M : rank == 5 ? SMT_GATE_4H : rank == 6 ? SMT_GATE_6H : rank == 7 ? SMT_GATE_7H : rank == 8 ? SMT_GATE_12H : rank == 9 ? SMT_GATE_1D : rank == 10 ? SMT_GATE_1W : rank == 11 ? SMT_GATE_1M : rank == 12 ? SMT_GATE_3M : SMT_GATE_12M

f_smt_pair_name_for_slot(int pairSlot) =>
    pairSlot == 1 ? smt_corr_pair1.displayName : pairSlot == 2 ? smt_corr_pair2.displayName : ""

f_smt_label_text(string shortname, string pairName) =>
    QTU.smtStackedLabel(shortname, pairName)

f_smt_default_label_text(int rank, int pairSlot) =>
    f_smt_label_text(f_smt_rank_shortname(rank), f_smt_pair_name_for_slot(pairSlot))

f_smt_bypass_label_text(int rank, int pairSlot) =>
    f_smt_default_label_text(rank, pairSlot)

f_smt_labels_for_rank(int rank) =>
    bool dynamicExcluded = rank == 12 or rank == 13
    bool hideAtOrAboveGate = smt_dynamic_labels and not dynamicExcluded and tf_sec >= f_smt_rank_gate_sec(rank)
    smt_labels_show and not hideAtOrAboveGate

f_smt_event_label_y(int direction, float y1, float y2) =>
    QTU.smtLabelPrice(direction, y1, y2, syminfo.mintick)

f_smt_event_label_time(int x1, int x2, int b1, int b2) =>
    int labelBar = int(math.floor((b1 + b2) * 0.5))
    int labelOffset = bar_index - labelBar
    bool canUseMidBarTime = not na(labelBar) and labelOffset >= 0 and labelOffset <= 5000
    canUseMidBarTime ? time[labelOffset] : int(math.round(x1 + (x2 - x1) * 0.5))

f_smt_structure_type(bool isBull, float y1, float y2) =>
    isBull ? (y2 > y1 ? 1 : y2 < y1 ? 2 : 0) : (y2 > y1 ? 3 : y2 < y1 ? 4 : 0)

f_smt_struct_required_for_cleanup(int rank) =>
    rank == 11 or rank == 12 or rank == 13

f_smt_cleanup_struct_ok(int dominatedRank, int dominatedStruct, int dominantStruct) =>
    not f_smt_struct_required_for_cleanup(dominatedRank) or (dominatedStruct != 0 and dominatedStruct == dominantStruct)

f_smt_body_filter_applies(int rank) =>
    rank != 13

f_smt_body_intersects(int bx1, int bx2, float y1, float y2) =>
    bool hit = false
    int span = bx2 - bx1
    if span > 3
        int fromX = math.max(bx1 + 2, bar_index - 4999)
        int toX = math.min(bx2 - 2, bar_index)
        if fromX <= toX
            for x = fromX to toX
                int barsAgo = bar_index - x
                float linePrice = y1 + (y2 - y1) * (x - bx1) / span
                float bodyLow = math.min(open[barsAgo], close[barsAgo])
                float bodyHigh = math.max(open[barsAgo], close[barsAgo])
                if bodyLow <= linePrice and linePrice <= bodyHigh
                    hit := true
                    break
    hit

// Equality is not a liquidity take; strict extrema retain first-touch identity.
f_smt_high_swept(float currentValue, float previousValue) =>
    not na(currentValue) and not na(previousValue) and currentValue > previousValue

f_smt_low_swept(float currentValue, float previousValue) =>
    not na(currentValue) and not na(previousValue) and currentValue < previousValue

f_smt_update_state(int cycleIdx, int srcIdx, bool engineEnabled, int rangeKey, float srcHigh, float srcLow, int srcTime) =>
    if engineEnabled and not na(rangeKey)
        int idx = f_smt_state_idx(cycleIdx, srcIdx)
        SmtRangeState st = array.get(smt_range_states, idx)
        bool dataReady = not na(srcHigh) and not na(srcLow) and not na(srcTime)
        if na(st.cycleKey)
            st.cycleKey := rangeKey
            st.previousCycleKey := na
            st.hasCurrentRange := false
            st.hasPreviousRange := false
            st.version += 1
        else if rangeKey != st.cycleKey
            st.previousHigh := st.currentHigh
            st.previousLow := st.currentLow
            st.previousHighTime := st.currentHighTime
            st.previousLowTime := st.currentLowTime
            st.previousHighBar := st.currentHighBar
            st.previousLowBar := st.currentLowBar
            st.previousCycleKey := st.cycleKey
            st.hasPreviousRange := st.hasCurrentRange
            st.currentHigh := na
            st.currentLow := na
            st.currentHighTime := na
            st.currentLowTime := na
            st.currentHighBar := na
            st.currentLowBar := na
            st.hasCurrentRange := false
            st.cycleKey := rangeKey
            st.version += 1
        if dataReady and st.cycleKey == rangeKey
            if na(st.currentHigh) or srcHigh > st.currentHigh
                st.currentHigh := srcHigh
                st.currentHighTime := srcTime
                st.currentHighBar := bar_index
                st.version += 1
            if na(st.currentLow) or srcLow < st.currentLow
                st.currentLow := srcLow
                st.currentLowTime := srcTime
                st.currentLowBar := bar_index
                st.version += 1
            if not st.hasCurrentRange
                st.hasCurrentRange := true
                st.version += 1
    0

f_smt_get_state(int cycleIdx, int srcIdx) =>
    array.get(smt_range_states, f_smt_state_idx(cycleIdx, srcIdx))

// Inverse pairs are normalized once into main-domain high/low liquidity actions.
f_smt_build_sweeps(SmtRangeState st, bool inverse) =>
    bool ready = st.hasCurrentRange and st.hasPreviousRange
    float highA = inverse ? st.previousLow : st.previousHigh
    float highB = inverse ? st.currentLow : st.currentHigh
    float lowA = inverse ? st.previousHigh : st.previousLow
    float lowB = inverse ? st.currentHigh : st.currentLow
    int highTimeA = inverse ? st.previousLowTime : st.previousHighTime
    int highTimeB = inverse ? st.currentLowTime : st.currentHighTime
    int lowTimeA = inverse ? st.previousHighTime : st.previousLowTime
    int lowTimeB = inverse ? st.currentHighTime : st.currentLowTime
    int highBarA = inverse ? st.previousLowBar : st.previousHighBar
    int highBarB = inverse ? st.currentLowBar : st.currentHighBar
    int lowBarA = inverse ? st.previousHighBar : st.previousLowBar
    int lowBarB = inverse ? st.currentHighBar : st.currentLowBar
    bool highSweep = ready and (inverse ? f_smt_low_swept(highB, highA) : f_smt_high_swept(highB, highA))
    bool lowSweep = ready and (inverse ? f_smt_high_swept(lowB, lowA) : f_smt_low_swept(lowB, lowA))
    SmtSweepState.new(ready, highSweep, lowSweep, highA, highB, lowA, lowB, highTimeA, highTimeB, lowTimeA, lowTimeB, highBarA, highBarB, lowBarA, lowBarB)

f_smt_xor(bool first, bool second) =>
    (first and not second) or (not first and second)

// Pure divergence truth: exactly one synchronized market sweeps corresponding liquidity.
f_smt_resolve_pair_state(SmtSweepState mainSweep, SmtSweepState pairSweep) =>
    bool ready = mainSweep.ready and pairSweep.ready
    bool bearValid = ready and f_smt_xor(mainSweep.highSwept, pairSweep.highSwept)
    bool bullValid = ready and f_smt_xor(mainSweep.lowSwept, pairSweep.lowSwept)
    [bearValid, bullValid]
smt_current_day_filter_effective = smt_render_current_day_only and not na(tf_sec) and tf_sec < SMT_TF_SEC_240
smt_render_day_ref = last_bar_time
smt_render_day_start = timestamp(oracle_tz, year(smt_render_day_ref, oracle_tz), month(smt_render_day_ref, oracle_tz), dayofmonth(smt_render_day_ref, oracle_tz), 0, 0)
smt_render_day_end = timestamp(oracle_tz, year(smt_render_day_ref, oracle_tz), month(smt_render_day_ref, oracle_tz), dayofmonth(smt_render_day_ref, oracle_tz) + 1, 0, 0)
f_smt_current_day_render_ok(int pivotBTime) =>
    not smt_current_day_filter_effective or (not na(pivotBTime) and pivotBTime >= smt_render_day_start and pivotBTime < smt_render_day_end)

f_smt_render_time_ok(int pivotBTime) =>
    f_smt_current_day_render_ok(pivotBTime)

f_smt_nearby_render_ok(int pivotBBar) =>
    not smt_render_nearby_only or (not na(pivotBBar) and pivotBBar >= last_bar_index - smt_nearby_bars)

//==============================================================================
// Domain event lifecycle
//==============================================================================
f_smt_find_event_by_id(int eventId) =>
    int idx = -1
    int i = 0
    while i < array.size(smt_events) and idx < 0
        if array.get(smt_events, i).id == eventId
            idx := i
        i += 1
    idx

f_smt_drop_render_at(int idx) =>
    if idx >= 0 and idx < array.size(smt_events)
        SmtEvent event = array.get(smt_events, idx)
        if not na(event.labelId)
            label.delete(event.labelId)
            event.labelId := na
        if not na(event.lineId)
            line.delete(event.lineId)
            event.lineId := na
        array.set(smt_events, idx, event)
    0

f_smt_delete_event_at(int idx) =>
    bool deleted = false
    if idx >= 0 and idx < array.size(smt_events)
        f_smt_drop_render_at(idx)
        array.remove(smt_events, idx)
        deleted := true
    deleted

f_smt_release_live_slot(int slot) =>
    if slot >= 0 and slot < array.size(smt_live_slots)
        SmtLiveSlot live = array.get(smt_live_slots, slot)
        live.active := false
        live.eventId := na
        live.cycleKey := na
        live.event := na
    0

f_smt_remove_live_slot(int slot) =>
    if slot >= 0 and slot < array.size(smt_live_slots)
        SmtLiveSlot live = array.get(smt_live_slots, slot)
        if live.active and not na(live.eventId)
            int eventIdx = f_smt_find_event_by_id(live.eventId)
            if eventIdx >= 0
                f_smt_delete_event_at(eventIdx)
        f_smt_release_live_slot(slot)
    0

f_smt_finalize_live_slot(int slot, int currentCycle) =>
    bool finalized = false
    if slot >= 0 and slot < array.size(smt_live_slots)
        SmtLiveSlot live = array.get(smt_live_slots, slot)
        if live.active and not na(currentCycle) and not na(live.cycleKey) and currentCycle != live.cycleKey
            SmtEvent event = live.event
            if not na(event)
                if event.state == SMT_EVENT_LIVE
                    event.state := SMT_EVENT_CONFIRMED
                    event.projectA := false
                    event.projectB := false
                    event.bypassed := false
                    finalized := true
            f_smt_release_live_slot(slot)
    finalized

f_smt_sync_live_candidate(bool valid, int cycleKey, int previousCycleKey, int rank, int pairSlot, int dir, float y1, float y2, int t1, int t2, int b1, int b2) =>
    int slot = f_smt_live_slot(rank, pairSlot, dir)
    SmtLiveSlot live = array.get(smt_live_slots, slot)
    bool fieldsReady = not na(cycleKey) and not na(previousCycleKey) and not na(y1) and not na(y2) and not na(t1) and not na(t2) and not na(b1) and not na(b2)
    if live.active and (not valid or not fieldsReady or live.cycleKey != cycleKey)
        f_smt_remove_live_slot(slot)
        live := array.get(smt_live_slots, slot)
    if valid and fieldsReady
        int eventId = f_smt_event_id(rank, pairSlot, dir, cycleKey)
        SmtEvent current = live.active ? live.event : na
        if na(current)
            bool bodyBlocked = f_smt_body_filter_applies(rank) and f_smt_body_intersects(b1, b2, y1, y2)
            SmtEvent event = SmtEvent.new(eventId, rank, pairSlot, dir, cycleKey, previousCycleKey, y1, y2, t1, t2, b1, b2, f_smt_structure_type(dir == SMT_DIR_BULL, y1, y2), SMT_EVENT_LIVE, bodyBlocked, na, na, false, false, false)
            array.unshift(smt_events, event)
            seq_smt_mark.set(dir == SMT_DIR_BULL ? 0 : 1, time)
            live.active := true
            live.eventId := eventId
            live.cycleKey := cycleKey
            live.event := event
        else
            SmtEvent event = current
            bool pivotChanged = event.pivotAPrice != y1 or event.pivotBPrice != y2 or event.pivotATime != t1 or event.pivotBTime != t2 or event.pivotABar != b1 or event.pivotBBar != b2
            if pivotChanged
                event.pivotAPrice := y1
                event.pivotBPrice := y2
                event.pivotATime := t1
                event.pivotBTime := t2
                event.pivotABar := b1
                event.pivotBBar := b2
                event.structType := f_smt_structure_type(dir == SMT_DIR_BULL, y1, y2)
                event.bodyBlocked := f_smt_body_filter_applies(rank) and f_smt_body_intersects(b1, b2, y1, y2)
    0

f_smt_event_invalidated(SmtEvent event) =>
    // Match the pane's strict extreme breach: equality is a retest, not invalidation.
    event.state == SMT_EVENT_CONFIRMED and bar_index > event.pivotBBar and ((event.dir == SMT_DIR_BEAR and high > event.pivotBPrice) or (event.dir == SMT_DIR_BULL and low < event.pivotBPrice))

f_smt_mark_historical_invalidations() =>
    int n = array.size(smt_events)
    if n > 0
        for i = n - 1 to 0
            SmtEvent event = array.get(smt_events, i)
            if f_smt_event_invalidated(event)
                event.state := SMT_EVENT_INVALIDATED
                event.projectA := false
                event.projectB := false
                array.set(smt_events, i, event)
    0

f_smt_gc_events() =>
    int i = array.size(smt_events) - 1
    while i >= 0
        if array.get(smt_events, i).state == SMT_EVENT_INVALIDATED
            f_smt_delete_event_at(i)
        i -= 1
    while array.size(smt_events) > SMT_DOMAIN_EVENT_CAP
        int removeIdx = array.size(smt_events) - 1
        while removeIdx >= 0 and array.get(smt_events, removeIdx).state == SMT_EVENT_LIVE
            removeIdx -= 1
        if removeIdx >= 0
            f_smt_delete_event_at(removeIdx)
        else
            break
    0
//==============================================================================
// Deterministic render projection and arbitration
//==============================================================================
f_smt_event_base_render_ok(SmtEvent event) =>
    bool activeState = event.state == SMT_EVENT_LIVE or event.state == SMT_EVENT_CONFIRMED
    activeState and f_bias_ssmt(event.dir) and f_smt_rank_enabled(event.rank) and f_smt_pair_enabled(event.pairSlot) and f_smt_monthly_tf_render_ok(event.rank) and f_smt_nearby_render_ok(event.pivotBBar) and f_smt_render_time_ok(event.pivotBTime) and not event.bodyBlocked

f_smt_hard_winner(SmtEvent dominant, SmtEvent candidate) =>
    dominant.rank > candidate.rank or (dominant.rank == candidate.rank and dominant.pairSlot < candidate.pairSlot) or (dominant.rank == candidate.rank and dominant.pairSlot == candidate.pairSlot and dominant.id < candidate.id)

f_smt_hard_loses(int idx) =>
    bool loses = false
    SmtEvent candidate = array.get(smt_events, idx)
    int n = array.size(smt_events)
    if candidate.projectA and candidate.dir != 0 and not na(candidate.pivotATime) and not na(candidate.pivotBTime) and n > 1
        for i = 0 to n - 1
            if i != idx and not loses
                SmtEvent other = array.get(smt_events, i)
                bool sameEvent = other.projectA and other.dir == candidate.dir and other.pivotATime == candidate.pivotATime and other.pivotBTime == candidate.pivotBTime
                loses := sameEvent and f_smt_hard_winner(other, candidate)
    loses

f_smt_inside_dominates(SmtEvent keeper, SmtEvent candidate) =>
    int keepLeft = math.min(keeper.pivotABar, keeper.pivotBBar)
    int keepRight = math.max(keeper.pivotABar, keeper.pivotBBar)
    int candidateLeft = math.min(candidate.pivotABar, candidate.pivotBBar)
    int candidateRight = math.max(candidate.pivotABar, candidate.pivotBBar)
    int keepSpan = keepRight - keepLeft
    int candidateSpan = candidateRight - candidateLeft
    bool directionOk = keeper.dir != 0 and keeper.dir == candidate.dir
    bool structureOk = f_smt_cleanup_struct_ok(candidate.rank, candidate.structType, keeper.structType)
    bool priorityOk = keeper.rank > candidate.rank or (keeper.rank == candidate.rank and keepSpan > candidateSpan)
    candidateLeft >= keepLeft + 1 and candidateRight <= keepRight - 1 and keepSpan > candidateSpan and candidateSpan > 0 and keepSpan >= 3 and directionOk and structureOk and priorityOk

f_smt_inside_loses(int idx) =>
    bool loses = false
    SmtEvent candidate = array.get(smt_events, idx)
    int n = array.size(smt_events)
    if candidate.projectB and n > 1
        for i = 0 to n - 1
            if i != idx and not loses
                SmtEvent keeper = array.get(smt_events, i)
                loses := keeper.projectB and f_smt_inside_dominates(keeper, candidate)
    loses

f_smt_pivot_winner(SmtEvent dominant, SmtEvent candidate) =>
    dominant.rank > candidate.rank or (dominant.rank == candidate.rank and dominant.id < candidate.id)

f_smt_pivot_loses(int idx, bool checkPivotA) =>
    bool loses = false
    SmtEvent candidate = array.get(smt_events, idx)
    int n = array.size(smt_events)
    if candidate.projectA and candidate.dir != 0 and n > 1
        for i = 0 to n - 1
            if i != idx and not loses
                SmtEvent other = array.get(smt_events, i)
                bool samePivot = checkPivotA ? other.pivotATime == candidate.pivotATime : other.pivotBTime == candidate.pivotBTime
                bool directionOk = other.dir == candidate.dir
                bool structureOk = f_smt_cleanup_struct_ok(candidate.rank, candidate.structType, other.structType)
                loses := other.projectA and samePivot and directionOk and structureOk and f_smt_pivot_winner(other, candidate)
    loses

f_smt_prepare_projection() =>
    int n = array.size(smt_events)
    if n > 0
        for i = 0 to n - 1
            SmtEvent event = array.get(smt_events, i)
            bool baseEligible = f_smt_event_base_render_ok(event)
            event.projectA := baseEligible
            event.projectB := baseEligible
            event.bypassed := false
            array.set(smt_events, i, event)

        // Exact A-B arbitration is independent from optional cleanup modes.
        for i = 0 to n - 1
            SmtEvent event = array.get(smt_events, i)
            event.projectB := event.projectA and not f_smt_hard_loses(i)
            array.set(smt_events, i, event)

        bool insideBypassMode = smt_cleanup_mode == "Bypass Inside Range"
        bool evaluateInside = smt_cleanup_inside or insideBypassMode
        for i = 0 to n - 1
            SmtEvent event = array.get(smt_events, i)
            bool losesInside = evaluateInside and event.projectB and f_smt_inside_loses(i)
            event.projectA := event.projectB and not (smt_cleanup_inside and losesInside)
            event.bypassed := smt_aesthetic_bypass and insideBypassMode and losesInside
            array.set(smt_events, i, event)

        bool pivotABypassMode = smt_cleanup_mode == "Bypass Pivot A"
        bool pivotBBypassMode = smt_cleanup_mode == "Bypass Pivot B"
        bool evaluatePivotA = smt_cleanup_pivot_a or pivotABypassMode
        bool evaluatePivotB = smt_cleanup_pivot_b or pivotBBypassMode
        for i = 0 to n - 1
            SmtEvent event = array.get(smt_events, i)
            bool losesPivotA = evaluatePivotA and event.projectA and f_smt_pivot_loses(i, true)
            bool losesPivotB = evaluatePivotB and event.projectA and f_smt_pivot_loses(i, false)
            bool removed = (smt_cleanup_pivot_a and losesPivotA) or (smt_cleanup_pivot_b and losesPivotB)
            event.projectB := event.projectA and not removed
            bool pivotBypassed = (pivotABypassMode and losesPivotA) or (pivotBBypassMode and losesPivotB)
            event.bypassed := event.bypassed or (smt_aesthetic_bypass and pivotBypassed)
            array.set(smt_events, i, event)
    0

f_smt_sync_render_at(int idx, bool shouldRender) =>
    if idx >= 0 and idx < array.size(smt_events)
        SmtEvent event = array.get(smt_events, idx)
        if shouldRender
            color eventColor = event.bypassed ? color.new(f_smt_rank_color(event.rank), 65) : f_smt_rank_color(event.rank)
            if na(event.lineId)
                event.lineId := line.new(x1=event.pivotATime, y1=event.pivotAPrice, x2=event.pivotBTime, y2=event.pivotBPrice, xloc=xloc.bar_time, color=eventColor, width=1, style=smt_line_style)
            else
                line.set_xy1(event.lineId, event.pivotATime, event.pivotAPrice)
                line.set_xy2(event.lineId, event.pivotBTime, event.pivotBPrice)
                line.set_color(event.lineId, eventColor)
                line.set_style(event.lineId, smt_line_style)
            bool labelsOn = f_smt_labels_for_rank(event.rank)
            if labelsOn
                int labelTime = f_smt_event_label_time(event.pivotATime, event.pivotBTime, event.pivotABar, event.pivotBBar)
                string defaultText = f_smt_default_label_text(event.rank, event.pairSlot)
                string displayText = event.bypassed ? (smt_bypass_labels_show ? f_smt_bypass_label_text(event.rank, event.pairSlot) : "") : defaultText
                color textColor = event.bypassed ? (smt_bypass_labels_show ? color.new(smt_txt_all, 50) : color.new(smt_txt_all, 100)) : smt_txt_all
                if na(event.labelId)
                    if label.all.size() < 490
                        event.labelId := label.new(x=labelTime, y=f_smt_event_label_y(event.dir, event.pivotAPrice, event.pivotBPrice), text=displayText, xloc=xloc.bar_time, yloc=yloc.price, color=color.new(color.white, 100), style=event.dir == SMT_DIR_BULL ? label.style_label_up : label.style_label_down, textcolor=textColor, size=smt_label_size, textalign=text.align_center, tooltip=defaultText)
                else
                    label.set_x(event.labelId, labelTime)
                    label.set_y(event.labelId, f_smt_event_label_y(event.dir, event.pivotAPrice, event.pivotBPrice))
                    label.set_text(event.labelId, displayText)
                    label.set_textcolor(event.labelId, textColor)
                    label.set_size(event.labelId, smt_label_size)
                    label.set_textalign(event.labelId, text.align_center)
            else if not na(event.labelId)
                label.delete(event.labelId)
                event.labelId := na
        else
            if not na(event.labelId)
                label.delete(event.labelId)
                event.labelId := na
            if not na(event.lineId)
                line.delete(event.lineId)
                event.lineId := na
        array.set(smt_events, idx, event)
    0

// Release only low-priority SMT drawings when the composite host needs capacity.
// Domain events are retained and can be projected again on the same update.
f_smt_reserve_host_lines(int neededLines) =>
    if line.all.size() + neededLines > 490 and smt_events.size() > 0
        for rankCursor = 1 to SMT_STATE_CYCLES
            for i = smt_events.size() - 1 to 0
                event = smt_events.get(i)
                if event.rank == rankCursor and not na(event.lineId) and line.all.size() + neededLines > 490
                    f_smt_drop_render_at(i)
    0

f_smt_project_events() =>
    if barstate.islast
        f_smt_prepare_projection()
        array<int> bucketCounts = array.new_int(SMT_LIVE_SLOTS, 0)
        int ownedLines = 0
        for event in smt_events
            ownedLines += not na(event.lineId) ? 1 : 0
        int renderBudget = math.min(SMT_RENDER_EVENT_CAP, math.max(0, 490 - line.all.size() + ownedLines))
        int rendered = 0
        int n = array.size(smt_events)
        if n > 0
            // Global object pressure is resolved by rank first, then recency.
            for rankCursor = SMT_STATE_CYCLES to 1
                for i = 0 to n - 1
                    SmtEvent event = array.get(smt_events, i)
                    if event.rank == rankCursor
                        bool shouldRender = event.projectB
                        if shouldRender and event.state == SMT_EVENT_CONFIRMED
                            int bucket = f_smt_live_slot(event.rank, event.pairSlot, event.dir)
                            int bucketCount = array.get(bucketCounts, bucket)
                            shouldRender := bucketCount < smt_history_limit
                            if shouldRender
                                array.set(bucketCounts, bucket, bucketCount + 1)
                        shouldRender := shouldRender and rendered < renderBudget
                        if shouldRender
                            rendered += 1
                        event.projectA := shouldRender
                        array.set(smt_events, i, event)
            // Delete losers first so replacements cannot trigger platform garbage collection.
            for i = 0 to n - 1
                if not array.get(smt_events, i).projectA
                    f_smt_sync_render_at(i, false)
            for i = 0 to n - 1
                if array.get(smt_events, i).projectA
                    f_smt_sync_render_at(i, true)
    0
//==============================================================================
// Family runtime
//==============================================================================
// Last inputs seen per family × pair: [main version, pair version, canResolve]. When all three
// are unchanged, the previous result still stands, so the sweep / SMT update is skipped (opt. 1).
var array<int> smt_last_main_ver = array.new_int(SMT_STATE_CYCLES * SMT_PAIR_COUNT, -1)
var array<int> smt_last_pair_ver = array.new_int(SMT_STATE_CYCLES * SMT_PAIR_COUNT, -1)
var array<int> smt_last_resolve  = array.new_int(SMT_STATE_CYCLES * SMT_PAIR_COUNT, -1)

f_smt_run_pair(SmtRangeState mainState, SmtRangeState pairState, bool engineEnabled, SmtCorrelationDescriptor pair, int rank, int pairSlot) =>
    if not na(mainState.cycleKey)
        int bearSlot = f_smt_live_slot(rank, pairSlot, SMT_DIR_BEAR)
        int bullSlot = f_smt_live_slot(rank, pairSlot, SMT_DIR_BULL)
        // Finalization belongs to the main range transition and never to a line.
        f_smt_finalize_live_slot(bearSlot, mainState.cycleKey)
        f_smt_finalize_live_slot(bullSlot, mainState.cycleKey)
        bool cycleAligned = mainState.cycleKey == pairState.cycleKey and not na(mainState.previousCycleKey) and mainState.previousCycleKey == pairState.previousCycleKey
        bool rangesReady = mainState.hasCurrentRange and mainState.hasPreviousRange and pairState.hasCurrentRange and pairState.hasPreviousRange
        bool canResolve = engineEnabled and pair.configured and pair.dataReady and cycleAligned and rangesReady
        int memo = (rank - 1) * SMT_PAIR_COUNT + (pairSlot - 1)
        int resolveCode = canResolve ? 1 : 0
        bool unchanged = array.get(smt_last_main_ver, memo) == mainState.version and array.get(smt_last_pair_ver, memo) == pairState.version and array.get(smt_last_resolve, memo) == resolveCode
        array.set(smt_last_main_ver, memo, mainState.version)
        array.set(smt_last_pair_ver, memo, pairState.version)
        array.set(smt_last_resolve, memo, resolveCode)
        if unchanged
            0
        else if canResolve
            SmtSweepState mainSweep = f_smt_build_sweeps(mainState, false)
            SmtSweepState pairSweep = f_smt_build_sweeps(pairState, pair.inverse)
            [bearValid, bullValid] = f_smt_resolve_pair_state(mainSweep, pairSweep)
            f_smt_sync_live_candidate(bearValid, mainState.cycleKey, mainState.previousCycleKey, rank, pairSlot, SMT_DIR_BEAR, mainSweep.highPivotA, mainSweep.highPivotB, mainSweep.highTimeA, mainSweep.highTimeB, mainSweep.highBarA, mainSweep.highBarB)
            f_smt_sync_live_candidate(bullValid, mainState.cycleKey, mainState.previousCycleKey, rank, pairSlot, SMT_DIR_BULL, mainSweep.lowPivotA, mainSweep.lowPivotB, mainSweep.lowTimeA, mainSweep.lowTimeB, mainSweep.lowBarA, mainSweep.lowBarB)
        else
            f_smt_sync_live_candidate(false, mainState.cycleKey, mainState.previousCycleKey, rank, pairSlot, SMT_DIR_BEAR, na, na, na, na, na, na)
            f_smt_sync_live_candidate(false, mainState.cycleKey, mainState.previousCycleKey, rank, pairSlot, SMT_DIR_BULL, na, na, na, na, na, na)
    0

f_run_smt_cycle(int cycleIdx, bool engineEnabled, int rangeKey, int rank) =>
    // Only families that are switched on AND allowed on this chart timeframe are calculated (opt. 3).
    // A pair that is not set up (e.g. pair 2 in Dyad) is not run at all (opt. 2).
    if engineEnabled
        f_smt_update_state(cycleIdx, SMT_SRC_MAIN, true, rangeKey, high, low, time)
        SmtRangeState mainState = f_smt_get_state(cycleIdx, SMT_SRC_MAIN)
        if smt_corr_pair1.configured
            f_smt_update_state(cycleIdx, SMT_SRC_PAIR1, true, rangeKey, smt_corr_pair1.sourceHigh, smt_corr_pair1.sourceLow, smt_corr_pair1.sourceTime)
            f_smt_run_pair(mainState, f_smt_get_state(cycleIdx, SMT_SRC_PAIR1), true, smt_corr_pair1, rank, 1)
        if smt_corr_pair2.configured
            f_smt_update_state(cycleIdx, SMT_SRC_PAIR2, true, rangeKey, smt_corr_pair2.sourceHigh, smt_corr_pair2.sourceLow, smt_corr_pair2.sourceTime)
            f_smt_run_pair(mainState, f_smt_get_state(cycleIdx, SMT_SRC_PAIR2), true, smt_corr_pair2, rank, 2)
    0

// ── GXV SMT execution (every bar; only enabled families allowed on this chart TF run) ──
f_smt_seed_engine()
f_run_smt_cycle(12, tf_ok_12m and f_smt_rank_enabled(13), val_sesY, 13)
f_run_smt_cycle(11, tf_ok_3m and f_smt_rank_enabled(12), val_sesQ, 12)
f_run_smt_cycle(10, tf_ok_1m and f_smt_rank_enabled(11), val_sesMT, 11)
f_run_smt_cycle(9, tf_ok_1w and f_smt_rank_enabled(10), val_sesM, 10)
f_run_smt_cycle(8, tf_ok_1d and f_smt_rank_enabled(9), val_sesW, 9)
f_run_smt_cycle(7, tf_ok_12h and f_smt_rank_enabled(8), val_ses720, 8)
f_run_smt_cycle(6, tf_ok_7h and f_smt_rank_enabled(7), val_ses420, 7)
f_run_smt_cycle(5, tf_ok_6h and f_smt_rank_enabled(6), val_sesD, 6)
f_run_smt_cycle(4, tf_ok_4h and f_smt_rank_enabled(5), val_ses240, 5)
f_run_smt_cycle(3, tf_ok_90m and f_smt_rank_enabled(4), val_ses90, 4)
f_run_smt_cycle(2, tf_ok_1h and f_smt_rank_enabled(3), val_ses60, 3)
f_run_smt_cycle(1, tf_ok_30m and f_smt_rank_enabled(2), val_ses30, 2)
f_run_smt_cycle(0, tf_ok_15m and f_smt_rank_enabled(1), val_ses15, 1)

// Check newly confirmed events on the rollover bar itself.
f_smt_mark_historical_invalidations()
f_smt_gc_events()

// ============================================================================
// HTF panels — data collection (chart bars, inside each panel's runtime window)
// ============================================================================

bool pnl_a1_new = ta.change(time(pnl_a1_tf)) != 0
bool pnl_a2_new = ta.change(time(pnl_a2_tf)) != 0
bool pnl_a3_new = ta.change(time(pnl_a3_tf)) != 0

if not settings.hide_candles
    if pnl_a1_ok and htfRuntimeOn(pnl_a1_tf, pnl1_count)
        CollectExtraCandle(pnl_a1, pnl_a1_new, pnl1_count, pnl_a1_tf)
    if pnl_a2_ok and htfRuntimeOn(pnl_a2_tf, pnl2_count)
        CollectExtraCandle(pnl_a2, pnl_a2_new, pnl2_count, pnl_a2_tf)
    if pnl_a3_ok and htfRuntimeOn(pnl_a3_tf, pnl3_count)
        CollectExtraCandle(pnl_a3, pnl_a3_new, pnl3_count, pnl_a3_tf)

// Pair candles aligned to each panel's candles (HTF SMT / PSP). Inverse pairs are normalised
// once into main-domain OHLC, as in the Profiler.
bool  pnl_pair_on = (htf_smt_show or htf_psp_show) and not settings.hide_candles
float pr1o = corr_inv1 ? -xo0 : xo0
float pr1h = corr_inv1 ? -xl0 : xh0
float pr1l = corr_inv1 ? -xh0 : xl0
float pr1c = corr_inv1 ? -xc0 : xc0
float pr2o = corr_inv2 ? -yo0 : yo0
float pr2h = corr_inv2 ? -yl0 : yh0
float pr2l = corr_inv2 ? -yh0 : yl0
float pr2c = corr_inv2 ? -yc0 : yc0
int   pp0_ot = htf.candles.size() > 0 ? htf.candles.first().o_time : na
int   pp1_ot = pnl_a1.size() > 0 ? pnl_a1.first().o_time : na
int   pp2_ot = pnl_a2.size() > 0 ? pnl_a2.first().o_time : na
int   pp3_ot = pnl_a3.size() > 0 ? pnl_a3.first().o_time : na
bool  pp0_on = (pnl_pair_on and pnl_a_match > 0 or htf_psp_show) and valid_htf and model_runtime and not na(pp0_ot)
SyncPairCandle(pp0_1, pp0_on and corr_pair1_configured, pr1o, pr1h, pr1l, pr1c, pp0_ot, htf.settings.max_display + 2)
SyncPairCandle(pp0_2, pp0_on and corr_pair2_configured, pr2o, pr2h, pr2l, pr2c, pp0_ot, htf.settings.max_display + 2)
SyncPairCandle(pp1_1, pnl_pair_on and corr_pair1_configured and not na(pp1_ot), pr1o, pr1h, pr1l, pr1c, pp1_ot, pnl1_count + 2)
SyncPairCandle(pp1_2, pnl_pair_on and corr_pair2_configured and not na(pp1_ot), pr2o, pr2h, pr2l, pr2c, pp1_ot, pnl1_count + 2)
SyncPairCandle(pp2_1, pnl_pair_on and corr_pair1_configured and not na(pp2_ot), pr1o, pr1h, pr1l, pr1c, pp2_ot, pnl2_count + 2)
SyncPairCandle(pp2_2, pnl_pair_on and corr_pair2_configured and not na(pp2_ot), pr2o, pr2h, pr2l, pr2c, pp2_ot, pnl2_count + 2)
SyncPairCandle(pp3_1, pnl_pair_on and corr_pair1_configured and not na(pp3_ot), pr1o, pr1h, pr1l, pr1c, pp3_ot, pnl3_count + 2)
SyncPairCandle(pp3_2, pnl_pair_on and corr_pair2_configured and not na(pp3_ot), pr2o, pr2h, pr2l, pr2c, pp3_ot, pnl3_count + 2)

// Drawing (only on the last bar). Panels left → right from the chart: HTF1, HTF2, HTF3.
// The panel whose timeframe equals the Fractal HTF shows the model's own candles.
if barstate.islast or barstate.isrealtime
    int host_line_reserve = bin.lines.size() + 64
    bin.clear()
    // Release low-priority chart SMT lines if the panels / model need the room (Profiler)
    f_smt_reserve_host_lines(host_line_reserve)
    int model_pane = pnl_a_match
    settings.model_on_panel := valid_htf and not settings.hide_candles and model_pane > 0
    if valid_htf and htf.candles.size() > 0
        PanelFeatures(htf.candles, pp0_1, pp0_2, corr_pair1_ok, corr_pair2_ok)
    if not settings.hide_candles
        int x = bar_index + offset
        for p = 1 to 3
            bool   pok  = p == 1 ? pnl_a1_ok : p == 2 ? pnl_a2_ok : pnl_a3_ok
            string ptf  = p == 1 ? pnl_a1_tf : p == 2 ? pnl_a2_tf : pnl_a3_tf
            array<Candle> parr = p == 1 ? pnl_a1 : p == 2 ? pnl_a2 : pnl_a3
            if pok
                if settings.model_on_panel and p == model_pane and htf.candles.size() > 0
                    x := htf.DrawModelPanel(x) + pnl_gap_input
                else if parr.size() > 0
                    PanelFeatures(parr, p == 1 ? pp1_1 : p == 2 ? pp2_1 : pp3_1, p == 1 ? pp1_2 : p == 2 ? pp2_2 : pp3_2, corr_pair1_ok, corr_pair2_ok)
                    x := DrawExtraCluster(parr, x, ptf) + pnl_gap_input
                    DrawPanelCLabelsPreview(parr, pnl_other_clbl_input, NO_HIST, 0, false, -1)
    if valid_htf
        htf.DrawVTHLLines()
        if not settings.hide_setups
            htf.DrawSetups()
            DrawICCisd()

// ============================================================================
// Sequence table — engine
// ----------------------------------------------------------------------------
// Each lane is updated on the chart from its entry-TF candles (the chart's bars when the chart is not above
// the entry TF, otherwise the entry-TF candles inside each chart bar; no such data → sweep only); its sweep-TF and execution candles are built on absolute
// clock windows (every 5m: 04:00–04:05, 04:05–04:10 …; every 15m / 30m / 1H likewise):
//   Bias   : a sequence candle is a confirmed C2 when, at its close, it took the previous candle's
//            low and closed back above it (bullish; bearish = mirror), as the HTF panel labels it.
//            Took both sides → direction of its colour (green bull, red bear). It only counts with
//            its LTF CISD (valid); bias changes only on a valid C2 close.
//   Sweep  : a fed bar trades through the low (bullish) / high (bearish) of the
//            sweep-TF candle immediately before the current one (its "C1"). C1 shifts every new
//            sweep-TF candle (C3 opens 6:00 → C1 = 5–6 1H; no sweep by 7:00 → C1 = 6–7 1H …).
//            Older sweep-TF candles never count. Once C1 is swept the CISD is tracked across
//            sweep-TF windows until the sequence candle ends: every later C1 sweep (before or after
//            a CISD) moves the swing to watch → WATCHING for a new CISD; so does taking the CISD's
//            own low / high.
//   Entry  : after the sweep, CISD on closed execution candles — same level as FindCISDLevel: from the
//            sweep extreme walk back to the run of opposite candles (dojis skipped) and take the
//            open of its first candle; a close strictly beyond it confirms. A new extreme re-anchors
//            the level the same way (as the model's live setup does) and voids an earlier CISD.
//   Candle : C3 / C4 / C5 counted from the latest confirmed C2; after C5 the row shows WAITING C2
//            until a new C2 closes. Bias always = the latest confirmed C2 (a new C2 close replaces
//            it); sweep / entry run in every sequence candle and reset when the next one opens.
//            'Conditions: C3 Only' gates the steps to C3 (other candles: NOT YET / WAITING C2).
//            In C3, taking the C2 extreme opposite the bias (bull: C2 low) = WAITING C2. After the
//            last candle before a break closes, its state stays until the next candle opens.
//   Score  : C2 QUALITY grades only the valid C2 behind the C3 on the chart (off otherwise);
//            EXECUTION = the most advanced lane (+ C2 grade in C3).
// Everything resets when the next sequence candle opens.
// ============================================================================
bool   seq_is_1h      = timeframe.in_seconds() == 60
string seq_dir_tf     = model_tf
string seq_a_sweep_tf = seq_is_1h ? '15' : '60'
string seq_a_exec_tf  = seq_is_1h ? '3' : '5'
string seq_b_sweep_tf = seq_is_1h ? '15' : '30'
string seq_b_exec_tf  = seq_is_1h ? '1' : '3'

// ── POI zones of one timeframe, built on that timeframe's own closed candles (request.security), so
// every chart reads the same zones the POI timeframe's own chart shows. FVG = gap between candle 1 and
// candle 3 (BISI / SIBI); a candle whose wick fully fills a zone removes it (BISI: low below its bottom,
// SIBI: high above its top; no iFVGs). Up to 15 zones
// are kept (the one farthest from price goes first).
type SeqZ
    array<float> top
    array<float> bot
    array<int>   dir     // 1 = BISI, -1 = SIBI
    array<int>   t       // time the FVG was confirmed

method drop(SeqZ z, int i) =>
    z.top.remove(i)
    z.bot.remove(i)
    z.dir.remove(i)
    z.t.remove(i)
    z

// Runs inside request.security on the POI timeframe; bar [1] = the candle that just closed
SeqZones() =>
    var SeqZ z = SeqZ.new(array.new<float>(), array.new<float>(), array.new<int>(), array.new<int>())
    float c1 = close[1]
    float h1 = high[1]
    float l1 = low[1]
    float h3 = high[3]
    float l3 = low[3]
    int n = z.top.size()
    if n > 0 and not na(l1)
        for i = n - 1 to 0
            if z.dir.get(i) == 1 ? l1 < z.bot.get(i) : h1 > z.top.get(i)
                z.drop(i)
    bool bu = l1 > h3
    bool be = h1 < l3
    if bu or be
        z.top.push(bu ? l1 : l3)
        z.bot.push(bu ? h3 : h1)
        z.dir.push(bu ? 1 : -1)
        z.t.push(time)
        if z.top.size() > 15
            int   fi = 0
            float fd = -1.0
            for [i, tp] in z.top
                float dd = math.max(c1 - tp, z.bot.get(i) - c1, 0.0)
                if dd > fd
                    fd := dd
                    fi := i
            z.drop(fi)
    [z.top, z.bot, z.dir, z.t]

// Nearest zone of side dir that was already active at t1 and overlaps the C1–C2 range bot–top:
// [distance to the sweep price p (0 = p inside it), index]; distance na = none
method near(SeqZ z, int dir, float top, float bot, int t1, float p) =>
    float best = na
    int   bi   = -1
    if not na(z.top) and not na(z.bot) and not na(z.dir) and not na(z.t)
        for [i, zt] in z.top
            float zb = z.bot.get(i)
            if z.dir.get(i) == dir and z.t.get(i) <= t1 and zb <= top and zt >= bot
                float d = math.max(p - zt, zb - p, 0.0)
                if na(best) or d < best
                    best := d
                    bi   := i
    [best, bi]

// Score of a C2: flags 0 LTF CISD inside C2 (must-have), 1 C2 within 75% of C1's range,
// 2 POI, 3 SMT on C2, 4 POI + SMT; plus the POI zone used
type SeqSc
    array<bool> f
    int   pTf  = -1      // POI timeframe index (-1 = no zone)
    int   pDir = 0
    float pTop = na
    float pBot = na

SeqScNew() =>
    SeqSc.new(array.new<bool>(5, false))

// Direction of a C2 for a sequence candle (o/h/l/c) against the candle before it (pcH/pcL), same
// rule as the HTF panel C-labels: took the previous low and closed back above it (bullish) / took
// the previous high and closed back below it (bearish). Both → direction of its colour (green
// bullish, otherwise bearish, as the panel). 0 = not a C2.
SeqC2Dir(float pcH, float pcL, float o, float h, float l, float c) =>
    bool bu = l < pcL and c > pcL
    bool be = h > pcH and c < pcH
    bu and be ? (c > o ? 1 : -1) : bu ? 1 : be ? -1 : 0

// One direction of a lane: C1 sweep → CISD (same level as FindCISDLevel)
type SeqTrack
    bool  s   = false    // C1 taken
    bool  e   = false    // CISD done
    float ext = na       // sweep extreme
    float lvl = na       // CISD level
    float c1  = na       // C1 level that was taken
    int   c1T = na       // C1 candle open time
    int   sT  = na       // sweep time
    int   eT  = na       // CISD time (close of the confirming execution candle)
    int   xT  = na       // open time of the execution candle that made the sweep extreme
    bool  lk  = false    // C2 tracker: the CISD window into the next candle has ended

// One lane's state, updated on the chart from fed bars (no request.security state).
// Windows are absolute clock windows from the bar time: every 5m (04:00–04:05, 04:05–04:10 … 04:55–05:00),
// every 3m (04:00–04:03, 04:03–04:06 …), every 15m / 30m / 1H likewise; the sequence candle (1H / 4H)
// comes from the chart.
type SeqLaneSt
    int      sMs    = na   // sweep-TF length (ms)
    int      eMs    = na   // execution-TF length (ms)
    int      lastT  = na   // last bar processed
    int      dId    = na   // sequence candle (open time)
    int      sId    = na   // current sweep-TF window
    float    sH     = na
    float    sL     = na
    float    pH     = na   // C1 = the sweep-TF candle just before the current one
    float    pL     = na
    int      pStart = na
    int      gMs    = 0    // C2 tracker: CISD window into the next candle (ms, 0 = off)
    int      sStart = na   // open time of the current sweep-TF window
    bool     sSeq   = false // sweep window = the sequence candle (C2 tracker)
    int      eId    = na   // current execution window
    float    eO     = na
    float    eH     = na
    float    eL     = na
    float    eC     = na
    bool     eProc  = false
    bool     fx     = false // execution windows given by the feed (Classic)
    SeqTrack bu     = na   // bullish: C1 low taken → CISD up
    SeqTrack be     = na   // bearish: C1 high taken → CISD down
    SeqTrack pbu    = na   // tracks of the previous sequence candle (read at its close)
    SeqTrack pbe    = na
    int      pdId   = na
    float    upRO   = na   // opposite-candle runs on execution candles
    float    dnRO   = na
    float    lUpRO  = na
    float    lDnRO  = na
    int      bD     = na    // sequence candle of the data check below
    bool     bad    = false // a bar of this sequence candle had no entry data → entry not shown (no guessing)

// A completed execution candle: after the sweep the extreme candle anchors the level (open of the
// opposite run leading into it); a later candle closing strictly beyond it is the CISD; a new
// extreme re-anchors and voids an earlier CISD.
method step(SeqTrack tr, bool bull, float h, float l, float c, float lvlNow, int begT, int endT) =>
    if tr.s and not tr.lk
        if na(tr.ext) or (bull ? l < tr.ext : h > tr.ext)
            // the CISD's low / high taken → setup failed: back to WATCHING from the new extreme;
            // the sweep row shows the swing that was taken
            if tr.e and not na(tr.xT)
                tr.c1T := tr.xT
            tr.ext := bull ? l : h
            tr.xT  := begT
            tr.lvl := lvlNow
            tr.e   := false
            tr.eT  := na
        else if not tr.e and not na(tr.lvl) and (bull ? c > tr.lvl : c < tr.lvl)
            tr.e  := true
            tr.eT := endT
    tr

// C2 CISD in the next candle: the C2's track keeps its level; a close strictly beyond it confirms.
// A new extreme beyond the C2's (the next candle took the C2 extreme) ends the window.
method grace(SeqTrack tr, bool bull, float h, float l, float c, int endT) =>
    if not na(tr) and tr.s and not tr.e and not tr.lk
        if bull ? l < tr.ext : h > tr.ext
            tr.lk := true
        else if not na(tr.lvl) and (bull ? c > tr.lvl : c < tr.lvl)
            tr.e  := true
            tr.eT := endT
    tr

method proc(SeqLaneSt st) =>
    if not na(st.eO) and not st.eProc
        float o = st.eO
        float c = st.eC
        if c < o
            if na(st.dnRO)
                st.dnRO := o
            if not na(st.upRO)
                st.lUpRO := st.upRO
                st.upRO  := na
        else if c > o
            if na(st.upRO)
                st.upRO := o
            if not na(st.dnRO)
                st.lDnRO := st.dnRO
                st.dnRO  := na
        int endT = st.fx ? st.eId + st.eMs : (st.eId + 1) * st.eMs
        st.bu.step(true, st.eH, st.eL, c, nz(st.dnRO, st.lDnRO), endT - st.eMs, endT)
        st.be.step(false, st.eH, st.eL, c, nz(st.upRO, st.lUpRO), endT - st.eMs, endT)
        // C2 tracker: the previous candle's (C2's) CISD may still come early in the next candle
        if st.gMs > 0 and endT > st.dId and endT <= st.dId + st.gMs
            st.pbu.grace(true, st.eH, st.eL, c, endT)
            st.pbe.grace(false, st.eH, st.eL, c, endT)
        st.eProc := true
    st

// Feed one bar (t = open time). closed = the bar has closed. ew = na: 1m bars, clock windows;
// Classic: ew = open time of the execution candle the bar belongs to, ewEnd = the bar ends it.
// so = sweep only (no execution-TF data): the execution candles are skipped
method upd(SeqLaneSt st, int dT, int t, float o, float h, float l, float c, bool closed, int ew, bool ewEnd, bool so) =>
    if not na(t) and (na(st.lastT) or t >= st.lastT)
        st.lastT := t
        st.fx    := not na(ew)
        int sid = st.sSeq ? dT : math.floor(t / st.sMs)
        int eid = st.fx ? ew : math.floor(t / st.eMs)
        // k = 0: a new execution window started while the previous candle was not processed yet
        // k = 1: this closed bar ends its execution window
        for k = 0 to 1
            if not so and (k == 0 ? not na(st.eId) and eid != st.eId : closed and (st.fx ? ewEnd : math.floor((t + 60000) / st.eMs) != eid))
                st.proc()
            if k == 0
                // every new sequence candle starts clean
                if na(st.dId) or dT != st.dId
                    st.pbu  := st.bu
                    st.pbe  := st.be
                    st.pdId := st.dId
                    st.dId  := dT
                    st.bu  := SeqTrack.new()
                    st.be  := SeqTrack.new()
                if not so
                    if na(st.eId) or eid != st.eId
                        st.eId   := eid
                        st.eO    := o
                        st.eH    := h
                        st.eL    := l
                        st.eProc := false
                    st.eH := math.max(st.eH, h)
                    st.eL := math.min(st.eL, l)
                    st.eC := c
                if na(st.sId) or sid != st.sId
                    st.pH     := st.sH
                    st.pL     := st.sL
                    st.pStart := st.sStart
                    st.sStart := st.sSeq ? dT : sid * st.sMs
                    st.sId    := sid
                    st.sH     := h
                    st.sL     := l
                st.sH := math.max(st.sH, h)
                st.sL := math.min(st.sL, l)
                // sweep of C1 (the sweep-TF candle just before the current one). The CISD is then
                // tracked across sweep-TF windows until the sequence candle ends; every later C1
                // sweep (also after a CISD) moves the swing to watch to that new low / high and
                // the entry back to WATCHING for a new CISD.
                if l < st.pL and (not st.bu.s or st.bu.c1T != st.pStart)
                    st.bu.s   := true
                    st.bu.sT  := t
                    st.bu.c1  := st.pL
                    st.bu.c1T := st.pStart
                    st.bu.ext := na
                    st.bu.e   := false
                    st.bu.eT  := na
                if h > st.pH and (not st.be.s or st.be.c1T != st.pStart)
                    st.be.s   := true
                    st.be.sT  := t
                    st.be.c1  := st.pH
                    st.be.c1T := st.pStart
                    st.be.ext := na
                    st.be.e   := false
                    st.be.eT  := na
    st

// Bars to feed: the chart's own bar (own) or the tf candles inside it (request.security_lower_tf)
SeqBars(bool own, string tf) =>
    array<int>   t = array.from(time)
    array<float> o = array.from(open)
    array<float> h = array.from(high)
    array<float> l = array.from(low)
    array<float> c = array.from(close)
    if not own
        [bt, bo, bh, bl, bc] = request.security_lower_tf(syminfo.tickerid, tf, [time, open, high, low, close])
        t := bt
        o := bo
        h := bh
        l := bl
        c := bc
    [t, o, h, l, c]

// Feed bars to a lane. fx: execution windows from the feed (window = ewT, or each bar itself when
// ewT is na; ewEnd = the chart bar ends it); else 1m clock windows.
method feed(SeqLaneSt st, int dT, array<int> t, array<float> o, array<float> h, array<float> l, array<float> c, bool fx, int ewT, bool ewEnd, bool so) =>
    int n = t.size()
    if n > 0
        for i = 0 to n - 1
            st.upd(dT, t.get(i), o.get(i), h.get(i), l.get(i), c.get(i), i < n - 1 or barstate.isconfirmed, fx ? (na(ewT) ? t.get(i) : ewT) : na, fx and ewEnd, so)
    st

// Boom lane on its entry timeframe etf: the chart's bars when the chart is not above etf, else the etf
// candles inside each chart bar. No etf data → sweep only, from the chart's bars when the chart is not
// above the sweep timeframe. Returns [sweep tracked, entry tracked] (else the table shows '--').
// Exact entry candles only: the chart's bars when the chart divides the entry TF (1m → any, 3m → 3m, 5m → 5m),
// the entry-TF candles inside each chart bar when the entry TF divides the chart (15m chart → 5m / 3m), else 1m
// candles on clock windows (3m chart → 5m, 5m chart → 3m). A bar without that data → entry not shown for this
// sequence candle (sweep from the chart's bars when the chart divides the sweep TF).
SeqLaneFeed(SeqLaneSt ln, int dT, string etf, int ewT, int ewC) =>
    int  cs   = timeframe.in_seconds()
    bool own  = timeframe.in_seconds(etf) % cs == 0
    bool sub  = not own and cs % timeframe.in_seconds(etf) == 0
    [bt, bo, bh, bl, bc] = SeqBars(own, sub ? etf : '1')
    bool full = bt.size() > 0
    if dT != ln.bD
        ln.bD  := dT
        ln.bad := false
    ln.bad := ln.bad or not full
    bool swok = full or ln.sMs % (cs * 1000) == 0
    if full
        ln.feed(dT, bt, bo, bh, bl, bc, own or sub, own ? ewT : na, not own or ewC == time_close, false)
    else if swok
        ln.feed(dT, array.from(time), array.from(open), array.from(high), array.from(low), array.from(close), true, na, false, true)
    [swok, not ln.bad]

// Middle column: sweep row = the C1 candle (open time) that was taken, or the C1 being watched;
// entry row = time the CISD happened (close of the execution candle that confirmed it)
// Times in New York time, the same clock as the HTF panel candle labels.
SeqC1Txt(SeqLaneSt st, int bias, bool swept) =>
    SeqTrack tr = bias == 1 ? st.bu : st.be
    int t = na(tr) ? na : swept ? tr.c1T : st.pStart
    na(t) ? '' : 'C1 - ' + str.format_time(t, 'HH:mm', 'America/New_York')

SeqCisdTxt(SeqLaneSt st, int bias) =>
    SeqTrack tr = bias == 1 ? st.bu : st.be
    int t = na(tr) ? na : tr.eT
    na(t) ? '' : str.format_time(t, 'HH:mm', 'America/New_York')

// Score weights / labels / grades (SMT): CISD 75 · 75% rule 5 · POI 10 · SMT 5 · POI+SMT 5
// → LOW 75–80, HIGH 85–90, BOOM 95–100
var array<int>    SEQ_W   = array.from(75, 5, 10, 5, 5)
var array<string> SEQ_LBL = array.from('CISD in C2', 'C2 inside 75% of C1', 'POI', 'SMT on C2', 'POI + SMT')
int SEQ_HIGH = 85
int SEQ_BOOM = 95
// ── Lanes + C2 tracker + POI zones, fed every chart bar ──
string seq_c2_exec_tf = seq_classic ? getFractalLTF() : seq_is_1h ? '5' : '15'     // C2's paired LTF CISD (Boom: 1H → 5m, 4H → 15m; Classic: Fractal LTF)
// POI timeframes, the model's own first (it wins a tie). Boom: 1H sequence 1H / 15m / 4H / D,
// 4H sequence 4H / 1H / 15m / D. Classic: 15m / 30m / 1H model 15m / 1H / 4H, 4H model 1H / 4H / D,
// D / W / M model its own timeframe.
int    seq_ms         = timeframe.in_seconds(seq_dir_tf)
bool   seq_tf_ok      = timeframe.in_seconds() >= 60 and seq_ms > timeframe.in_seconds()  // model above the chart
bool   seq_hi         = timeframe.in_seconds() > 3600   // chart above 1H: no C3 lanes; C2 QUALITY = CISD (+ SMT)
bool   seq_cl_low     = seq_classic and (seq_ms == 900 or seq_ms == 1800 or seq_ms == 3600)
bool   seq_cl_4h      = seq_classic and seq_ms == 14400
bool   seq_cl_one     = seq_classic and not seq_cl_low and not seq_cl_4h
string seq_poi_tf1    = seq_cl_one ? seq_dir_tf : seq_cl_low ? (seq_ms == 3600 ? '60' : '15') : seq_cl_4h ? '240' : seq_is_1h ? '60' : '240'
string seq_poi_tf2    = seq_cl_one ? seq_dir_tf : seq_cl_low ? (seq_ms == 3600 ? '15' : '60') : seq_cl_4h ? '60' : seq_is_1h ? '15' : '60'
string seq_poi_tf3    = seq_cl_one ? seq_dir_tf : seq_cl_low ? '240' : seq_cl_4h ? 'D' : seq_is_1h ? '240' : '15'
string seq_poi_tf4    = seq_cl_one ? seq_dir_tf : seq_cl_low ? '240' : 'D'
int    seq_poi_n      = seq_cl_one ? 1 : seq_classic ? 3 : 4
string seq_poi_all    = seq_cl_one ? PanelLabel(seq_dir_tf) : seq_cl_low ? '15m/1H/4H' : seq_cl_4h ? '1H/4H/D' : '15m/1H/4H/D'
if seq_hi or not seq_tf_ok
    seq_poi_tf1 := timeframe.period
    seq_poi_tf2 := timeframe.period
    seq_poi_tf3 := timeframe.period
    seq_poi_tf4 := timeframe.period
int    seq_gMs        = seq_grace_input and not seq_classic ? int(seq_ms * 750) : 0   // C2 CISD window: first 75% of C3
bool seq_a_sweep = false
bool seq_a_entry = false
bool seq_b_sweep = false
bool seq_b_entry = false
// lane A, lane B, and the C2 tracker (sweep window = the sequence candle itself, so C1 = the
// previous sequence candle; CISD on the paired LTF inside the same candle)
var array<SeqLaneSt> seq_lanes = array.from(SeqLaneSt.new(sMs = timeframe.in_seconds(seq_a_sweep_tf) * 1000, eMs = timeframe.in_seconds(seq_a_exec_tf) * 1000), SeqLaneSt.new(sMs = timeframe.in_seconds(seq_b_sweep_tf) * 1000, eMs = timeframe.in_seconds(seq_b_exec_tf) * 1000), SeqLaneSt.new(sMs = timeframe.in_seconds(seq_dir_tf) * 1000, eMs = timeframe.in_seconds(seq_c2_exec_tf) * 1000, sSeq = true, gMs = seq_gMs))
SeqLaneSt seq_la  = seq_lanes.get(0)
SeqLaneSt seq_lb  = seq_lanes.get(1)
SeqLaneSt seq_lc2 = seq_lanes.get(2)
int seq_dT = time(seq_dir_tf)
// C2 tracker feed (Boom + Classic): its CISD timeframe — the chart's bars when the chart is not above
// it, else the CISD-TF candles inside each chart bar. Boom lanes A / B: their entry TF (up to a 1H chart).
bool   seq_lanes_on = not seq_classic and not seq_hi
string seq_ftf  = seq_c2_exec_tf
bool   seq_fch  = timeframe.in_seconds() <= timeframe.in_seconds(seq_ftf)
string seq_ewtf = seq_fch ? seq_ftf : timeframe.period
int    seq_ewT  = time(seq_ewtf)
int    seq_ewC  = time_close(seq_ewtf)
// lane entry windows on the chart's bars (chart not above the entry TF)
string seq_awtf = timeframe.in_seconds() <= timeframe.in_seconds(seq_a_exec_tf) ? seq_a_exec_tf : timeframe.period
string seq_bwtf = timeframe.in_seconds() <= timeframe.in_seconds(seq_b_exec_tf) ? seq_b_exec_tf : timeframe.period
int    seq_aW   = time(seq_awtf)
int    seq_aWc  = time_close(seq_awtf)
int    seq_bW   = time(seq_bwtf)
int    seq_bWc  = time_close(seq_bwtf)
var array<bool> seq_lnOk = array.from(true, true, true, true)   // A sweep, A entry, B sweep, B entry tracked
// POI zones from each POI timeframe's own candles (closed candles only → no repaint)
[pz1t, pz1b, pz1d, pz1z] = request.security(syminfo.tickerid, seq_poi_tf1, SeqZones(), lookahead = barmerge.lookahead_on)
[pz2t, pz2b, pz2d, pz2z] = request.security(syminfo.tickerid, seq_poi_tf2, SeqZones(), lookahead = barmerge.lookahead_on)
[pz3t, pz3b, pz3d, pz3z] = request.security(syminfo.tickerid, seq_poi_tf3, SeqZones(), lookahead = barmerge.lookahead_on)
[pz4t, pz4b, pz4d, pz4z] = request.security(syminfo.tickerid, seq_poi_tf4, SeqZones(), lookahead = barmerge.lookahead_on)
array<SeqZ> seq_poi = array.from(SeqZ.new(pz1t, pz1b, pz1d, pz1z), SeqZ.new(pz2t, pz2b, pz2d, pz2z), SeqZ.new(pz3t, pz3b, pz3d, pz3z), SeqZ.new(pz4t, pz4b, pz4d, pz4z))
// a POI timeframe the platform returns no data for → 'platform err' on the POI row
bool seq_poiErr = false
for [k, z] in seq_poi
    seq_poiErr := seq_poiErr or (k < seq_poi_n and na(z.top))
if (seq_show_input or alerts_enabled_input) and seq_tf_ok
    // C2 tracker: the chart's bar, or the C2 CISD-TF candles inside it (no 1m data needed)
    [ft, fo, fh, fl, fc] = SeqBars(seq_fch, seq_ftf)
    seq_lc2.feed(seq_dT, ft, fo, fh, fl, fc, true, seq_fch ? seq_ewT : na, not seq_fch or seq_ewC == time_close, false)
    // Boom lanes A / B, each on its entry timeframe (no 1m data needed on charts at or below it)
    if seq_lanes_on
        [aSw, aEn] = SeqLaneFeed(seq_la, seq_dT, seq_a_exec_tf, seq_aW, seq_aWc)
        [bSw, bEn] = SeqLaneFeed(seq_lb, seq_dT, seq_b_exec_tf, seq_bW, seq_bWc)
        seq_lnOk := array.from(aSw, aEn, bSw, bEn)

// ── Setup probability score of a C2 (dir) with C1 = c1H/c1L opened at c1T, C2 = c2H/c2L at c2T ──
// SMT on C2: any SMT family event of the bias side detected from C2 open on
SeqSmtChk(int dir, int c2T) =>
    int s = seq_smt_mark.get(dir == 1 ? 0 : 1)
    not na(s) and not na(c2T) and s >= c2T
SeqScore(int dir, float c1H, float c1L, int c1T, float c2H, float c2L, int c2T) =>
    bool bull = dir == 1
    SeqTrack tr = seq_lc2.dId == c2T ? (bull ? seq_lc2.bu : seq_lc2.be) : seq_lc2.pdId == c2T ? (bull ? seq_lc2.pbu : seq_lc2.pbe) : na
    bool fC = not na(tr) and tr.s and tr.e
    float rng = c1H - c1L
    bool f75 = rng > 0 and (bull ? c2H - c1L : c1H - c2L) <= 0.75 * rng
    // POI: the bias-side zone nearest the C2 sweep extreme, active before that extreme was made;
    // on a tie the model's own timeframe wins
    float p  = bull ? c2L : c2H
    int   t1 = not na(tr) and not na(tr.xT) ? tr.xT : c2T
    SeqSc sc = SeqScNew()
    float bd = na
    for [k, z] in seq_poi
        if k < seq_poi_n and not seq_hi
            [d, i] = z.near(dir, math.max(c1H, c2H), math.min(c1L, c2L), t1, p)
            if not na(d) and (na(bd) or d < bd)
                bd      := d
                sc.pTf  := k
                sc.pDir := dir
                sc.pTop := z.top.get(i)
                sc.pBot := z.bot.get(i)
    bool fSmt = SeqSmtChk(dir, c2T)
    bool fP = sc.pTf >= 0
    sc.f := array.from(fC, f75, fP, fSmt, fP and fSmt)
    sc

// above a 1H chart only the CISD (+ SMT on C2) rows count
SeqRowOn(int i) =>
    not seq_hi or i == 0 or SEQ_LBL.get(i) == 'SMT on C2'

SeqPts(SeqSc s) =>
    int p = 0
    for [i, w] in SEQ_W
        p += s.f.get(i) and SeqRowOn(i) ? w : 0
    p

// ── Sequence candles on the chart's own bars (same candles as the HTF panels) ──
// A C2 counts only when it closes VALID: C2 structure (SeqC2Dir) + its LTF CISD. Checked on the close
// of the candle's final chart bar, or — if that bar was not seen — on the first bar of the next
// candle. Then bias = its direction and the next candle is C3; an invalid one changes nothing.
// With 'C2 CISD in C3' a C2 closing without the CISD is PENDING: a CISD early in the next candle
// (1H: until :45, 4H: first 3h) confirms it there and that candle becomes C3.
// The candle state on the table belongs to the candle on the chart and only moves on when the next
// candle opens, so during a market break the last candle stays.
var float seq_dH    = na
var float seq_dL    = na
var float seq_dC    = na
var float seq_dOp   = na    // open price of the current sequence candle
var int   seq_dO    = na    // open time of the current sequence candle
var bool  seq_dEval = false
var float seq_pcH   = na
var float seq_pcL   = na
var int   seq_pcT   = na
var int   seq_bias  = 0
var int   seq_cnum  = 0     // 3 = C3, 4 = C4, … counted from the latest valid C2 (0 = none yet)
var int   seq_dbias = 0     // bias / candle number of the candle on the chart
var int   seq_dcnum = 0
var bool  seq_dBrk  = false // C3–C5 took the C2 extreme against the bias → that C2 is invalid (WAITING C2)
var float seq_c2X   = na    // protected extreme of the latest confirmed C2 (bull: its low, bear: its high)
var bool  seq_c2Dead = false // the latest confirmed C2 was invalidated
var array<int> seq_c2H = array.new<int>()   // last 10 confirmed C2s: open time (+ bull / - bear)
var bool  seq_lastC2 = false // the candle on the chart has closed as a valid C2
var SeqSc seq_scF = SeqScNew()
var SeqSc seq_scD = SeqScNew() // score of the C2 behind the candle on the chart
var bool  seq_scHas = false
var int   seq_pDir  = 0     // pending C2 (closed without its CISD): direction, score, open time
var SeqSc seq_pF = SeqScNew()
var int   seq_pT    = na
var int   seq_c2T   = na    // open time of the latest valid C2
// alert messages of this bar (sent once each, at the end of the sequence engine)
array<string> seq_alert = array.new<string>()
SeqBiasOk(int d) =>
    settings.bias == 'Neutral' or (d == 1 and settings.bias == 'Bullish') or (d == -1 and settings.bias == 'Bearish')
SeqAlertHead(int d) =>
    syminfo.ticker + ' ' + (seq_classic ? 'Classic ' : 'Boom ') + PanelLabel(seq_dir_tf) + ' · ' + (d == 1 ? '▲ Bullish' : '▼ Bearish')
SeqAlertT(int t) =>
    na(t) ? '--' : str.format_time(t, seq_ms >= 86400 ? 'MMM dd' : 'HH:mm', 'America/New_York')
bool seq_newD = ta.change(time(seq_dir_tf)) != 0
int  seq_wD = 0                              // live check of the candle on the chart (last bar)
SeqSc seq_wF = SeqScNew()
for k = 0 to 1
    // k = 0: fallback check of the previous candle on the new candle's first bar; k = 1: final bar
    if seq_tf_ok and (k == 0 ? seq_newD and not na(seq_dH) and not seq_dEval : not seq_dEval and barstate.isconfirmed and time_close == time_close(seq_dir_tf))
        int d = SeqC2Dir(seq_pcH, seq_pcL, seq_dOp, seq_dH, seq_dL, seq_dC)
        SeqSc f = d != 0 ? SeqScore(d, seq_pcH, seq_pcL, seq_pcT, seq_dH, seq_dL, seq_dO) : seq_pF
        seq_pDir := 0
        if d != 0 and f.f.get(0)
            seq_bias   := d
            seq_cnum   := 3
            seq_scF    := f
            seq_scHas  := true
            seq_lastC2 := true
            seq_c2T    := seq_dO
            seq_c2X    := d == 1 ? seq_dL : seq_dH
            seq_c2Dead := false
            seq_c2H.unshift(d == 1 ? seq_dO : -seq_dO)
            if alert_c2_input and SeqBiasOk(d)
                seq_alert.push(SeqAlertHead(d) + ' C2 closed + ' + PanelLabel(seq_c2_exec_tf) + ' CISD (C2 ' + SeqAlertT(seq_dO) + ')')
        else
            seq_cnum := seq_cnum > 0 and not seq_dBrk ? seq_cnum + 1 : 0   // an invalidated C2 stops the count
            if d != 0 and seq_gMs > 0
                seq_pDir := d
                seq_pF   := f
                seq_pT   := seq_dO
        seq_pcH  := seq_dH
        seq_pcL  := seq_dL
        seq_pcT  := seq_dO
        if k == 1
            seq_dEval := true
    if k == 0
        if seq_newD or na(seq_dO)
            seq_dH     := high
            seq_dL     := low
            seq_dC     := close
            seq_dOp    := open
            seq_dO     := seq_dT
            seq_dEval  := false
            seq_dbias  := seq_bias
            seq_dcnum  := seq_cnum
            seq_dBrk   := false
            seq_scD    := seq_scF
            seq_lastC2 := false
            if seq_pT != seq_pcT
                seq_pDir := 0
        else
            seq_dH := math.max(seq_dH, high)
            seq_dL := math.min(seq_dL, low)
            seq_dC := close
        // C3–C5 that takes the C2's protected extreme (bull: C2 low) invalidates that C2
        if seq_dcnum >= 3 and seq_dcnum <= 5 and seq_dbias != 0 and (seq_dbias == 1 ? seq_dL < seq_c2X : seq_dH > seq_c2X)
            seq_dBrk   := true
            seq_c2Dead := true
        // C2 QUALITY live: the candle took the previous low (▲) / high (▼); both → its colour
        if seq_tf_ok and barstate.islast and not seq_dEval
            bool tL = seq_dL < seq_pcL
            bool tH = seq_dH > seq_pcH
            seq_wD := tL and tH ? (seq_dC > seq_dOp ? 1 : seq_dC < seq_dOp ? -1 : 0) : tL ? 1 : tH ? -1 : 0
            if seq_wD != 0
                seq_wF := SeqScore(seq_wD, seq_pcH, seq_pcL, seq_pcT, seq_dH, seq_dL, seq_dO)

if seq_tf_ok and not seq_dEval
    // pending C2: its CISD inside the window confirms it → this candle becomes C3; the window ends
    // when it runs out or this candle takes the C2 extreme first
    if seq_pDir != 0 and seq_lc2.dId == seq_dO and seq_lc2.pdId == seq_pT
        SeqTrack g = seq_pDir == 1 ? seq_lc2.pbu : seq_lc2.pbe
        if not na(g) and g.e
            seq_pF.f.set(0, true)
            seq_bias  := seq_pDir
            seq_cnum  := 3
            seq_dbias := seq_pDir
            seq_dcnum := 3
            seq_scF   := seq_pF
            seq_scD   := seq_pF
            seq_scHas := true
            seq_c2T   := seq_pT
            seq_c2X   := seq_pDir == 1 ? seq_pcL : seq_pcH
            seq_c2Dead := false
            seq_c2H.unshift(seq_pDir == 1 ? seq_pT : -seq_pT)
            if alert_c2_input and SeqBiasOk(seq_pDir)
                seq_alert.push(SeqAlertHead(seq_pDir) + ' C2 + ' + PanelLabel(seq_c2_exec_tf) + ' CISD in C3 (C2 ' + SeqAlertT(seq_pT) + ')')
            seq_pDir  := 0
        else if na(g) or g.lk or time_close > seq_dO + seq_gMs
            seq_pDir := 0

while seq_c2H.size() > 10
    seq_c2H.pop()

// Model panel C-labels (after the sequence engine): a C2 the table confirmed (still standing) gets the ● dot.
// Confirmed: that C2 while its extreme holds, else (invalidated) the live sweep; Live: the live sweep.
if (barstate.islast or barstate.isrealtime) and valid_htf and c_lbl_panel and settings.model_on_panel and not settings.hide_setups
    int ci = -1
    if not na(seq_c2T) and seq_bias != 0 and not seq_c2Dead and SeqBiasOk(seq_bias)
        for [i, c] in htf.candles
            if c.o_time >= seq_c2T and c.o_time < seq_c2T + seq_ms * 1000
                ci := i
                break
    bool live = not pnl_clbl_conf or seq_c2Dead
    if live or ci >= 0
        DrawPanelCLabelsPreview(htf.candles, true, seq_c2H, seq_ms * 1000, seq_bias == 1, live ? -1 : ci)

if (seq_show_input or alerts_enabled_input) and seq_tf_ok
    // a lane only counts for the sequence candle on the chart, in the bias it opened with; after its
    // close (market break) the steps stay until the next candle opens and starts fresh
    bool seq_live = seq_dbias != 0
    SeqTrack seq_ta = seq_dbias == 1 ? seq_la.bu : seq_la.be
    SeqTrack seq_tb = seq_dbias == 1 ? seq_lb.bu : seq_lb.be
    bool seq_a_cur = seq_live and seq_la.dId == seq_dT and not na(seq_ta)
    bool seq_b_cur = seq_live and seq_lb.dId == seq_dT and not na(seq_tb)
    seq_a_sweep := seq_a_cur and seq_ta.s and seq_lnOk.get(0)
    seq_a_entry := seq_a_cur and seq_ta.e and seq_lnOk.get(1)
    seq_b_sweep := seq_b_cur and seq_tb.s and seq_lnOk.get(2)
    seq_b_entry := seq_b_cur and seq_tb.e and seq_lnOk.get(3)
    // alerts (Boom): each new C1 sweep / entry CISD of a lane while the table counts it
    // ('Conditions: C3 Only' on → only in C3)
    var array<int> seq_alId = array.from(0, 0, 0, 0)    // last alerted sweep / CISD time: A sweep, A CISD, B sweep, B CISD
    bool   seq_ok  = not seq_classic and not seq_hi and seq_dbias != 0 and not seq_dBrk and (not seq_c3_only_input or seq_dcnum == 3) and SeqBiasOk(seq_dbias)
    string seq_cn  = seq_dcnum == 3 and not seq_dBrk ? 'C3' : 'C' + str.tostring(seq_dcnum)
    for k = 0 to 3
        bool     isA = k < 2
        bool     isS = k % 2 == 0
        SeqTrack tr  = isA ? seq_ta : seq_tb
        bool     on  = isA ? (isS ? seq_a_sweep : seq_a_entry) : (isS ? seq_b_sweep : seq_b_entry)
        int      id  = na
        if on
            id := isS ? tr.sT : tr.eT
        if not na(id) and id != seq_alId.get(k)
            seq_alId.set(k, id)
            if seq_ok and (isS ? alert_c1_input : alert_entry_input)
                string tf = PanelLabel(isA ? (isS ? seq_a_sweep_tf : seq_a_exec_tf) : (isS ? seq_b_sweep_tf : seq_b_exec_tf))
                seq_alert.push(SeqAlertHead(seq_dbias) + ' ' + seq_cn + ' · Lane ' + (isA ? 'A: ' : 'B: ') + tf + (isS ? ' C1 sweep (C1 ' + SeqAlertT(tr.c1T) + ')' : ' entry CISD (' + SeqAlertT(tr.eT) + ')'))

// Send: each message once (varip keeps what was sent during the realtime bar)
varip int    seq_alBar  = -1
varip string seq_alSent = ''
if alerts_enabled_input and barstate.isrealtime and seq_alert.size() > 0
    if seq_alBar != bar_index
        seq_alBar  := bar_index
        seq_alSent := ''
    string msg = ''
    for m in seq_alert
        if not str.contains(seq_alSent, m)
            seq_alSent += m + '|'
            msg += (msg == '' ? '' : '\n') + m
    if msg != ''
        alert(msg, alert.freq_all)


// ============================================================================
// Dashboard — Asset, Alignment, SMT pair
// ============================================================================

if barstate.islast and dash_show_input
    var table dash_tbl = table.new(dash_table_position(dash_vert_input, dash_horz_input), 1, 4,
         bgcolor = color.new(#000000, 100),
         border_color = dash_text_color_input,
         border_width = 1,
         frame_color = dash_text_color_input,
         frame_width = 1)

    string dash_ltf_disp = LTFName()
    string dash_htf1_disp = HTFName(htf.settings.htf)

    string dash_asset_str = 'Asset : ' + syminfo.ticker
    table.cell(dash_tbl, 0, 0, dash_asset_str, text_color = dash_text_color_input, bgcolor = dash_bg_color_input, text_size = size.small, text_halign = text.align_center)

    string dash_pairs_str = corr_pair1_configured or corr_pair2_configured ? 'SMT : ' + (corr_pair1_configured ? smt_pair : '-') + (corr_pair2_configured ? ' / ' + smt_pair2 : '') + (manualCorrelation ? '' : ' (auto)') : ''
    // Classic: the Fractal pairing itself (LTF / HTF), not the chart
    string dash_align_str = 'Alignment : ' + (seq_classic ? HTFName(seq_c2_exec_tf) : dash_ltf_disp) + ' / ' + dash_htf1_disp
    table.cell(dash_tbl, 0, 1, dash_align_str, text_color = dash_text_color_input, bgcolor = dash_bg_color_input, text_size = size.small, text_halign = text.align_center)

    if str.length(dash_pairs_str) > 0
        table.cell(dash_tbl, 0, 2, dash_pairs_str, text_color = dash_text_color_input, bgcolor = dash_bg_color_input, text_size = size.small, text_halign = text.align_center)

    // current date (New York)
    table.cell(dash_tbl, 0, 3, 'Date : ' + str.format_time(timenow, 'EEE, MMM dd yyyy', 'America/New_York'), text_color = dash_text_color_input, bgcolor = dash_bg_color_input, text_size = size.small, text_halign = text.align_center)

// SMT projection runs last so it sees the final drawing budget (Profiler order)
f_smt_project_events()



// ============================================================================
// Sequence table — drawing (last bar)
// ============================================================================
SeqStatus(bool prevDone, bool done, bool ok) =>
    string txt = not ok ? 'platform err' : done ? 'DONE' : prevDone ? 'WATCHING' : 'NOT YET'
    color  col = not ok ? seq_wait_input : done ? seq_done_input : prevDone ? seq_watch_input : seq_wait_input
    string ico = not ok ? '·  ' : done ? '✓ ' : prevDone ? '◔ ' : '·  '
    [txt, col, ico]

SeqCell(table t, int c, int r, string s, color k, color g, string a) =>
    table.cell(t, c, r, s, text_color = k, bgcolor = g, text_size = seq_size_input, text_halign = a)

// C3 SETUP rows: col 0 label; step rows: col 1 value + status over cols 2–3, others: value over cols 1–3
SeqRow(table t, int r, array<int> mr, string t0, color k0, color g0, string t1, color k1, color g1, string a1, string t2, color k2, bool step) =>
    SeqCell(t, 0, r, t0, k0, g0, text.align_left)
    SeqCell(t, 1, r, t1, k1, g1, a1)
    if step
        SeqCell(t, 2, r, t2, k2, g0, text.align_right)
    mr.push(r * 100 + (step ? 23 : 13))
    r + 1

// POI row: the zone nearest the sweep (TF + BISI / SIBI), else 'platform err' (no POI data), else the POI timeframes watched
SeqPoiTxt(SeqSc s) =>
    'POI (' + (s.pTf >= 0 ? PanelLabel(array.from(seq_poi_tf1, seq_poi_tf2, seq_poi_tf3, seq_poi_tf4).get(s.pTf)) + (s.pDir == 1 ? ' BISI' : ' SIBI') : seq_poiErr ? 'platform err' : seq_poi_all + ' FVG') + ')'

// Grade of a score: text + colour
SeqGrade(SeqSc s, int p) =>
    string g = 'LOW'
    color  c = seq_low_input
    if not s.f.get(0)
        g := 'INVALID'
        c := seq_inv_input
    else if p >= SEQ_BOOM
        g := 'BOOM'
        c := seq_boom_input
    else if p >= SEQ_HIGH
        g := 'HIGH'
        c := seq_high_input
    [g, c]

if barstate.islast and seq_show_input and not seq_tf_ok
    var table seq_ntbl = table.new(dash_table_position(seq_vert_input, seq_horz_input), 1, 2, bgcolor = seq_row_bg_input, border_color = seq_lane_bg_input, border_width = 1, frame_color = seq_head_bg_input, frame_width = 1)
    SeqCell(seq_ntbl, 0, 0, '◆ SEQUENCE', seq_head_tx_input, seq_head_bg_input, text.align_left)
    SeqCell(seq_ntbl, 0, 1, '⚠ ' + (timeframe.in_seconds() < 60 ? 'Use a 1m or higher chart' : seq_classic ? 'Pick a Fractal above ' + LTFName() : 'Use a chart below ' + PanelLabel(seq_dir_tf)), seq_text_input, seq_row_bg_input, text.align_left)

if barstate.islast and seq_show_input and seq_tf_ok
    var table seq_tbl = table.new(dash_table_position(seq_vert_input, seq_horz_input), 4, 18, bgcolor = seq_row_bg_input, border_color = seq_lane_bg_input, border_width = 1, frame_color = seq_head_bg_input, frame_width = 1)
    bool   c3      = seq_dcnum == 3 and seq_dbias != 0 and not seq_dBrk
    bool   c2_ok   = seq_dbias != 0 and not seq_dBrk and (not seq_c3_only_input or c3)
    color  bias_bg = seq_bias == 1 ? seq_bull_input : seq_bias == -1 ? seq_bear_input : seq_wait_input
    string bias_tx = seq_bias == 1 ? '▲ BULLISH' : seq_bias == -1 ? '▼ BEARISH' : '● NO C2 YET'
    string arrow   = seq_dbias == 1 ? '▲ ' : seq_dbias == -1 ? '▼ ' : ''
    // LIVE CANDLE: C3 after a valid C2 close; a forming / pending C2 → WAITING C2
    string cand_tx = seq_lastC2 ? 'C2 CLOSED' : c3 ? 'C3' : (seq_dcnum == 4 or seq_dcnum == 5) and not seq_dBrk ? 'C' + str.tostring(seq_dcnum) : 'WAITING C2'
    color  cand_bg = c3 ? seq_cand_c3_input : seq_cand_other_input
    // C2 QUALITY: the valid C2 that just closed / behind the C3 on the chart; otherwise (WAITING C2)
    // the live check of the candle on the chart
    bool   q_c2    = seq_lastC2 or c3
    SeqSc qf = seq_lastC2 ? seq_scF : c3 ? seq_scD : seq_wF
    int    qp      = SeqPts(qf)
    [qg, qc]       = SeqGrade(qf, qp)
    int    qd      = seq_lastC2 ? seq_bias : c3 ? seq_dbias : seq_wD
    string q_tx    = (qd == 1 ? '▲ ' : qd == -1 ? '▼ ' : '') + (q_c2 ? '' : 'WAITING · ') + qg + (qf.f.get(0) ? ' ' + str.tostring(qp) + '%' : '')
    // grade of the C2 behind the C3 on the chart (EXECUTION)
    int    sp      = SeqPts(seq_scD)
    [sg, sc]       = SeqGrade(seq_scD, sp)
    bool   g3      = c3 and seq_scHas
    string gs      = g3 ? ' · ' + sg : ''
    bool   a_sw    = c2_ok and seq_a_sweep
    bool   a_en    = a_sw and seq_a_entry
    bool   b_sw    = c2_ok and seq_b_sweep
    bool   b_en    = b_sw and seq_b_entry
    [a1t, a1c, a1i] = SeqStatus(c2_ok, a_sw, seq_lnOk.get(0))
    [a2t, a2c, a2i] = SeqStatus(a_sw, a_en, seq_lnOk.get(1))
    [b1t, b1c, b1i] = SeqStatus(c2_ok, b_sw, seq_lnOk.get(2))
    [b2t, b2c, b2i] = SeqStatus(b_sw, b_en, seq_lnOk.get(3))
    int    done_n  = (a_sw ? 1 : 0) + (a_en ? 1 : 0) + (b_sw ? 1 : 0) + (b_en ? 1 : 0)
    color  bar_col = done_n >= 4 ? seq_done_input : done_n == 3 ? seq_watch_input : seq_bear_input
    string as_lbl  = PanelLabel(seq_a_sweep_tf)
    string ae_lbl  = PanelLabel(seq_a_exec_tf)
    string bs_lbl  = PanelLabel(seq_b_sweep_tf)
    string be_lbl  = PanelLabel(seq_b_exec_tf)
    string bar_tx  = ''
    for k = 1 to 4
        bar_tx += k <= done_n ? '▰' : '▱'
    string lanes   = a_en and b_en ? 'A+B' : a_en ? 'A' : b_en ? 'B' : a_sw and b_sw ? 'A+B' : a_sw ? 'A' : 'B'
    string ex_tx   = 'WAIT C2'
    color  ex_c    = seq_wait_input
    if seq_pDir != 0
        ex_tx := '◔ C2 CISD PENDING'
        ex_c  := seq_watch_input
    else if seq_dbias != 0
        if not c2_ok
            ex_tx := 'NOT C3'
        else if a_en or b_en
            ex_tx := arrow + 'ENTRY ' + lanes + gs
            ex_c  := g3 ? sc : seq_done_input
        else if a_sw or b_sw
            ex_tx := 'ARMED ' + lanes + gs
            ex_c  := seq_watch_input
        else
            ex_tx := 'WAIT SWEEP' + gs
    color hd = seq_head_bg_input
    color hx = seq_head_tx_input
    color rw = seq_row_bg_input
    color ln = seq_lane_bg_input
    color tx = seq_text_input
    color wt = seq_wait_input
    string L = text.align_left
    string R = text.align_right
    string C = text.align_center
    array<int> mr = array.from(1, 23, 201, 223)    // merges: row * 100 + first col * 10 + last col
    // top
    SeqCell(seq_tbl, 0, 0, '◆ SEQUENCE', hx, hd, L)
    SeqCell(seq_tbl, 2, 0, (seq_classic ? 'Classic · ' : 'Boom · ') + PanelLabel(seq_dir_tf), hx, hd, R)
    SeqCell(seq_tbl, 0, 1, 'BIAS', wt, rw, L)
    SeqCell(seq_tbl, 1, 1, bias_tx, #ffffff, bias_bg, C)
    SeqCell(seq_tbl, 2, 1, 'LIVE CANDLE', wt, rw, L)
    SeqCell(seq_tbl, 3, 1, cand_tx, #ffffff, cand_bg, C)
    // middle: C2 QUALITY + checklist (label | points)
    // candle times beside the section titles (with Conditions: C3 Only): C2 = the candle C2 QUALITY
    // grades (the valid C2 behind the C3, or the candle on the chart while WAITING), C3 = the C3 on the chart
    // (Classic: C2 time always; D / W / M model as date)
    string c2_t = seq_c3_only_input or seq_classic ? '   ' + SeqAlertT(q_c2 ? seq_c2T : seq_dO) : ''
    string c3_t = seq_c3_only_input and c3 ? '   ' + SeqAlertT(seq_dO) : ''
    SeqCell(seq_tbl, 0, 2, 'C2 QUALITY' + c2_t, hx, hd, L)
    SeqCell(seq_tbl, 2, 2, q_tx, #ffffff, qc, C)
    int r = 3
    if seq_chk_input
        for [i, w] in SEQ_W
            bool  on = SeqRowOn(i)
            bool  ok = on and qf.f.get(i)
            color kc = ok ? seq_done_input : wt
            SeqCell(seq_tbl, 0, r, not on ? '·  ' + SEQ_LBL.get(i) : (ok ? '✓ ' : '✗ ') + (i == 0 ? PanelLabel(seq_c2_exec_tf) + ' ' : '') + (i == 2 ? SeqPoiTxt(qf) : SEQ_LBL.get(i)), kc, rw, L)
            SeqCell(seq_tbl, 3, r, on ? '+' + str.tostring(w) : '--', kc, rw, R)
            mr.push(r * 100 + 2)
            r += 1
    // bottom (Boom only): C3 SETUP lanes, EXECUTION, progress
    if not seq_classic
        SeqCell(seq_tbl, 0, r, 'C3 SETUP' + c3_t, hx, hd, L)
        mr.push(r * 100 + 3)
        r += 1
        if seq_hi
            SeqCell(seq_tbl, 0, r, '--', wt, rw, C)
            mr.push(r * 100 + 3)
            r += 1
        else
            r := SeqRow(seq_tbl, r, mr, '▸ LANE A', wt, ln, as_lbl + ' ▸ ' + ae_lbl, wt, ln, R, '', wt, false)
            r := SeqRow(seq_tbl, r, mr, a1i + as_lbl + ' sweep', tx, rw, not seq_lnOk.get(0) ? '--' : c2_ok ? SeqC1Txt(seq_la, seq_dbias, a_sw) : '', a_sw ? seq_done_input : wt, rw, L, a1t, a1c, true)
            r := SeqRow(seq_tbl, r, mr, a2i + ae_lbl + ' entry', tx, rw, not seq_lnOk.get(1) ? '--' : a_en ? SeqCisdTxt(seq_la, seq_dbias) : '', tx, rw, L, a2t, a2c, true)
            r := SeqRow(seq_tbl, r, mr, '▸ LANE B', wt, ln, bs_lbl + ' ▸ ' + be_lbl, wt, ln, R, '', wt, false)
            r := SeqRow(seq_tbl, r, mr, b1i + bs_lbl + ' sweep', tx, rw, not seq_lnOk.get(2) ? '--' : c2_ok ? SeqC1Txt(seq_lb, seq_dbias, b_sw) : '', b_sw ? seq_done_input : wt, rw, L, b1t, b1c, true)
            r := SeqRow(seq_tbl, r, mr, b2i + be_lbl + ' entry', tx, rw, not seq_lnOk.get(3) ? '--' : b_en ? SeqCisdTxt(seq_lb, seq_dbias) : '', tx, rw, L, b2t, b2c, true)
            r := SeqRow(seq_tbl, r, mr, 'EXECUTION', wt, rw, ex_tx, #ffffff, ex_c, C, '', wt, false)
            r := SeqRow(seq_tbl, r, mr, bar_tx, bar_col, rw, str.tostring(done_n) + ' / 4', wt, rw, R, '', wt, false)
    var bool seq_merged = false
    if not seq_merged
        for m in mr
            int mrow = int(m / 100)
            table.merge_cells(seq_tbl, int(m % 100 / 10), mrow, m % 10, mrow)
        seq_merged := true
